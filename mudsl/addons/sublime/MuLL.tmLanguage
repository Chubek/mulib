<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>name</key>
	<string>MuLL</string>
	<key>scopeName</key>
	<string>source.mull</string>
	<key>fileTypes</key>
	<array>
		<string>mull</string>
	</array>
	<key>patterns</key>
	<array>
		<dict>
			<key>name</key>
			<string>comment.line.number-sign.mull</string>
			<key>begin</key>
			<string>#</string>
			<key>end</key>
			<string>$</string>
		</dict>
		<dict>
			<key>name</key>
			<string>comment.line.double-slash.mull</string>
			<key>begin</key>
			<string>//</string>
			<key>end</key>
			<string>$</string>
		</dict>
		<dict>
			<key>name</key>
			<string>string.quoted.double.mull</string>
			<key>begin</key>
			<string>"</string>
			<key>end</key>
			<string>"</string>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>constant.character.escape.mull</string>
					<key>match</key>
					<string>\\[nrt0\\"]</string>
				</dict>
				<dict>
					<key>name</key>
					<string>invalid.illegal.escape.mull</string>
					<key>match</key>
					<string>\\.</string>
				</dict>
				<dict>
					<key>name</key>
					<string>variable.language.last-error.mull</string>
					<key>match</key>
					<string>\$E\?</string>
				</dict>
			</array>
		</dict>
		<dict>
			<key>name</key>
			<string>storage.type.mull</string>
			<key>match</key>
			<string>\b(val|var|ref|mulib|fn)\b</string>
		</dict>
		<dict>
			<key>name</key>
			<string>keyword.control.mull</string>
			<key>match</key>
			<string>\b(if|else|while|return|break)\b</string>
		</dict>
		<dict>
			<key>name</key>
			<string>constant.language.mull</string>
			<key>match</key>
			<string>\b(true|false|nil)\b</string>
		</dict>
		<dict>
			<key>name</key>
			<string>keyword.operator.word.mull</string>
			<key>match</key>
			<string>\b(and|or|not)\b</string>
		</dict>
		<dict>
			<key>name</key>
			<string>variable.language.mull</string>
			<key>match</key>
			<string>\bG\b</string>
		</dict>
		<dict>
			<key>name</key>
			<string>constant.numeric.mull</string>
			<key>match</key>
			<string>\b[0-9]+(?:\.[0-9]*)?(?:[eE][+-]?[0-9]+)?</string>
		</dict>
		<dict>
			<key>name</key>
			<string>entity.name.function.mull</string>
			<key>match</key>
			<string>\b[A-Za-z_][A-Za-z_0-9]*(?=\s*\()</string>
		</dict>
		<dict>
			<key>name</key>
			<string>keyword.operator.mull</string>
			<key>match</key>
			<string>&lt;-|==|!=|&lt;=|&gt;=|[+*/%&lt;&gt;!\-]</string>
		</dict>
		<dict>
			<key>name</key>
			<string>punctuation.separator.mull</string>
			<key>match</key>
			<string>[:;,]</string>
		</dict>
		<dict>
			<key>name</key>
			<string>punctuation.section.mull</string>
			<key>match</key>
			<string>[(){}\[\]]</string>
		</dict>
		<dict>
			<key>name</key>
			<string>variable.other.mull</string>
			<key>match</key>
			<string>\b[A-Za-z_][A-Za-z_0-9]*\b</string>
		</dict>
	</array>
</dict>
</plist>
