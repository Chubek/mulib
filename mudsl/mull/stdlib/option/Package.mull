# Explicit presence; Some(nil) is different from None().
val Some <- fn(x) { return {present: true, value: x}; };
val None <- fn() { return {present: false, value: nil}; };
return {Some: Some, None: None,
  GetOr: fn(o, fallback) { if o:present { return o:value; } return fallback; },
  Map: fn(o, f) { if o:present { return Some(f(o:value)); } return None(); },
  Bind: fn(o, f) { if o:present { return f(o:value); } return None(); }};
