val Natural <- fn(n) { G:Assert(n >= 0 and n % 1 == 0 and n <= 9007199254740991); return n; };
return {Factorial: fn(n) { Natural(n); G:Assert(n <= 18); var out <- 1; var i <- 2;
    while i <= n { out <- out*i; i <- i + 1; } return out; },
  Choose: fn(n,k) { Natural(n); Natural(k); G:Assert(n <= 50 and k <= n);
    if k > n-k { k <- n-k; } var out <- 1; var i <- 1;
    while i <= k { out <- out*(n-k+i)/i; i <- i + 1; } return out; },
  Cartesian: fn(a,b) { var out <- []; var i <- 0; while i < G:Len(a) { var j <- 0;
    while j < G:Len(b) { out <- out + [[a[i],b[j]]]; j <- j + 1; } i <- i + 1; } return out; }};
