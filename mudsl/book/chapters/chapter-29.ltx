\subsection{Traits and reflection modes}

\begin{itemize}
\item{} \texttt{i\allowbreak{}s\allowbreak{}\_\allowbreak{}\allowbreak{}s\allowbreak{}c\allowbreak{}o\allowbreak{}p\allowbreak{}e\allowbreak{}d\allowbreak{}\_\allowbreak{}\allowbreak{}e\allowbreak{}n\allowbreak{}u\allowbreak{}m\allowbreak{}<\allowbreak{}T\allowbreak{}>}, \texttt{i\allowbreak{}s\allowbreak{}\_\allowbreak{}\allowbreak{}s\allowbreak{}c\allowbreak{}o\allowbreak{}p\allowbreak{}e\allowbreak{}d\allowbreak{}\_\allowbreak{}\allowbreak{}e\allowbreak{}n\allowbreak{}u\allowbreak{}m\allowbreak{}\_\allowbreak{}\allowbreak{}v\allowbreak{}<\allowbreak{}T\allowbreak{}>};
\item{} \texttt{i\allowbreak{}s\allowbreak{}\_\allowbreak{}\allowbreak{}u\allowbreak{}n\allowbreak{}s\allowbreak{}c\allowbreak{}o\allowbreak{}p\allowbreak{}e\allowbreak{}d\allowbreak{}\_\allowbreak{}\allowbreak{}e\allowbreak{}n\allowbreak{}u\allowbreak{}m\allowbreak{}<\allowbreak{}T\allowbreak{}>}, \texttt{i\allowbreak{}s\allowbreak{}\_\allowbreak{}\allowbreak{}u\allowbreak{}n\allowbreak{}s\allowbreak{}c\allowbreak{}o\allowbreak{}p\allowbreak{}e\allowbreak{}d\allowbreak{}\_\allowbreak{}\allowbreak{}e\allowbreak{}n\allowbreak{}u\allowbreak{}m\allowbreak{}\_\allowbreak{}\allowbreak{}v\allowbreak{}<\allowbreak{}T\allowbreak{}>};
\item{} \texttt{u\allowbreak{}n\allowbreak{}d\allowbreak{}e\allowbreak{}r\allowbreak{}l\allowbreak{}y\allowbreak{}i\allowbreak{}n\allowbreak{}g\allowbreak{}\_\allowbreak{}\allowbreak{}t\allowbreak{}y\allowbreak{}p\allowbreak{}e\allowbreak{}<\allowbreak{}T\allowbreak{}>}, \texttt{u\allowbreak{}n\allowbreak{}d\allowbreak{}e\allowbreak{}r\allowbreak{}l\allowbreak{}y\allowbreak{}i\allowbreak{}n\allowbreak{}g\allowbreak{}\_\allowbreak{}\allowbreak{}t\allowbreak{}y\allowbreak{}p\allowbreak{}e\allowbreak{}\_\allowbreak{}\allowbreak{}t\allowbreak{}<\allowbreak{}T\allowbreak{}>};
\item{} \texttt{e\allowbreak{}n\allowbreak{}u\allowbreak{}m\allowbreak{}\_\allowbreak{}\allowbreak{}c\allowbreak{}o\allowbreak{}n\allowbreak{}s\allowbreak{}t\allowbreak{}a\allowbreak{}n\allowbreak{}t\allowbreak{}<\allowbreak{}V\allowbreak{}a\allowbreak{}l\allowbreak{}u\allowbreak{}e\allowbreak{}>}: \texttt{s\allowbreak{}t\allowbreak{}d\allowbreak{}:\allowbreak{}:\allowbreak{}i\allowbreak{}n\allowbreak{}t\allowbreak{}e\allowbreak{}g\allowbreak{}r\allowbreak{}a\allowbreak{}l\allowbreak{}\_\allowbreak{}\allowbreak{}c\allowbreak{}o\allowbreak{}n\allowbreak{}s\allowbreak{}t\allowbreak{}a\allowbreak{}n\allowbreak{}t} holding an enum value;
