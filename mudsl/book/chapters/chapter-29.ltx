\item{} \texttt{i\allowbreak{}s\allowbreak{}\_\allowbreak{}\allowbreak{}m\allowbreak{}a\allowbreak{}g\allowbreak{}i\allowbreak{}c\allowbreak{}\_\allowbreak{}\allowbreak{}e\allowbreak{}n\allowbreak{}u\allowbreak{}m\allowbreak{}\_\allowbreak{}\allowbreak{}s\allowbreak{}u\allowbreak{}p\allowbreak{}p\allowbreak{}o\allowbreak{}r\allowbreak{}t\allowbreak{}e\allowbreak{}d}: compiler support indicator;
