\texttt{case\_\allowbreak{}insensitive} performs ASCII case-insensitive
comparison. A binary character predicate may be supplied instead.
Unknown runtime values produce empty names, empty optionals, or
\texttt{false}, as appropriate.

\texttt{enum\_\allowbreak{}value\textless{}\allowbreak{}E\textgreater{}\allowbreak{}(\allowbreak{}index)\allowbreak{}}
requires a valid index. Its compile-time overload checks the index at
compilation.
\texttt{enum\_\allowbreak{}name\textless{}\allowbreak{}Value\textgreater{}\allowbreak{}(\allowbreak{})\allowbreak{}}
and
\texttt{enum\_\allowbreak{}index\textless{}\allowbreak{}Value\textgreater{}\allowbreak{}(\allowbreak{})\allowbreak{}}
require a named/reflected value and diagnose invalid template arguments
at compilation.

\subsection{Traits and reflection
modes}\label{ch29-traits-and-reflection-modes}

\begin{itemize}
\tightlist
\item
  \texttt{is\_\allowbreak{}scoped\_\allowbreak{}enum\textless{}\allowbreak{}T\textgreater{}\allowbreak{}},
  \texttt{is\_\allowbreak{}scoped\_\allowbreak{}enum\_\allowbreak{}v\textless{}\allowbreak{}T\textgreater{}\allowbreak{}};
\item
  \texttt{is\_\allowbreak{}unscoped\_\allowbreak{}enum\textless{}\allowbreak{}T\textgreater{}\allowbreak{}},
  \texttt{is\_\allowbreak{}unscoped\_\allowbreak{}enum\_\allowbreak{}v\textless{}\allowbreak{}T\textgreater{}\allowbreak{}};
\item
  \texttt{underlying\_\allowbreak{}type\textless{}\allowbreak{}T\textgreater{}\allowbreak{}},
  \texttt{underlying\_\allowbreak{}type\_\allowbreak{}t\textless{}\allowbreak{}T\textgreater{}\allowbreak{}};
\item
  \texttt{enum\_\allowbreak{}constant\textless{}\allowbreak{}Value\textgreater{}\allowbreak{}}:
  \texttt{std:\allowbreak{}:\allowbreak{}integral\_\allowbreak{}constant}
  holding an enum value;
\item
  \texttt{Enum\textless{}\allowbreak{}T\textgreater{}\allowbreak{}}:
  upstream enum-type wrapper;
\item
  \texttt{is\_\allowbreak{}magic\_\allowbreak{}enum\_\allowbreak{}supported}:
  compiler support indicator;
\item
  \texttt{dsl:\allowbreak{}:\allowbreak{}is\_\allowbreak{}flags\textless{}\allowbreak{}T\textgreater{}\allowbreak{}},
  \texttt{dsl:\allowbreak{}:\allowbreak{}is\_\allowbreak{}flags\_\allowbreak{}v\textless{}\allowbreak{}T\textgreater{}\allowbreak{}}:
  whether an enum uses flags reflection; these MuDSL additions are false
  for non-enum types.
