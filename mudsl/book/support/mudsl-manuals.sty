\NeedsTeXFormat{LaTeX2e}[2022-06-01]
\ProvidesPackage{support/mudsl-manuals}[2026/11/09 Printed Markdown reference manuals]
\RequirePackage{support/mudsl-chapters}
\RequirePackage{support/mudsl-tables}
\RequirePackage{support/mudsl-links}
% A reference entry is more compact than a teaching chapter. Formatting is
% scoped so subsequent parts and source appendices keep their original design.
\newenvironment{MuManuals}{%
  \titleformat{\chapter}[display]
    {\normalfont\raggedright\color{MuInk}}
    {\sffamily\scriptsize\bfseries\color{MuAccent}REFERENCE\enspace\thechapter}
    {5pt}{\LARGE\bfseries}
    [\vspace{0.4ex}{\color{MuRule}\titlerule[0.5pt]}]%
  \titlespacing*{\chapter}{0pt}{0pt}{0.6\baselineskip}%
  \setlength{\parindent}{0pt}%
  \setlength{\parskip}{0.35\baselineskip plus 1pt minus 0.5pt}%
  % Signature-heavy lines have little stretchable word space. Give only the
  % emergency line-breaking pass extra slack rather than protruding or scaling.
  \setlength{\emergencystretch}{6em}%
}{\par\clearpage}
\DeclareRobustCommand{\MuManualCode}[1]{{\ttfamily #1}}
\DeclareRobustCommand{\MuManualBreak}{\penalty700\relax}
\newcommand{\MuManualSource}[1]{%
  {\noindent\sffamily\scriptsize\color{MuMuted}SOURCE\enspace
    \MuManualCode{#1}\par}\nobreak\smallskip\noindent\ignorespaces}
\newcommand{\MuManualHeading}[4]{%
  \ifcase#1\relax\or\section*{#3}\or\section*{#3}%
    \or\subsection*{#3}\or\subsubsection*{#3}%
    \or\paragraph*{#3}\else\subparagraph*{#3}\fi
  \label{#2}%
  \bookmark[level=#4,dest=\@currentHref]{#3}%
  \ifnum#1<3\relax\markright{#3}\fi}
\pdfstringdefDisableCommands{\def\MuManualCode#1{#1}\def\MuManualBreak{}}
\endinput
