\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{support/mudsl-runningheads}[2026/11/09 Running navigation and folios]
\RequirePackage{support/mudsl-palette}
\RequirePackage{fancyhdr,truncate}
\newcommand{\MuRunningTitle}[1]{%
  {\sffamily\scriptsize\color{MuMuted}\truncate{0.83\textwidth}{\nouppercase{#1}}}}
\newcommand{\MuFolio}{{\sffamily\small\bfseries\color{MuAccent}\thepage}}
\pagestyle{fancy}
\fancyhf{}
\if@twoside
  \fancyhead[LE]{\MuRunningTitle{\leftmark}}
  \fancyhead[RO]{\MuRunningTitle{\rightmark}}
  \fancyhead[LO,RE]{\sffamily\scriptsize\color{MuMuted}MuDSL}
  \fancyfoot[LE,RO]{\MuFolio}
\else
  \fancyhead[L]{\MuRunningTitle{\rightmark}}
  \fancyfoot[R]{\MuFolio}
\fi
\renewcommand{\headrulewidth}{0.35pt}
\renewcommand{\footrulewidth}{0pt}
\let\Mu@headrule\headrule
\renewcommand{\headrule}{{\color{MuRule}\Mu@headrule}}
\fancypagestyle{plain}{%
  \fancyhf{}%
  \if@twoside\fancyfoot[LE,RO]{\MuFolio}\else\fancyfoot[R]{\MuFolio}\fi
  \renewcommand{\headrulewidth}{0pt}}
\renewcommand{\chaptermark}[1]{%
  \markboth{\if@mainmatter\thechapter\enspace\fi#1}{#1}}
\renewcommand{\sectionmark}[1]{\markright{\thesection\enspace#1}}
\endinput
