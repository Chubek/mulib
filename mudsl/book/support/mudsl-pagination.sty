% Honor openright documents without putting running heads on inserted blanks.
\renewcommand{\cleardoublepage}{%
  \clearpage
  \if@twoside\ifodd\c@page\else
    \hbox{}\thispagestyle{empty}\newpage
    \if@twocolumn\hbox{}\newpage\fi
  \fi\fi}
