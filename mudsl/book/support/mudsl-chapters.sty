\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{support/mudsl-chapters}[2026/11/09 Numbered and unnumbered chapter openings]
\RequirePackage{support/mudsl-headings}
\titleformat{\chapter}[display]
  {\normalfont\raggedright\color{MuInk}}
  {\sffamily\small\bfseries\color{MuAccent}\MakeUppercase{\chaptertitlename}\enspace
    {\fontsize{34}{38}\selectfont\thechapter}}
  {12pt}{\huge\bfseries}
  [\vspace{0.6ex}{\color{MuRule}\titlerule[0.6pt]}]
\titleformat{name=\chapter,numberless}[display]
  {\normalfont\raggedright\huge\bfseries\color{MuInk}}{}{0pt}{}
  [\vspace{0.6ex}{\color{MuRule}\titlerule[0.6pt]}]
\titlespacing*{\chapter}{0pt}{0pt}{1.6\baselineskip}
\endinput
