mulib Checksum <- G:MulibWrap("uip-checksum");
val bytes <- Checksum:Array("uint8_t", [255, 255, 255, 255]);
G:Assert(Checksum:mulib_uip_checksum(bytes, 4) == 0);
mulib Dhcp <- G:MulibWrap("dhcp4-client");
val packet <- Dhcp:Buffer(244);
val mac <- Dhcp:Array("uint8_t", [2, 0, 0, 0, 0, 1]);
val written <- Dhcp:New("size_t");
G:Assert(Dhcp:mulib_dhcp4_client_discover(packet, packet:Count, mac, 42, written) == 0);
G:Assert(written:Get() == 244);
val kind <- Dhcp:New("uint8_t");
G:Assert(Dhcp:mulib_dhcp4_client_type(packet, written:Get(), kind) == 0);
G:Assert(kind:Get() == 1);
mulib Tcp <- G:MulibWrap("uip-tcp-state");
val state <- Tcp:New("mulib_uip_tcp_state_t");
G:Assert(Tcp:mulib_uip_tcp_state_next(state, Tcp:MULIB_UIP_TCP_ACTIVE_OPEN) == 0);
G:Assert(state:Get() == Tcp:MULIB_UIP_TCP_SYN_SENT);
G:Assert(Tcp:mulib_uip_tcp_state_next(state, Tcp:MULIB_UIP_TCP_SYN_ACK) == 0);
G:Assert(state:Get() == Tcp:MULIB_UIP_TCP_ESTABLISHED);
"networking ok";
