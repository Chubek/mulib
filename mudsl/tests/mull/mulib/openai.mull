mulib Protocol <- G:MulibWrap("openai");
mulib Client <- G:MulibWrap("openai-client");
mulib Server <- G:MulibWrap("openai-server");
mulib Sse <- G:MulibWrap("sse");
mulib Json <- G:MulibWrap("json");
G:Assert(Protocol:mulib_openai_operation_count() == 388);
val operation <- Protocol:mulib_openai_operation("createResponse");
G:Assert(operation:method:String() == "POST");
G:Assert(operation:path:String() == "/responses");
val client <- Client:mulib_openai_client_default(nil);
G:Assert(client:base_url:String() == "https://api.openai.com/v1");
G:Assert(client:transport:options:max_redirects == 0);
val server <- Server:mulib_openai_server_default(nil, nil);
G:Assert(server:base_path:String() == "/v1");
val body <- Client:mulib_openai_chat_request("synthetic-model", "hello");
G:Assert(Json:mulib_json_size(Json:mulib_json_get(body, "messages")) == 1);
Json:mulib_json_destroy(body);
val error <- Protocol:mulib_openai_error("example", "invalid_request_error", nil, nil);
G:Assert(Json:mulib_json_get(error, "error") != nil);
Json:mulib_json_destroy(error);
var events <- 0;
val callback <- Sse:Callback("mulib_sse_event_fn", fn(user, event) {
    G:Assert(event:data:String(event:data_length) == "hello");
    events <- events + 1;
    return 1;
});
val parser <- Sse:mulib_sse_create(1024, callback, nil);
G:Assert(Sse:mulib_sse_feed(parser, "data: hello\n\n", 13) == 1);
G:Assert(Sse:mulib_sse_finish(parser) == 1 and events == 1);
Sse:mulib_sse_destroy(parser);
"openai ok";
