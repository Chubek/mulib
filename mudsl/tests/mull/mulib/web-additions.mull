mulib Url <- G:MulibWrap("urlcanon");
val normalized <- Url:Buffer(128);
G:Assert(Url:mulib_urlcanon_normalize("HTTPS://Example.COM:443/a#fragment", normalized, normalized:Count) == 1);
G:Assert(normalized:String() == "https://example.com/a");
mulib Mime <- G:MulibWrap("mime");
val filenameType <- Mime:mulib_mime_type("image.PNG");
G:Assert(filenameType:String() == "image/png");
val contentType <- Mime:Buffer(64);
G:Assert(Mime:mulib_mime_content_type("Text/HTML; charset=UTF-8", contentType, contentType:Count) == 1);
G:Assert(contentType:String() == "text/html");
mulib Charset <- G:MulibWrap("charset");
val encoding <- Charset:Buffer(32);
G:Assert(Charset:mulib_charset_extract("text/html; charset", encoding, encoding:Count) == 0);
G:Assert(Charset:mulib_charset_extract("text/html; charset=UTF-8", encoding, encoding:Count) == 1);
G:Assert(encoding:String() == "utf-8");
mulib Policy <- G:MulibWrap("netpolicy");
G:Assert(Policy:mulib_netpolicy_public_url("http://[::1]/") == 0);
G:Assert(Policy:mulib_netpolicy_public_url("https://example.com/") == 1);
mulib Scrape <- G:MulibWrap("scrape");
val text <- Scrape:Buffer(64);
G:Assert(Scrape:mulib_scrape_text("<p>hello</p><script>hidden</script><p>world</p>", text, text:Count) == 11);
G:Assert(text:String() == "hello world");
mulib Storage <- G:MulibWrap("webstorage");
val store <- Storage:New("mulib_webstorage_t");
G:Assert(Storage:mulib_webstorage_set(store, "key", "value") == 1);
val stored <- Storage:mulib_webstorage_get(store, "key");
G:Assert(stored:String() == "value");
Storage:mulib_webstorage_free(store);
"web additions ok";
