mulib Db <- G:MulibWrap("eda-design-db");
mulib Txn <- G:MulibWrap("eda-transaction");
val db <- Db:New("mulib_eda_design_db_t");
val record <- Db:New("mulib_eda_db_record_t");
record:Set("id", 1);
record:Set("type", 7);
record:Set("value", 1000);
G:Assert(Db:mulib_eda_db_put(db, record) == 1);
val edit <- Txn:New("mulib_eda_transaction_t");
G:Assert(Txn:mulib_eda_transaction_begin(edit, edit:staged) == 0);
G:Assert(Txn:mulib_eda_transaction_begin(edit, db) == 1);
record:Set("value", 2200);
G:Assert(Db:mulib_eda_db_put(edit:staged, record) == 1);
Txn:mulib_eda_transaction_rollback(edit);
G:Assert(Db:mulib_eda_db_get(db, 1, record) == 1);
G:Assert(record:value == 1000);
G:Assert(Txn:mulib_eda_transaction_begin(edit, db) == 1);
record:Set("value", 3300);
G:Assert(Db:mulib_eda_db_put(edit:staged, record) == 1);
G:Assert(Txn:mulib_eda_transaction_commit(edit) == 1);
G:Assert(Db:mulib_eda_db_get(db, 1, record) == 1);
G:Assert(record:value == 3300);
G:Assert(Txn:mulib_eda_transaction_begin(edit, db) == 1);
record:Set("value", 4700);
G:Assert(Db:mulib_eda_db_put(db, record) == 1);
G:Assert(Txn:mulib_eda_transaction_commit(edit) == 0);
G:Assert(edit:active == 1);
Txn:mulib_eda_transaction_rollback(edit);
Db:mulib_eda_db_free(db);
"eda transaction ok";
