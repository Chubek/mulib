mulib Money <- G:MulibWrap("money");
val amount <- Money:New("mulib_money_t");
val scaled <- Money:New("mulib_money_t");
G:Assert(Money:Parse("12.34", "USD", 2, amount) == 1);
G:Assert(Money:Scale(amount, 3, 2, scaled) == 1);
G:Assert(scaled:minor == 1851);
G:Assert(Money:Valid(scaled) == 1);
mulib Forecast <- G:MulibWrap("price-forecast");
val series <- Forecast:Array("double", [10, 20, 30]);
val prediction <- Forecast:New("double");
G:Assert(Forecast:mulib_price_forecast(series, 3, 2, Forecast:MULIB_PRICE_FORECAST_DRIFT, 0, 0, prediction) == 1);
G:Assert(prediction:Get() == 50);
mulib Origin <- G:MulibWrap("browser-origin");
val first <- Origin:New("mulib_browser_origin_t");
val second <- Origin:New("mulib_browser_origin_t");
G:Assert(Origin:Parse("HTTPS://EXAMPLE.com.:443/path", first) == 1);
G:Assert(Origin:Parse("https://example.com", second) == 1);
G:Assert(Origin:Equal(first, second) == 1);
mulib Cache <- G:MulibWrap("browser-cache");
val cache <- Cache:New("mulib_browser_cache_t");
cache:Set("max_bytes", 4);
G:Assert(Cache:Put(cache, "https://example.com", "tag", 100, "abc", 3) == 1);
G:Assert(Cache:Get(cache, "https://example.com", 99) != nil);
G:Assert(Cache:Prune(cache, 100) == 1);
Cache:Free(cache);
mulib Range <- G:MulibWrap("dom-range");
val range <- Range:New("mulib_dom_range_t");
val shifted <- Range:New("mulib_dom_range_t");
G:Assert(Range:Make(1, 4, 10, 1, range) == 1);
G:Assert(Range:Shift(range, 2, 10, shifted) == 1);
G:Assert(shifted:start == 3);
mulib Stream <- G:MulibWrap("browser-stream");
val stream <- Stream:New("mulib_browser_stream_t");
var calls <- 0;
val callback <- Stream:Callback("mulib_browser_event_fn", fn(context, event) {
    calls <- calls + 1;
    G:Assert(event:sequence == 1);
    return 1;
});
G:Assert(Stream:Subscribe(stream, 1, callback, nil) == 1);
mulib Tokens <- G:MulibWrap("browser-tokenstream");
G:Assert(Tokens:Emit(stream, 1, 1, "x", 1) == 1);
G:Assert(calls == 1);
Stream:Free(stream);
"web primitives ok";
