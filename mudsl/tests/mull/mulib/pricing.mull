mulib Stats <- G:MulibWrap("statsproc");
val prices <- Stats:Array("double", [90, 100, 110]);
val median <- Stats:New("double");
G:Assert(Stats:Quantile(prices, 3, 0.5, median) == 1);
G:Assert(median:Get() == 100);
mulib Opt <- G:MulibWrap("priceopt");
val model <- Opt:New("mulib_priceopt_demand_model_t");
model:Set("kind", Opt:MULIB_PRICEOPT_LINEAR);
model:Set("scale", 100);
model:Set("shape", 1);
G:Assert(Opt:Demand(model, 25) == 75);
mulib Sat <- G:MulibWrap("sat");
val solver <- Sat:Create(1, 0);
val clause <- Sat:Array("int", [1]);
G:Assert(Sat:AddClause(solver, clause, 1) == 1);
G:Assert(Sat:Solve(solver, nil, 0) == Sat:MULIB_SAT_SAT);
G:Assert(Sat:Value(solver, 1) == 1);
Sat:Destroy(solver);
"pricing ok";
