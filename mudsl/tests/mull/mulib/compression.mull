mulib Buffer <- G:MulibWrap("Buffer");
mulib Gzip <- G:MulibWrap("Gzip");
mulib Bzip2 <- G:MulibWrap("Bzip2");
mulib Zstd <- G:MulibWrap("Zstd");
mulib Xz <- G:MulibWrap("Xz");
mulib Lzma <- G:MulibWrap("Lzma");
mulib Lzip <- G:MulibWrap("Lzip");
mulib Lzf <- G:MulibWrap("Lzf");
mulib Lzop <- G:MulibWrap("Lzop");
val verify <- fn(codec) {
    val packed <- Buffer:New("mulib_buffer_t");
    val plain <- Buffer:New("mulib_buffer_t");
    G:Assert(codec:Encode("hello hello hello", 17, packed) == 0);
    G:Assert(codec:Decode(packed:data, packed:length, 16, plain) < 0);
    G:Assert(plain:length == 0);
    G:Assert(codec:Decode(packed:data, packed:length, 17, plain) == 0);
    G:Assert(plain:data:String(plain:length) == "hello hello hello");
    Buffer:Free(packed);
    Buffer:Free(plain);
};
verify(Gzip); verify(Bzip2); verify(Zstd); verify(Xz);
verify(Lzma); verify(Lzip); verify(Lzf); verify(Lzop);
mulib Zip <- G:MulibWrap("Zip");
val writer <- Zip:New("mulib_zip_writer_t");
val reader <- Zip:New("mulib_zip_reader_t");
G:Assert(Zip:Add(writer, "hello", "hello", 5, 8) == 0);
G:Assert(Zip:Finish(writer) == 0);
G:Assert(Zip:OpenLimited(reader, writer:bytes:data, writer:bytes:length, 1, 4) == Zip:MULIB_ZIP_ELIMIT);
G:Assert(Zip:OpenLimited(reader, writer:bytes:data, writer:bytes:length, 1, 5) == 0);
Zip:Close(reader); Zip:WriterFree(writer);
"compression ok";
