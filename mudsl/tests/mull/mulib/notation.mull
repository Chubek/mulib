mulib Tbl <- G:MulibWrap("Tbl");
mulib Symbol <- G:MulibWrap("Symbol");
mulib Eqn <- G:MulibWrap("Eqn");
mulib Chem <- G:MulibWrap("Chem");
mulib Chart <- G:MulibWrap("Chart");
mulib Paleo <- G:MulibWrap("Paleography");
mulib Json <- G:MulibWrap("Json");
mulib Xml <- G:MulibWrap("Xml");
mulib Alloc <- G:MulibWrap("Alloc");
val length <- Tbl:New("size_t");
val source <- "| A | B |\n| --- | ---: |\n| 1 | 2 |\n";
val table <- Tbl:Parse(source, G:Len(source), "pipe", nil);
G:Assert(table != nil and Tbl:Rows(table) == 2 and Tbl:Columns(table) == 2);
val html <- Tbl:Render(table, "html", length, nil);
G:Assert(html:String(length:Get()) != "");
Alloc:Free(nil, html); Xml:Destroy(table);
val registry <- Symbol:Create();
G:Assert(registry != nil and Symbol:Count(registry) > 70 and Symbol:Find(registry, "alpha") != nil);
val expr <- Eqn:Parse(registry, "sqrt(9)+frac(1,2)", 17, nil);
val number <- Eqn:New("double");
G:Assert(expr != nil and Eqn:Eval(expr, nil, nil, number, nil) == 1 and number:Get() == 3.5);
Eqn:Destroy(expr); Symbol:Destroy(registry);
val water <- Chem:Parse("H2O", 3, nil);
G:Assert(water != nil and Chem:Count(water, 1) == 2 and Chem:MolarMass(water) > 18);
Xml:Destroy(Chem:mulib_chem_mathml(water, nil)); Chem:Destroy(water);
val chart <- Chart:Create(nil, nil);
val data <- Json:Parse("[30,70]", 7, nil);
G:Assert(chart != nil and data != nil);
var svg <- Chart:Render(chart, "pie", data, nil, nil);
G:Assert(svg != nil); Xml:Destroy(svg); Json:Destroy(data); Chart:Destroy(chart);
val paleo <- Paleo:Create(nil, nil);
val script <- "lpaleo.define{name='sun',path='M 0 0 L 500 0 L 250 700 Z',codepoint=57344,advance=600};lpaleo.script('novel',{mapping={a='sun'}})";
G:Assert(paleo != nil and Paleo:Extend(paleo, script, G:Len(script), nil) == 1);
svg <- Paleo:mulib_paleography_svg(paleo, "a", 1, "novel", nil, nil);
G:Assert(svg != nil); Xml:Destroy(svg);
val css <- Paleo:mulib_paleography_css(paleo, length, nil);
G:Assert(css:String(length:Get()) != ""); Alloc:Free(nil, css); Paleo:Destroy(paleo);
"notation ok";
