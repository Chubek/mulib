val Printf <- G:LoadLib("printf") or G:DieWith("Import Error: $E?");
val Terminal <- G:LoadLib("terminal") or G:DieWith("Import Error: $E?");
Printf:SetMainSink(G:GetStdout());
Printf:Printf("{} {} {{}}\n", "MuLL", 42);
val Math <- G:LoadLib("math");
G:Assert(Math:Pow(2, 10) == 1024);
G:Assert(Math:Sqrt(9) == 3);
G:Assert(Math:Floor(-1.2) == -2);
val Text <- G:LoadLib("text");
G:Assert(Text:Split("a,,b,", ",") == ["a", "", "b", ""]);
G:Assert(Text:Join(["a", "b"], "/") == "a/b");
G:Assert(Text:Replace("aaaa", "aa", "b") == "bb");
G:Assert(Text:Upper("aZ9") == "AZ9");
G:Assert(Text:Lower("aZ9") == "az9");
val List <- G:LoadLib("list");
val xs <- List:Range(0,5);
G:Assert(xs == [0,1,2,3,4]);
G:Assert(List:Map(xs, fn(x){ return x*x; }) == [0,1,4,9,16]);
G:Assert(List:Filter(xs, fn(x){ return x%2 == 0; }) == [0,2,4]);
G:Assert(List:Fold(xs, 0, fn(a,b){ return a+b; }) == 10);
G:Assert(List:Push(xs, 5)[5] == 5);
G:Assert(List:Set(xs, 0, 99)[0] == 99);
G:Assert(xs[0] == 0);
var captured <- "";
Printf:SetMainSink(fn(s){ captured <- captured + s; });
Printf:Println("sink");
G:Assert(captured == "sink\n");
val Again <- G:LoadLib("printf");
Again:Print("cached");
G:Assert(captured == "sink\ncached");
Printf:SetMainSink(G:GetStdout());
Terminal:Write("terminal\n");
return "stdlib ok";
