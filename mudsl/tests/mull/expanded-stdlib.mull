val A <- G:LoadLib("assert") or G:DieWith("$E?");
val O <- G:LoadLib("option") or G:DieWith("$E?");
A:Equal(O:GetOr(O:Some(nil),42),nil);
A:Equal(O:GetOr(O:None(),42),42);
A:Equal(O:Map(O:Some(3),fn(x){return x*2;}),O:Some(6));
A:Equal(O:Bind(O:None(),fn(x){G:DieWith("unused");}),O:None());
val R <- G:LoadLib("result") or G:DieWith("$E?");
A:Equal(R:Unwrap(R:Map(R:Ok(3),fn(x){return x+1;})),4);
A:Equal(R:Bind(R:Err("bad"),fn(x){G:DieWith("unused");}),R:Err("bad"));
val F <- G:LoadLib("function") or G:DieWith("$E?");
A:Equal(F:Identity(7),7);
A:Equal(F:Constant(nil)(false),nil);
A:Equal(F:Compose(fn(x){return x*2;},fn(x){return x+1;})(4),10);
A:Equal(F:Flip(fn(a,b){return a-b;})(2,5),3);
A:Equal(F:Partial(fn(a,b){return a+b;},3)(4),7);
A:Equal(F:Times(3,fn(x){return x*2;},1),8);
val P <- G:LoadLib("predicate") or G:DieWith("$E?");
A:Check(P:All([],fn(x){return false;}),"empty all");
A:Equal(P:Any([],fn(x){return true;}),false);
A:Check(P:Negate(fn(x){return x==0;})(1),"negate");
A:Equal(P:Both(fn(x){return false;},fn(x){G:DieWith("unused");})(1),false);
A:Equal(P:Either(fn(x){return true;},fn(x){G:DieWith("unused");})(1),true);
val Pair <- G:LoadLib("pair") or G:DieWith("$E?");
A:Equal(Pair:First(Pair:New(1,2)),1); A:Equal(Pair:Second([1,2]),2);
A:Equal(Pair:Swap([1,2]),[2,1]);
A:Equal(Pair:Map([1,2],fn(x){return x+1;},fn(x){return x*2;}),[2,4]);
val Seq <- G:LoadLib("sequence") or G:DieWith("$E?");
A:Equal(Seq:Zip([1,2],[3]),[[1,3]]); A:Equal(Seq:Enumerate([false]),[[0,false]]);
A:Equal(Seq:Flatten([[1],[],[2,3]]),[1,2,3]); A:Equal(Seq:Reverse([1,2,3]),[3,2,1]);
val Slice <- G:LoadLib("slice") or G:DieWith("$E?");
A:Equal(Slice:Sub([0,1,2],1,3),[1,2]); A:Equal(Slice:Take([],0),[]);
A:Equal(Slice:Drop([1,2],2),[]); A:Equal(Slice:Chunk([1,2,3],2),[[1,2],[3]]);
val Search <- G:LoadLib("search") or G:DieWith("$E?");
A:Equal(Search:Index([nil,false],nil),0); A:Equal(Search:Index([],nil),nil);
A:Equal(Search:Contains([[1]],[1]),true);
A:Equal(Search:Find([nil],fn(x){return true;}),{found:true,index:0,value:nil});
A:Equal(Search:Count([1,2,3],fn(x){return x>1;}),2);
val Sort <- G:LoadLib("sort") or G:DieWith("$E?");
A:Equal(Sort:Ascending([3,1,2]),[1,2,3]); A:Equal(Sort:Descending([3,1,2]),[3,2,1]);
A:Equal(Sort:By([[1,"a"],[0,"b"],[1,"c"]],fn(a,b){return a[0]<b[0];}),[[0,"b"],[1,"a"],[1,"c"]]);
val Set <- G:LoadLib("set") or G:DieWith("$E?");
A:Equal(Set:Unique([1,2,1]),[1,2]); A:Equal(Set:Union([2,1],[1,3]),[2,1,3]);
A:Equal(Set:Intersection([1,1,2],[1]),[1]); A:Equal(Set:Difference([1,2,2],[1]),[2]);
val Stack <- G:LoadLib("stack") or G:DieWith("$E?");
A:Equal(Stack:Peek(Stack:Push(Stack:New(),3)),3); A:Equal(Stack:Pop([1,2]),{value:2,rest:[1]});
val Queue <- G:LoadLib("queue") or G:DieWith("$E?");
A:Equal(Queue:Peek(Queue:Enqueue(Queue:New(),3)),3); A:Equal(Queue:Dequeue([1,2]),{value:1,rest:[2]});
val Deque <- G:LoadLib("deque") or G:DieWith("$E?");
A:Equal(Deque:PushBack(Deque:PushFront(Deque:New(),1),2),[1,2]);
A:Equal(Deque:PopFront([1,2]):value,1); A:Equal(Deque:PopBack([1,2]):value,2);
val V <- G:LoadLib("vector") or G:DieWith("$E?");
A:Equal(V:Dot([1,2],[3,4]),11); A:Equal(V:Scale([1,2],3),[3,6]);
A:Equal(V:Add([1,2],[3,4]),[4,6]); A:Equal(V:Norm([3,4]),5); A:Near(V:Norm(V:Normalize([3,4])),1,0.00000001);
val M <- G:LoadLib("matrix") or G:DieWith("$E?");
A:Equal(M:Shape([]),[0,0]); A:Equal(M:Transpose([[1,2],[3,4]]),[[1,3],[2,4]]);
A:Equal(M:Multiply([[1,2],[3,4]],[[5],[6]]),[[17],[39]]);
val Stats <- G:LoadLib("statistics") or G:DieWith("$E?");
A:Equal(Stats:Sum([]),0); A:Equal(Stats:Mean([2,4]),3);
A:Equal(Stats:Variance([2,4]),1); A:Equal(Stats:Median([4,1,2,3]),2.5); A:Equal(Stats:Median([3,1,2]),2);
val I <- G:LoadLib("integer") or G:DieWith("$E?");
A:Equal(I:Gcd(-12,18),6); A:Equal(I:Gcd(0,0),0); A:Equal(I:Lcm(-4,6),12);
A:Equal(I:DivMod(-7,3),[-3,2]); A:Equal(I:IsEven(-4),true); A:Equal(I:Check(9007199254740991),9007199254740991);
val Bits <- G:LoadLib("bit") or G:DieWith("$E?");
A:Equal(Bits:And(13,10),8); A:Equal(Bits:Or(13,10),15); A:Equal(Bits:Xor(13,10),7);
A:Equal(Bits:Not(0),4294967295); A:Equal(Bits:ShiftRight(4294967295,31),1);
A:Equal(Bits:ShiftLeft(4294967295,31),2147483648); A:Equal(Bits:ShiftLeft(1,32),0);
val C <- G:LoadLib("combinatorics") or G:DieWith("$E?");
A:Equal(C:Factorial(0),1); A:Equal(C:Factorial(6),720); A:Equal(C:Choose(5,2),10);
A:Equal(C:Choose(50,25),126410606437752);
A:Equal(C:Cartesian([1,2],[3]),[[1,3],[2,3]]);
val Range <- G:LoadLib("range") or G:DieWith("$E?");
A:Equal(Range:Step(5,-1,-2),[5,3,1]); A:Equal(Range:Step(0,0,1),[]);
A:Equal(Range:Contains(0,3,3),false); A:Equal(Range:Clamp(5,0,3),3);
val S <- G:LoadLib("string") or G:DieWith("$E?");
A:Equal(S:Sub("hello",1,4),"ell"); A:Equal(S:Trim(" \tword\r\n"),"word");
A:Equal(S:StartsWith("abc",""),true); A:Equal(S:EndsWith("abc","bc"),true); A:Equal(S:Repeat("ab",3),"ababab");
val Ascii <- G:LoadLib("ascii") or G:DieWith("$E?");
A:Equal(Ascii:IsDigit("0"),true); A:Equal(Ascii:IsAlpha("_"),false);
A:Equal(Ascii:IsAlnum("Z"),true); A:Equal(Ascii:IsSpace("\t"),true); A:Equal(Ascii:Digit("9"),9);
val Csv <- G:LoadLib("csv") or G:DieWith("$E?");
val rows <- [["a,b","c\"d",""],["one\ntwo","three","four"]];
A:Equal(Csv:Decode(Csv:Encode(rows)),rows); A:Equal(Csv:Decode(""),[]);
A:Equal(Csv:Decode("a,b\r\nc,\r\n"),[["a","b"],["c",""]]);
val Path <- G:LoadLib("path") or G:DieWith("$E?");
A:Equal(Path:Normalize("/a//b/../c/."),"/a/c"); A:Equal(Path:Normalize("../../a"),"../../a");
A:Equal(Path:Join("/a","/b"),"/b"); A:Equal(Path:Basename("a/b/"),"b"); A:Equal(Path:Dirname("/a"),"/");
A:Equal(Path:Join("","b"),"b");
val Url <- G:LoadLib("url") or G:DieWith("$E?");
A:Equal(Url:Encode("a b+c"),"a%20b%2Bc"); A:Equal(Url:Decode("a%20b%2bc"),"a b+c");
A:Equal(Url:Decode(Url:Encode("\t\r\n%/?")),"\t\r\n%/?");
val Version <- G:LoadLib("semver") or G:DieWith("$E?");
A:Equal(Version:Parse("1.20.3"),[1,20,3]); A:Equal(Version:Compare("1.2.3","1.10.0"),-1);
A:Equal(Version:Compatible("0.2.1","0.2.5"),true); A:Equal(Version:Compatible("0.0.1","0.0.2"),false);
val Units <- G:LoadLib("units") or G:DieWith("$E?");
A:Near(Units:Degrees(Units:Radians(90)),90,0.000001); A:Equal(Units:CelsiusToFahrenheit(0),32);
A:Equal(Units:FahrenheitToCelsius(212),100); A:Near(Units:MetersToFeet(Units:FeetToMeters(5)),5,0.000001);
A:Equal(Units:MillisecondsToSeconds(Units:SecondsToMilliseconds(2)),2);
val Geo <- G:LoadLib("geometry") or G:DieWith("$E?");
A:Equal(Geo:Distance(Geo:Point(0,0),Geo:Point(3,4)),5);
A:Equal(Geo:Area(Geo:Intersection(Geo:Rect(0,0,3,3),Geo:Rect(2,2,4,4))),1);
A:Equal(Geo:Contains(Geo:Rect(0,0,3,3),Geo:Point(3,1)),false);
val Color <- G:LoadLib("color") or G:DieWith("$E?");
A:Equal(Color:Hex(Color:Rgb(0,128,255)),"#0080FF");
A:Equal(Color:Mix(Color:Rgb(0,0,0),Color:Rgb(255,255,255),0.5),Color:Rgb(128,128,128));
A:Equal(Color:Invert(Color:Rgb(0,128,255)),Color:Rgb(255,127,0));
A:NotEqual(1,2);
return "30 libraries passed";
