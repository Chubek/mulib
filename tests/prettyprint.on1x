import std.prettyprint as Pretty;

fn main() {
  let (text_status, text)=Pretty.pp_format(Pretty.pp_text("café\n<>&"),80);
  assert(text_status==0 && text=="café\n<>&");
  let doc=Pretty.pp_group(Pretty.pp_cat(Pretty.pp_text("界"),Pretty.pp_cat(Pretty.pp_softline(),Pretty.pp_text("é"))));
  let (fit_status, fit)=Pretty.pp_format(doc,4);
  assert(fit_status==0 && fit=="界 é");
  let (wrap_status, wrapped)=Pretty.pp_format(doc,3);
  assert(wrap_status==0 && wrapped=="界\né");
  let (html_status, html)=Pretty.pp_render(Pretty.pp_math_identifier("x<&"),80,1,1,0);
  assert(html_status==0);
  let (bad_status, bad)=Pretty.pp_format(Pretty.pp_annotate("not-a-style",Pretty.pp_text("x")),80);
  assert(bad_status==-2 && bad=="");
  let (width_status, empty)=Pretty.pp_format(Pretty.pp_text("x"),0);
  assert(width_status==-1 && empty=="");
  assert(text=="café\n<>&");
  println(html);
}
