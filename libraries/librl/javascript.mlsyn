      "start": "class"
    },
    {
      "kind": "word",
      "style": "keyword",
      "start": "const"
    },
    {
      "kind": "word",
      "style": "keyword",
      "start": "continue"
    },
    {
      "kind": "word",
      "style": "keyword",
      "start": "debugger"
    },
    {
