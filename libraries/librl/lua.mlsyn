{
  "version": 1,
  "language": "Lua",
  "rules": [
    {
      "kind": "span",
      "style": "comment",
      "start": "--[[",
      "end": "]]"
    },
    {
      "kind": "line",
      "style": "comment",
      "start": "--"
    },
    {
      "kind": "span",
      "style": "string",
      "start": "\"",
      "end": "\"",
      "escape": "\\"
    },
    {
      "kind": "span",
      "style": "string",
      "start": "'",
      "end": "'",
      "escape": "\\"
    },
    {
      "kind": "number",
      "style": "number"
    },
    {
      "kind": "word",
      "style": "keyword",
      "start": "and"
    },
    {
      "kind": "word",
      "style": "keyword",
      "start": "break"
    },
    {
      "kind": "word",
      "style": "keyword",
      "start": "do"
    },
    {
      "kind": "word",
      "style": "keyword",
      "start": "else"
    },
    {
      "kind": "word",
      "style": "keyword",
      "start": "elseif"
    },
    {
      "kind": "word",
      "style": "keyword",
      "start": "end"
    },
    {
      "kind": "word",
      "style": "keyword",
      "start": "false"
    },
    {
      "kind": "word",
      "style": "keyword",
      "start": "for"
    },
    {
      "kind": "word",
      "style": "keyword",
      "start": "function"
    },
    {
      "kind": "word",
      "style": "keyword",
      "start": "goto"
    },
    {
      "kind": "word",
      "style": "keyword",
      "start": "if"
    },
    {
      "kind": "word",
      "style": "keyword",
      "start": "in"
    },
    {
      "kind": "word",
      "style": "keyword",
      "start": "local"
    },
    {
      "kind": "word",
      "style": "keyword",
      "start": "nil"
    },
    {
      "kind": "word",
      "style": "keyword",
      "start": "not"
    },
    {
      "kind": "word",
      "style": "keyword",
      "start": "or"
    },
    {
      "kind": "word",
      "style": "keyword",
      "start": "repeat"
    },
    {
      "kind": "word",
      "style": "keyword",
      "start": "return"
    },
    {
      "kind": "word",
      "style": "keyword",
      "start": "then"
    },
    {
      "kind": "word",
      "style": "keyword",
      "start": "true"
    },
    {
      "kind": "word",
      "style": "keyword",
      "start": "until"
    },
    {
      "kind": "word",
      "style": "keyword",
      "start": "while"
    }
  ]
}
