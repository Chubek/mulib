# ElviScrape provider: Bing's ordinary HTML SERP (best effort)
elvi bing
host www.bing.com
home https://www.bing.com/
search "https://www.bing.com/search?q={query}&count={limit}"
# Bing generally nests the result link inside the H2 heading
anchor parent h2
rewrite direct
exclude_host bing.com
max_results 30
