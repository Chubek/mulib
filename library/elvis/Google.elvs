# Source: .sot/surfraw/elvi/google, default US web search.
# See library/elvis/README.md. Kept in sync at both Google provider paths.
elvi google
host www.google.com
home https://www.google.com/
search "https://www.google.com/search?q={query}&num={limit}"
# Google's result title is a heading within the anchor (best effort).
anchor child h3
rewrite google
exclude_host google.com
exclude_host googleusercontent.com
max_results 30
