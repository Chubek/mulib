# Source: .sot/surfraw/elvi/bing, ordinary web search.
# See library/elvis/README.md. Kept in sync at both Bing provider paths.
elvi bing
host www.bing.com
home https://www.bing.com/
search "https://www.bing.com/search?q={query}&go=&form=QBLH&filt=all&count={limit}"
# Bing's result anchor is within the H2 heading (best effort).
anchor parent h2
rewrite direct
exclude_host bing.com
max_results 30
