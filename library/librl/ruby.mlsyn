    {
      "kind": "word",
      "style": "type",
      "start": "Hash"
    },
    {
      "kind": "word",
      "style": "type",
      "start": "Integer"
    },
    {
      "kind": "word",
      "style": "type",
      "start": "Module"
    },
    {
      "kind": "word",
      "style": "type",
      "start": "Object"
    },
    {
      "kind": "word",
      "style": "type",
      "start": "Range"
    },
    {
      "kind": "word",
      "style": "type",
      "start": "Regexp"
    },
    {
      "kind": "word",
      "style": "type",
      "start": "String"
    },
    {
      "kind": "word",
      "style": "type",
      "start": "Symbol"
    }
  ]
}
