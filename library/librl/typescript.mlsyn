{
  "version": 1,
  "language": "TypeScript",
  "rules": [
    {
      "kind": "span",
      "style": "comment",
      "start": "/*",
      "end": "*/"
    },
    {
      "kind": "line",
      "style": "comment",
      "start": "//"
    },
    {
      "kind": "span",
      "style": "string",
      "start": "\"",
      "end": "\"",
      "escape": "\\"
    },
    {
      "kind": "span",
      "style": "string",
      "start": "'",
      "end": "'",
      "escape": "\\"
    },
    {
      "kind": "span",
      "style": "string",
      "start": "`",
      "end": "`",
      "escape": "\\"
    },
    {
      "kind": "number",
      "style": "number"
    },
    {
      "kind": "word",
      "style": "keyword",
      "start": "abstract"
    },
    {
