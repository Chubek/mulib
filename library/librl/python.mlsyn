      "start": "complex"
    },
    {
      "kind": "word",
      "style": "type",
      "start": "dict"
    },
    {
      "kind": "word",
      "style": "type",
      "start": "float"
    },
    {
      "kind": "word",
      "style": "type",
      "start": "frozenset"
    },
    {
      "kind": "word",
      "style": "type",
      "start": "int"
    },
    {
      "kind": "word",
      "style": "type",
      "start": "list"
    },
    {
      "kind": "word",
      "style": "type",
      "start": "memoryview"
    },
    {
      "kind": "word",
      "style": "type",
      "start": "object"
    },
    {
      "kind": "word",
      "style": "type",
      "start": "range"
    },
    {
      "kind": "word",
      "style": "type",
      "start": "set"
    },
    {
      "kind": "word",
      "style": "type",
      "start": "str"
    },
    {
      "kind": "word",
      "style": "type",
      "start": "tuple"
    },
    {
      "kind": "word",
      "style": "type",
      "start": "type"
    }
  ]
}
