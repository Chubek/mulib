# Prefer 80 columns with two-space indentation.
width = 80
tabstop = 2
target = plain

# Use bounded layout search for lists and put block braces on separate lines.
# These settings also apply to module source; qualifiers are syntax, not style.
algorithm = search
brace_style = allman

# Keep nested blocks adjacent and leave one blank line between top-level blocks.
nested_block_newlines = 1
top_level_block_newlines = 2
