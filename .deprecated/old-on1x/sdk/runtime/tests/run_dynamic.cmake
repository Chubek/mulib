cmake_minimum_required(VERSION 3.20)
set(args)
foreach(kind RANGE 1 8)
    set(path "${file_${kind}}")
    file(SHA256 "${path}" digest)
    list(APPEND args "${path}" "${digest}")
endforeach()
execute_process(COMMAND "${host}" "${fixture_dir}" ${args} RESULT_VARIABLE result)
if(NOT result STREQUAL "0")
    message(FATAL_ERROR "trusted native module test failed: ${result}")
endif()
