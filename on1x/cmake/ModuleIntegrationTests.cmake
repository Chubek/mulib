# Real generated scanner, Lua/ASDL adapter, compiler, and SDK, with explicit
# external legacy assets. Fixtures create their own input sources and packages.
function(module_test_binary name source)
  add_executable(on1x_integration_${name} ${source})
  target_link_libraries(on1x_integration_${name} PRIVATE ${ARGN})
  if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
    target_compile_options(on1x_integration_${name} PRIVATE -UNDEBUG)
  endif()
endfunction()
function(module_test_script name script)
  add_test(NAME on1x.module_integration.${name} COMMAND "${Python3_EXECUTABLE}" -B
    "${CMAKE_CURRENT_SOURCE_DIR}/${script}" ${ARGN})
endfunction()
