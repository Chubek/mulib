# The dependency is selected explicitly; never download or patch a checkout.
set(ON1X_NOVOSTONE_PROVIDER "SOURCE" CACHE STRING "Novostone provider: SOURCE or PACKAGE")
set_property(CACHE ON1X_NOVOSTONE_PROVIDER PROPERTY STRINGS SOURCE PACKAGE)
if(NOT ON1X_NOVOSTONE_PROVIDER MATCHES "^(SOURCE|PACKAGE)$")
  message(FATAL_ERROR "ON1X_NOVOSTONE_PROVIDER must be SOURCE or PACKAGE")
endif()
set(_on1x_novostone_components Datalog CCDB DatabaseBasedIR QueryBasedIR SpeculativeIR CostCC PCC)
if(BUILD_TESTING AND NOT CMAKE_CROSSCOMPILING)
  list(APPEND _on1x_novostone_components ActionSemantics)
endif()
if(NOT TARGET Novostone::Datalog AND NOT TARGET Novostone::CCDB AND NOT TARGET Novostone::PCC)
  if(ON1X_NOVOSTONE_PROVIDER STREQUAL "PACKAGE")
    find_package(Novostone CONFIG REQUIRED)
  else()
    if(NOT EXISTS "${ON1X_LIBSTONE_ROOT}/novostone/CMakeLists.txt")
      message(FATAL_ERROR "ON1X_WITH_NOVOSTONE needs Novostone at ON1X_LIBSTONE_ROOT (or select PACKAGE)")
    endif()
    function(on1x_add_novostone)
      set(NOVOSTONE_BUILD_TESTS OFF)
      set(NOVOSTONE_BUILD_TOOLS OFF)
      add_subdirectory("${ON1X_LIBSTONE_ROOT}/novostone" "${CMAKE_CURRENT_BINARY_DIR}/libstone-novostone" EXCLUDE_FROM_ALL)
    endfunction()
    on1x_add_novostone()
  endif()
endif()
foreach(_component IN LISTS _on1x_novostone_components)
  if(NOT TARGET Novostone::${_component})
    message(FATAL_ERROR "ON1X_WITH_NOVOSTONE requires Novostone::${_component}; use the project-pinned LibStone checkout or an equivalent package")
  endif()
endforeach()
target_sources(on1x_hir_adapters INTERFACE "${CMAKE_CURRENT_SOURCE_DIR}/hir/novostone.cpp")
target_link_libraries(on1x_hir_adapters INTERFACE
  Novostone::PCC Novostone::SpeculativeIR Novostone::CostCC)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS src/backend/Analysis.dl)
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/src/backend/Analysis.dl" ON1X_MIR_ANALYSIS_HEX HEX)
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "\\\\x\\1" ON1X_MIR_ANALYSIS "${ON1X_MIR_ANALYSIS_HEX}")
configure_file(cmake/mir_analysis.hpp.in "${CMAKE_CURRENT_BINARY_DIR}/mir_analysis.hpp" @ONLY)
file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/src/backend/Analysis.dl" ON1X_MIR_ANALYSIS_SHA256)
file(APPEND "${CMAKE_CURRENT_BINARY_DIR}/on1x-build-info.txt"
  "novostone_provider=${ON1X_NOVOSTONE_PROVIDER}\nnovostone_package=${Novostone_DIR}\nnovostone_package_version=${Novostone_VERSION}\nmir_analysis_rules_sha256=${ON1X_MIR_ANALYSIS_SHA256}\n")
add_library(on1x_novostone STATIC src/backend/relational.cpp)
target_include_directories(on1x_novostone PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
target_link_libraries(on1x_novostone PUBLIC on1x_frontend Novostone::Datalog Novostone::CCDB)
target_link_libraries(on1xc PRIVATE on1x_novostone)
target_compile_definitions(on1xc PRIVATE ON1X_WITH_NOVOSTONE=1)
