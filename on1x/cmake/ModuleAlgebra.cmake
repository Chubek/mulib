set(_dsl "${ON1X_LIBSTONE_ROOT}/firestone/libdsl/LibDSL.hpp")
if(NOT EXISTS "${_dsl}")
  message(FATAL_ERROR "Module semantics requires ON1X_LIBSTONE_ROOT at 4607ce58ea70482a9c057c64557260329d36afde")
endif()
set(_oml "${CMAKE_CURRENT_SOURCE_DIR}/src/logistics/module-language.oml")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_dsl}" "${_oml}")
file(SHA256 "${_dsl}" _dsl_digest)
if(NOT _dsl_digest STREQUAL "8cafa81d9a2177afe27d95769e234dc668fe2d7e83c1be3544b59f9abea910e2")
  message(FATAL_ERROR "Incompatible LibDSL.hpp (expected pinned LibStone header)")
endif()
file(READ "${_oml}" OML_TEXT)
file(SHA256 "${_oml}" OML_DIGEST)
if(NOT OML_DIGEST STREQUAL "92457cf18bdaa4fef2c713615bbfe526e55f0152b51ee6cdba346724d89165b4")
  message(FATAL_ERROR "Unpinned OML policy: review the rule and update its pinned digest together")
endif()
configure_file(cmake/module_rules.hpp.in module_rules.hpp @ONLY)
add_library(on1x_module_algebra STATIC src/module_algebra.cpp)
target_include_directories(on1x_module_algebra PUBLIC include PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
target_include_directories(on1x_module_algebra SYSTEM PRIVATE "${ON1X_LIBSTONE_ROOT}/firestone/libdsl")
install(TARGETS on1x_module_algebra ARCHIVE DESTINATION lib)
install(FILES include/on1x/module_algebra.hpp include/on1x/module_visibility.hpp DESTINATION include/on1x)
install(FILES "${_oml}" DESTINATION share/on1x/logistics)
if(BUILD_TESTING)
  add_executable(on1x_module_algebra_tests tests/test_module_algebra.cpp)
  target_link_libraries(on1x_module_algebra_tests PRIVATE on1x_module_algebra)
  add_test(NAME on1x.module_algebra COMMAND on1x_module_algebra_tests)
  if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/tests/test_transparent_permit.cpp")
    add_executable(on1x_transparent_permit_tests tests/test_transparent_permit.cpp src/type.cpp src/module_signature.cpp)
    target_include_directories(on1x_transparent_permit_tests PRIVATE include)
    add_test(NAME on1x.transparent_permit COMMAND on1x_transparent_permit_tests)
  endif()
  if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/tests/test_module_graph.cpp")
    add_executable(on1x_module_graph_tests tests/test_module_graph.cpp)
    target_include_directories(on1x_module_graph_tests PRIVATE include)
    add_test(NAME on1x.module_graph COMMAND on1x_module_graph_tests)
  endif()
endif()
