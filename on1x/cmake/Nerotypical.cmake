# Mode B is not exported by Nerotypical's standalone Sequent target.
# Its public headers depend on Satie's compiled allocator support.
set(_nt "${ON1X_LIBSTONE_ROOT}/moonstone/nerotypical/include")
set(ON1X_SATIE_ROOT "${ON1X_LIBSTONE_ROOT}/third_party/satie" CACHE PATH "Satie SDK with public satie::euf target")
if(NOT EXISTS "${_nt}/nerotypical/StructuralTyping.hpp")
  message(FATAL_ERROR "ON1X_WITH_NEROTYPICAL requires Nerotypical at ON1X_LIBSTONE_ROOT")
endif()
function(on1x_add_satie)
  if(NOT EXISTS "${ON1X_SATIE_ROOT}/CMakeLists.txt")
    message(FATAL_ERROR "Missing Satie SDK: set ON1X_SATIE_ROOT")
  endif()
  file(READ "${ON1X_SATIE_ROOT}/CMakeLists.txt" _cmake)
  if(NOT _cmake MATCHES "SATIE_EUF_ONLY")
    message(FATAL_ERROR "This Satie checkout lacks the minimal public EUF target. Apply on1x/upstream/satie-euf-target.patch to a separate SDK copy using on1x/tools/prepare-type-sdk.py, then set ON1X_SATIE_ROOT. The pinned submodule is never modified.")
  endif()
  set(SATIE_EUF_ONLY ON)
  add_subdirectory("${ON1X_SATIE_ROOT}" "${CMAKE_CURRENT_BINARY_DIR}/libstone-satie-euf" EXCLUDE_FROM_ALL)
endfunction()
if(NOT TARGET satie::euf)
  on1x_add_satie()
endif()
add_library(on1x_type_safety STATIC src/type_safety.cpp)
target_include_directories(on1x_type_safety PUBLIC include)
target_include_directories(on1x_type_safety SYSTEM PRIVATE "${_nt}")
target_link_libraries(on1x_type_safety PUBLIC on1x_frontend PRIVATE satie::euf)
target_link_libraries(on1xc PRIVATE on1x_type_safety)
target_compile_definitions(on1xc PRIVATE ON1X_WITH_NEROTYPICAL=1)
file(SHA256 "${_nt}/nerotypical/StructuralTyping.hpp" _nt_hash)
file(SHA256 "${ON1X_SATIE_ROOT}/CMakeLists.txt" _satie_cmake_hash)
file(SHA256 "${ON1X_SATIE_ROOT}/include/SatieEUF.hpp" _satie_hash)
file(APPEND "${CMAKE_CURRENT_BINARY_DIR}/on1x-build-info.txt"
  "satie_root=${ON1X_SATIE_ROOT}\nstructural_typing_sha256=${_nt_hash}\nsatie_cmake_sha256=${_satie_cmake_hash}\nsatie_euf_sha256=${_satie_hash}\n")
