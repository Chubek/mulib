# Native On1x implementation of @pipe("apply", expression, function_name, ...).
# Built by CMake; compiler execution and Python parity are tested by CTest.
import "../../stdlib/ppx/ppx.on1x";
fn pipe_node(node: sexpr, label: string) -> sexpr
{
  if visitor_tag(node) != "ExtensionExpr" || sx_text(sexpr_nth(node,
    1)) != label
  {
    return node;
  }
  let op = sx_text(sexpr_nth(node, 2));
  let args = sexpr_nth(node, 3);
  let at = sexpr_nth(node, 4);
  if op != "apply" || sexpr_size(args) < 2
  {
    tool_fail("pipe: expected apply(value, function_name, ...)");
  }
  var result = sx_head(args);
  var rest = sx_tail(args);
  while sx_kind(rest) == 3
  {
    let callee = sx_head(rest);
    if visitor_tag(callee) != "Identifier"
    {
      tool_fail("pipe: functions must be identifiers");
    }
    result = ppx_node("Call", ppx_list3(callee, ppx_list1(result), at));
    rest = sx_tail(rest);
  }
  return result;
}
fn transform(tree: sexpr, label: string) -> sexpr
{
  return visitor_rewrite(tree, fn(node: sexpr, path: sexpr) -> sexpr
  {
    return pipe_node(node, label);
  });
}
fn main()
{
  ppx_serve(ppx_schema_env(), transform);
}
