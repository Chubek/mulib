import "../../stdlib/ppx/category/witness.on1x";
import "../../stdlib/ppx/category/typed.on1x";
fn transform(packet: sexpr, label: string) -> sexpr {
  if label!="Protocols" { tool_fail("ON1X-CAT-PPX: wrong feature owner"); }
  return ppx_category_expand(packet);
}
fn evidence(packet: sexpr, label: string) -> sexpr {
  if label!="Protocols" { tool_fail("ON1X-CAT-PPX: wrong feature owner"); }
  return ppx_category_make_evidence_plan(packet);
}
fn main() {
  let phase=tool_env("ON1X_EXTENSION_PHASE");
  if phase=="evidence-v1" { ppx_serve_as(ppx_schema_env(),"EvidenceInput","EvidenceOutput",evidence); }else {
    if phase!=""&&phase!="syntax-v1" { tool_fail("ON1X-CAT-PPX: unsupported extension phase"); }
    ppx_serve_as(ppx_schema_env(),"ExtensionInput","ExtensionOutput",transform);
  }
}
