import "../../stdlib/ppx/numbers.on1x";
fn unroll_node(node: sexpr, label: string) -> sexpr {
  if visitor_tag(node) != "Do" { return node; } let expression = sexpr_nth(node, 1);
  if visitor_tag(expression) != "ExtensionExpr" || sx_text(sexpr_nth(expression, 1)) != label { return node; }
  let args = sexpr_nth(expression, 3); let location = sexpr_nth(expression, 4);
  if sx_text(sexpr_nth(expression, 2)) != "repeat" || sexpr_size(args) != 2 || visitor_tag(sexpr_nth(args, 1)) != "Block" { tool_fail("unroll: expected repeat(IntegerLiteral, Block)"); }
  let (valid, count) = ppx_literal_i64(sx_head(args));
  if !valid || count < 0 || count > 256 { tool_fail("unroll: count must be 0..256"); }
  var body = sx_nil(); var i = 0;
  while i < count { body = sx_cons(ppx_node("Scope", ppx_list2(sexpr_nth(args, 1), location)), body); i = i + 1; }
  return ppx_node("Scope", ppx_list2(ppx_node("Block", ppx_list2(body, location)), location));
}
fn transform(tree: sexpr, label: string) -> sexpr {
  return visitor_rewrite(tree, fn(node: sexpr, path: sexpr) -> sexpr { return unroll_node(node, label); });
}
fn main() { ppx_serve(ppx_schema_env(), transform); }
