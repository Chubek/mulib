# Include after On1x::RT exists. No compiler extension or private ABI dependency.
option(ON1X_RT_BUILD_TRUSTED_DYNAMIC
       "Build the trusted Linux/glibc On1xRT native loader" ON)
if(NOT ON1X_RT_BUILD_TRUSTED_DYNAMIC OR NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
    return()
endif()

include(CheckSymbolExists)
include(CMakePushCheckState)
cmake_push_check_state(RESET)
set(CMAKE_REQUIRED_DEFINITIONS -D_GNU_SOURCE)
set(CMAKE_REQUIRED_LIBRARIES "${CMAKE_DL_LIBS}")
check_symbol_exists(memfd_create "sys/mman.h" ON1X_RT_HAVE_MEMFD_CREATE)
check_symbol_exists(dladdr1 "dlfcn.h" ON1X_RT_HAVE_DLADDR1)
cmake_pop_check_state()
if(NOT ON1X_RT_HAVE_MEMFD_CREATE OR NOT ON1X_RT_HAVE_DLADDR1)
    return()
endif()

get_filename_component(_on1x_rt_dir "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
target_sources(on1x_rt_sdk PRIVATE "${_on1x_rt_dir}/src/On1xRT-Dynamic.c")
target_include_directories(on1x_rt_sdk PRIVATE "${_on1x_rt_dir}/../../kernels")
target_compile_definitions(on1x_rt_sdk PRIVATE ON1X_RT_ENABLE_DYNAMIC=1)
if(CMAKE_DL_LIBS)
    target_link_libraries(on1x_rt_sdk PRIVATE ${CMAKE_DL_LIBS})
endif()

if(BUILD_TESTING AND NOT CMAKE_CROSSCOMPILING)
    set(_on1x_rt_dynamic_fixtures)
    set(_on1x_rt_dynamic_files)
    foreach(_kind RANGE 1 8)
        set(_target on1x_rt_dynamic_kind_${_kind})
        add_library(${_target} SHARED "${_on1x_rt_dir}/tests/dynamic_module.c")
        target_compile_features(${_target} PRIVATE c_std_11)
        target_include_directories(${_target} PRIVATE "${_on1x_rt_dir}/include")
        target_compile_definitions(${_target} PRIVATE TEST_DYNAMIC_KIND=${_kind})
        if(CMAKE_C_COMPILER_ID MATCHES "GNU|Clang")
            target_compile_options(${_target} PRIVATE -Wall -Wextra -Wpedantic -Werror)
        endif()
        list(APPEND _on1x_rt_dynamic_fixtures ${_target})
        list(APPEND _on1x_rt_dynamic_files "-Dfile_${_kind}=$<TARGET_FILE:${_target}>")
    endforeach()
    target_link_options(on1x_rt_dynamic_kind_6 PRIVATE "LINKER:-z,nodelete")
    target_link_libraries(on1x_rt_dynamic_kind_8 PRIVATE on1x_rt_dynamic_kind_1)
    add_executable(on1x_rt_test_dynamic "${_on1x_rt_dir}/tests/dynamic.c")
    set_target_properties(on1x_rt_test_dynamic PROPERTIES ENABLE_EXPORTS ON)
    if(CMAKE_C_COMPILER_ID MATCHES "GNU|Clang")
        target_compile_options(on1x_rt_test_dynamic PRIVATE -Wall -Wextra -Wpedantic -Werror)
    endif()
    target_link_libraries(on1x_rt_test_dynamic PRIVATE On1x::RT)
    add_dependencies(on1x_rt_test_dynamic ${_on1x_rt_dynamic_fixtures})
    add_test(NAME on1x.runtime.trusted_dynamic
        COMMAND ${CMAKE_COMMAND}
            "-Dhost=$<TARGET_FILE:on1x_rt_test_dynamic>"
            "-Dfixture_dir=$<TARGET_FILE_DIR:on1x_rt_dynamic_kind_1>"
            ${_on1x_rt_dynamic_files}
            -P "${_on1x_rt_dir}/tests/run_dynamic.cmake")
    set_tests_properties(on1x.runtime.trusted_dynamic PROPERTIES TIMEOUT 30)
endif()
