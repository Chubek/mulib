import "../ppx/ppx.on1x";
# The host supplies both values from the validated selected catalog. This
# library contains transport mechanics only and grants no registration.
fn basis_diagnostics_ppx_failure() -> string
{
  let message = tool_env("ON1X_PPX_DIAGNOSTIC_FAILURE");
  if text_len(message) < 1 || text_len(message) > 4096
  {
    tool_fail(message);
  }
  return message;
}
fn basis_diagnostics_ppx_declaration() -> string
{
  let id = tool_env("ON1X_PPX_DIAGNOSTIC_ID");
  if text_len(id) < 1 || text_len(id) > 128
  {
    tool_fail(basis_diagnostics_ppx_failure());
  }
  return id;
}
fn basis_diagnostics_record(id: string, location: sexpr) -> sexpr
{
  if text_len(id) < 1 || text_len(id) > 128
  {
    tool_fail(basis_diagnostics_ppx_failure());
  }
  return ppx_node("diagnostic", ppx_list2(sx_string(id), location));
}
fn basis_diagnostics_id(record: sexpr) -> string
{
  if sx_kind(record) != 3 || sx_text(sx_head(record)) != "diagnostic" || sexpr_size(record) != 3
  {
    tool_fail(basis_diagnostics_ppx_failure());
  }
  return sx_text(sexpr_nth(record, 1));
}
