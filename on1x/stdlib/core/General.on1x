# General: portable part of the SML Basis General structure.
# On1x has no general exception or reference datatype yet.
fn basis_general_id_int(x: i64) -> i64
{
  return x;
}

fn basis_general_id_bool(x: bool) -> bool
{
  return x;
}

fn basis_general_id_text(x: string) -> string
{
  return x;
}

fn basis_general_before_int(a: i64, b: i64) -> i64
{
  return a;
}

fn basis_general_after_int(a: i64, b: i64) -> i64
{
  return b;
}

fn basis_general_ignore_int(x: i64)
{
}

fn basis_general_min(a: i64, b: i64) -> i64
{
  if a < b
  {
    return a;
  }
  return b;
}

fn basis_general_max(a: i64, b: i64) -> i64
{
  if a > b
  {
    return a;
  }
  return b;
}
