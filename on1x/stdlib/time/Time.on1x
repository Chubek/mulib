extern fn basis_native_time_unix_seconds() -> i64;
extern fn basis_native_time_monotonic_ns() -> i64;
fn basis_time_now_seconds() -> i64
{
  return basis_native_time_unix_seconds();
}
fn basis_time_monotonic_ns() -> i64
{
  return basis_native_time_monotonic_ns();
}
fn basis_time_from_seconds(x: i64) -> i64
{
  return x;
}
fn basis_time_to_seconds(x: i64) -> i64
{
  return x;
}
fn basis_time_compare(a: i64, b: i64) -> i64
{
  if a < b
  {
    return - 1;
  }
  if a > b
  {
    return 1;
  }
  return 0;
}
