# Persistent symbol interning; each entry is a canonical sx_string node.
# Pool is explicit to avoid hidden global state. Does not use pointer equality.
fn hashcons_empty() -> sexpr { return sx_nil(); }
fn hashcons_lookup(pool: sexpr, text: string) -> (bool,sexpr) {
 var rest = pool; var count = 0;
 while sx_kind(rest) == 3 {
  let atom = sx_head(rest); if sx_kind(atom) == 2 && sx_text(atom) == text { return (true,atom); }
  rest = sx_tail(rest); count = count + 1;
  if count > 262144 { tool_fail("hashcons pool exceeds bound"); }
 }
 return (false,sx_nil());
}
fn hashcons_intern(pool: sexpr, text: string) -> (sexpr,sexpr) {
 let (found,atom) = hashcons_lookup(pool,text);
 if found { return (pool,atom); }
 let fresh = sx_string(text); return (sx_cons(fresh,pool),fresh);
}
