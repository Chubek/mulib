# Raw, exact scalar ABI for the generated immutable MuLIB housekeeping tables.
extern fn on1x_mulib_abi_version() -> i64;
extern fn on1x_mulib_pointer_bits() -> i64;
extern fn on1x_mulib_max_size() -> i64;
extern fn on1x_mulib_kernel_count() -> i64;
extern fn on1x_mulib_kernel_name(index: i64) -> string;
extern fn on1x_mulib_has_kernel(name: string) -> bool;
extern fn on1x_mulib_kernel_header(name: string) -> string;
extern fn on1x_mulib_kernel_sha256(name: string) -> string;
extern fn on1x_mulib_fixture_count() -> i64;
extern fn on1x_mulib_fixture_name(index: i64) -> string;
extern fn on1x_mulib_has_fixture(name: string) -> bool;
extern fn on1x_mulib_fixture_is_text(name: string) -> bool;
extern fn on1x_mulib_fixture_text(name: string) -> string;
extern fn on1x_mulib_fixture_group(name: string) -> string;
extern fn on1x_mulib_fixture_sha256(name: string) -> string;
extern fn on1x_mulib_fixture_size(name: string) -> i64;
extern fn on1x_mulib_fixture_byte(name: string, index: i64) -> i64;
fn fits_size(value: i64) -> bool
{
  return value >= 0 && value <= on1x_mulib_max_size();
}

fn fits_array(count: i64, element_bytes: i64) -> bool
{
  if ! fits_size(count) || ! fits_size(element_bytes)
  {
    return false;
  }
  if element_bytes == 0
  {
    return true;
  }
  return count <= on1x_mulib_max_size() / element_bytes;
}

fn fixture_text(name: string) ->(bool, string)
{
  return (on1x_mulib_fixture_is_text(name), on1x_mulib_fixture_text(name));
}

fn require_fixture(name: string) -> string
{
  if ! on1x_mulib_fixture_is_text(name)
  {
    tool_fail("MuLIB fixture is missing or contains NUL");
  }
  return on1x_mulib_fixture_text(name);
}
