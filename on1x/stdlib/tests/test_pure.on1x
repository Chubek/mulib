import "../base/string.on1x";
import "../base/ordering.on1x";
import "../graph/graph.on1x";
import "../graph/traversal.on1x";
import "../batteries/base64.on1x";
fn main()
{
  assert(base_string_starts_with("hello", "hell"));
  assert(base_string_ends_with("hello", "lo"));
  assert(base_compare_i64(2, 4) == - 1);
  let edges = graph_add(graph_add(graph_empty(), "a", "b"), "b", "c");
  assert(graph_has(edges, "a", "b"));
  assert(graph_out_degree(edges, "b") == 1);
  assert(batteries_base64_encode("Man") == "TWFu");
  assert(sx_kind(graph_bfs(edges, "a")) == 3);
  println("OK");
}
