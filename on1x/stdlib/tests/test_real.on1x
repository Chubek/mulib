import "../numeric/Real.on1x";
import "../numeric/Math.on1x";
import "../numeric/IEEEReal.on1x";
fn main()
{
  assert(basis_real_compare(basis_real_add("0.5", "0.5"), "1") == 0);
  assert(basis_real_compare(basis_math_sqrt("9"), "3") == 0);
  assert(basis_ieee_is_finite("3.14159"));
  println("basis real bridge OK");
}
