import "../sexpr/sexpr.on1x";
import "../ppx/json.on1x";

# Cephyr documents use JSON-escaped strings (including raw UTF-8), not the
# PPX S-expression reader's ASCII wire strings with \xNN escapes.
fn basis_cephyr_decode_value(text: string, start: i64, depth: i64, count: i64) -> (sexpr, i64, i64)
{
  var pos = sexpr_skip(text, start);
  if depth >= 256 || count >= 262144
  {
    sexpr_error(pos, "Cephyr document tree limit exceeded");
  }
  let size = text_len(text);
  if pos == size
  {
    sexpr_error(pos, "unexpected end of Cephyr document");
  }
  let byte = text_byte(text, pos);
  var nodes = count + 1;
  if byte == 40
  {
    pos = pos + 1;
    var children = sx_nil();
    loop
    {
      pos = sexpr_skip(text, pos);
      if pos == size
      {
        sexpr_error(pos, "unterminated Cephyr document list");
      }
      if text_byte(text, pos) == 41
      {
        return (sexpr_reverse(children), pos + 1, nodes);
      }
      let (child, end, used) = basis_cephyr_decode_value(text, pos, depth + 1, nodes);
      children = sx_cons(child, children);
      pos = end;
      nodes = used;
    }
  }
  if byte == 34
  {
    let (quoted, end) = ppx_json_quoted(text, pos);
    return (sx_string(quoted), end, nodes);
  }

  # Unquoted symbols share PPX's reader and bounds. The list reader checks
  # closing parentheses before recursing, so an unmatched ')' is an error.
  return sexpr_read(text, pos, depth, count);
}

fn basis_cephyr_decode_document(text: string) -> sexpr
{
  let (tree, end, _) = basis_cephyr_decode_value(text, 0, 0, 0);
  if sx_kind(tree) != 3 || sexpr_skip(text, end) != text_len(text)
  {
    sexpr_error(end, "expected one nonempty Cephyr document list");
  }
  return tree;
}
