from ._Trusted import basis_sdk_bridge_negotiate,
  basis_sdk_bridge_lifecycle,
  basis_sdk_bridge_require_active,
  basis_sdk_bridge_cancel_check,
  basis_sdk_bridge_work_consume;

enum SDKLifecycleEvent
{
  Initialize, Shutdown
}

fn basis_sdk_lifecycle_negotiate(context: u64) -> u32
{
  if context == 0u64 { return 4u32; }
  return basis_sdk_bridge_negotiate(context, 2u32, 1u32, 16u32);
}

fn basis_sdk_lifecycle_event(context: u64, event: SDKLifecycleEvent) -> u32
{
  let code = match event with
  {
    Initialize() => 1u32,
    Shutdown() => 2u32
  };
  return basis_sdk_bridge_lifecycle(context, code);
}

fn basis_sdk_lifecycle_require_active(context: u64) -> u32
{
  return basis_sdk_bridge_require_active(context);
}

fn basis_sdk_cancellation_poll(context: u64) -> u32
{
  return basis_sdk_bridge_cancel_check(context);
}

fn basis_sdk_budget_consume(context: u64, units: u32) -> u32
{
  if units == 0u32 { return 4u32; }
  return basis_sdk_bridge_work_consume(context, units);
}
