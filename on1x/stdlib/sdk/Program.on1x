from ._Trusted import basis_sdk_bridge_snapshot_open,
  basis_sdk_bridge_snapshot_check,
  basis_sdk_bridge_snapshot_close,
  basis_sdk_bridge_snapshot_revision,
  basis_sdk_bridge_snapshot_length,
  basis_sdk_bridge_snapshot_schema;

record SDKProgramSnapshot
{
  context: u64,
  handle: u64,
  revision: u64,
  schema: u32,
  length: u64,
  limit: u64
}

enum SDKProgramResult
{
  Snapshot(SDKProgramSnapshot), Failure(u32)
}

fn basis_sdk_program_open(context: u64, schema: u32,
  maximum_bytes: u64) -> SDKProgramResult
{
  if context == 0u64 || schema == 0u32 ||
    maximum_bytes == 0u64 || maximum_bytes > 4096u64
  {
    return variant < SDKProgramResult > (Failure, 4u32);
  }
  let result = basis_sdk_bridge_snapshot_open(context, schema, maximum_bytes);
  if result < 4294967296u64
  {
    return variant < SDKProgramResult > (Failure, u32_from_u64(result));
  }
  let checked = basis_sdk_bridge_snapshot_check(context, result);
  if checked != 0u32
  {
    return variant < SDKProgramResult > (Failure, checked);
  }
  let revision = basis_sdk_bridge_snapshot_revision(context, result);
  let length = basis_sdk_bridge_snapshot_length(context, result);
  let actual_schema = basis_sdk_bridge_snapshot_schema(context, result);
  if revision == 0u64 || actual_schema != schema || length > maximum_bytes
  {
    let ignored = basis_sdk_bridge_snapshot_close(context, result);
    if ignored != 0u32
    {
      return variant < SDKProgramResult > (Failure, ignored);
    }
    return variant < SDKProgramResult > (Failure, 14u32);
  }
  return variant < SDKProgramResult > (Snapshot,
    record < SDKProgramSnapshot >
    {
      context: context,
      handle: result,
      revision: revision,
      schema: actual_schema,
      length: length,
      limit: maximum_bytes
    });
}

fn basis_sdk_program_check(snapshot: SDKProgramSnapshot) -> u32
{
  if snapshot["context"] == 0u64 ||
    snapshot["handle"] == 0u64 ||
    snapshot["revision"] == 0u64 ||
    snapshot["schema"] == 0u32 ||
    snapshot["length"] > snapshot["limit"]
  {
    return 4u32;
  }
  return basis_sdk_bridge_snapshot_check(
    snapshot["context"], snapshot["handle"]);
}

fn basis_sdk_program_close(snapshot: SDKProgramSnapshot) -> u32
{
  return basis_sdk_bridge_snapshot_close(
    snapshot["context"], snapshot["handle"]);
}
