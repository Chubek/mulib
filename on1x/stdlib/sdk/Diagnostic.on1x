from ._Trusted import basis_sdk_bridge_diagnostic_emit;
record SDKSourceSpan
{
  revision: u64, start: u64, end: u64
}

record SDKDiagnostic
{
  machine_code: u32, severity: u32, message: u32, message_length: u32, primary: SDKSourceSpan, related_count: u32, related: SDKSourceSpan
}

fn basis_sdk_span_well_formed(span: SDKSourceSpan, source_length: u64) -> bool
{
  return span["revision"] != 0u64 && span["start"] <= span["end"] && span["end"] <= source_length;
}

fn basis_sdk_diagnostic_well_formed(diagnostic: SDKDiagnostic,
  source_length: u64) -> bool
{
  if diagnostic["machine_code"] == 0u32 || diagnostic["severity"] < 1u32 || diagnostic["severity"] > 3u32 || diagnostic["message"] == 0u32 || diagnostic["message_length"] > 256u32 || diagnostic["related_count"] > 1u32 || ! basis_sdk_span_well_formed(diagnostic["primary"],
    source_length)
  {
    return false;
  }
  if diagnostic["related_count"] == 1u32
  {
    return basis_sdk_span_well_formed(diagnostic["related"],
      source_length) && diagnostic["related"]["revision"] == diagnostic["primary"]["revision"];
  }
  return true;
}

fn basis_sdk_diagnostic_emit(context: u64,
  snapshot: u64,
  source_length: u64,
  diagnostic: SDKDiagnostic) -> u32
{
  if ! basis_sdk_diagnostic_well_formed(diagnostic, source_length)
  {
    return 4u32;
  }
  return basis_sdk_bridge_diagnostic_emit(context,
    snapshot,
    diagnostic["primary"]["revision"],
    diagnostic["machine_code"],
    diagnostic["severity"],
    diagnostic["message"],
    diagnostic["message_length"],
    diagnostic["primary"]["start"],
    diagnostic["primary"]["end"],
    diagnostic["related_count"],
    diagnostic["related"]["start"],
    diagnostic["related"]["end"]);
}
