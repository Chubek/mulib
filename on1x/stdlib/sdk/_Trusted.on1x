  message_length: u32, span_start: u64, span_end: u64,
  related_count: u32, related_start: u64, related_end: u64) -> u32;

extern fn basis_sdk_bridge_candidate_open(context: u64, candidate_schema: u32,
  source_revision: u64, maximum_bytes: u32) -> u64;
extern fn basis_sdk_bridge_candidate_append(context: u64, candidate: u64,
  value: u8) -> u32;
extern fn basis_sdk_bridge_candidate_commit(context: u64, candidate: u64,
  candidate_schema: u32, source_revision: u64) -> u32;
