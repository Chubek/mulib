from ._Trusted import basis_sdk_bridge_capability_check;

enum SDKCapability
{
  DiagnosticEmit, CandidateSubmit
}

fn basis_sdk_capability_id(capability: SDKCapability) -> u32
{
  return match capability with
  {
    DiagnosticEmit() => 1u32,
    CandidateSubmit() => 2u32
  };
}

fn basis_sdk_capability_check(context: u64,
  capability: SDKCapability) -> u32
{
  if context == 0u64 { return 4u32; }
  return basis_sdk_bridge_capability_check(
    context, basis_sdk_capability_id(capability));
}
