# Mathematical functions over host double encoded as decimal strings.
# Not the full SML Math interface. Throws tool error on non-finite result.
extern fn basis_native_math_sqrt(x: string) -> string;
extern fn basis_native_math_exp(x: string) -> string;
extern fn basis_native_math_log(x: string) -> string;
extern fn basis_native_math_sin(x: string) -> string;
extern fn basis_native_math_cos(x: string) -> string;
extern fn basis_native_math_pow(x: string, y: string) -> string;
fn basis_math_sqrt(x: string) -> string
{
  return basis_native_math_sqrt(x);
}
fn basis_math_exp(x: string) -> string
{
  return basis_native_math_exp(x);
}
fn basis_math_log(x: string) -> string
{
  return basis_native_math_log(x);
}
fn basis_math_sin(x: string) -> string
{
  return basis_native_math_sin(x);
}
fn basis_math_cos(x: string) -> string
{
  return basis_native_math_cos(x);
}
fn basis_math_pow(x: string, y: string) -> string
{
  return basis_native_math_pow(x, y);
}
