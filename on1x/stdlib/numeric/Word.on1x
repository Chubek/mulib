import "Word8.on1x";
# Generic machine Word cannot be emulated exactly without unsigned i64.
# Only unsigned byte-range portable operations are exported here.
fn basis_word_from_byte(x: i64) -> i64 {
  if !basis_word8_check(x) { tool_fail("word byte out of range"); } return x;
}
fn basis_word_to_byte(x: i64) -> i64 { return basis_word8_wrap(x); }
