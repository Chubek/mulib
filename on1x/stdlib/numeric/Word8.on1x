# Word8 arithmetic with explicit modulo 256, no native bitwise operators.
fn basis_word8_check(x: i64) -> bool { return x >= 0 && x <= 255; }
fn basis_word8_wrap(x: i64) -> i64 { let r = x % 256; if r < 0 { return r + 256; } return r; }
fn basis_word8_add(a: i64,b: i64) -> i64 {
  if !basis_word8_check(a) || !basis_word8_check(b) { tool_fail("word8 out of range"); }
  return (a + b) % 256;
}
fn basis_word8_sub(a: i64,b: i64) -> i64 {
  if !basis_word8_check(a) || !basis_word8_check(b) { tool_fail("word8 out of range"); }
  return basis_word8_wrap(a - b);
}
fn basis_word8_mul(a: i64,b: i64) -> i64 {
  if !basis_word8_check(a) || !basis_word8_check(b) { tool_fail("word8 out of range"); }
  return (a * b) % 256;
}
fn basis_word8_and(a: i64,b: i64) -> i64 {
  if !basis_word8_check(a) || !basis_word8_check(b) { tool_fail("word8 out of range"); }
  var x=a; var y=b; var weight=1; var result=0;
  while weight < 256 {
    if x % 2 == 1 && y % 2 == 1 { result = result + weight; }
    x=x/2; y=y/2; weight=weight*2;
  }
  return result;
}
fn basis_word8_or(a: i64,b: i64) -> i64 {
  if !basis_word8_check(a) || !basis_word8_check(b) { tool_fail("word8 out of range"); }
  var x=a; var y=b; var weight=1; var result=0;
  while weight < 256 {
    if x % 2 == 1 || y % 2 == 1 { result = result + weight; }
    x=x/2; y=y/2; weight=weight*2;
  }
  return result;
}
fn basis_word8_xor(a: i64,b: i64) -> i64 {
  let common = basis_word8_and(a,b);
  return basis_word8_or(a,b) - common;
}
fn basis_word8_not(a: i64) -> i64 {
  if !basis_word8_check(a) { tool_fail("word8 out of range"); }
  return 255 - a;
}
fn basis_word8_shift_left(a: i64,n: i64) -> i64 {
  if !basis_word8_check(a) || n < 0 { tool_fail("word8 shift invalid"); }
  if n >= 8 { return 0; }
  var x = a; var i = 0;
  while i < n { x=(x*2)%256; i=i+1; } return x;
}
fn basis_word8_shift_right(a: i64,n: i64) -> i64 {
  if !basis_word8_check(a) || n < 0 { tool_fail("word8 shift invalid"); }
  if n >= 8 { return 0; }
  var x=a; var i=0;
  while i<n { x=x/2; i=i+1; } return x;
}
