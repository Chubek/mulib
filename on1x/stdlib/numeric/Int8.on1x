# Fixed-width 8-bit INTEGER range adapter, not a distinct On1x type.
fn basis_int8_max() -> i64
{
  return 127;
}
fn basis_int8_min() -> i64
{
  return - 127 - 1;
}
fn basis_int8_in_range(x: i64) -> bool
{
  return x >= basis_int8_min() && x <= basis_int8_max();
}
fn basis_int8_checked(x: i64) -> i64
{
  if ! basis_int8_in_range(x)
  {
    tool_fail("int8 range error");
  }
  return x;
}
