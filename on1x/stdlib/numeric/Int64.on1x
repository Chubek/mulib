# Fixed-width 64-bit INTEGER range adapter, not a distinct On1x type.
fn basis_int64_max() -> i64
{
  return 9223372036854775807;
}

fn basis_int64_min() -> i64
{
  return - 9223372036854775807 - 1;
}

fn basis_int64_in_range(x: i64) -> bool
{
  return x >= basis_int64_min() && x <= basis_int64_max();
}

fn basis_int64_checked(x: i64) -> i64
{
  if ! basis_int64_in_range(x)
  {
    tool_fail("int64 range error");
  }
  return x;
}
