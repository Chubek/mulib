# Int functions on On1x i64. Division/modulo implement SML floor convention.
fn basis_int_min() -> i64
{
  return - 9223372036854775807 - 1;
}
fn basis_int_max() -> i64
{
  return 9223372036854775807;
}
fn basis_int_compare(a: i64, b: i64) -> i64
{
  if a < b
  {
    return - 1;
  }
  if a > b
  {
    return 1;
  }
  return 0;
}
fn basis_int_min2(a: i64, b: i64) -> i64
{
  if a < b
  {
    return a;
  }
  return b;
}
fn basis_int_max2(a: i64, b: i64) -> i64
{
  if a > b
  {
    return a;
  }
  return b;
}
fn basis_int_sign(x: i64) -> i64
{
  if x < 0
  {
    return - 1;
  }
  if x > 0
  {
    return 1;
  }
  return 0;
}
fn basis_int_same_sign(a: i64, b: i64) -> bool
{
  return basis_int_sign(a) == basis_int_sign(b);
}
fn basis_int_quot(a: i64, b: i64) -> i64
{
  return a / b;
}
fn basis_int_rem(a: i64, b: i64) -> i64
{
  if b == - 1
  {
    return 0;
  }
  return a % b;
}
fn basis_int_div(a: i64, b: i64) -> i64
{
  let q = a / b;
  let r = a % b;
  if r != 0 && ((a < 0 && b > 0) || (a > 0 && b < 0))
  {
    return q - 1;
  }
  return q;
}
fn basis_int_mod(a: i64, b: i64) -> i64
{
  let r = basis_int_rem(a, b);
  if r != 0 && ((r < 0 && b > 0) || (r > 0 && b < 0))
  {
    return r + b;
  }
  return r;
}
fn basis_int_abs(x: i64) -> i64
{
  if x < 0
  {
    return - x;
  }
  return x;
}
fn basis_int_divmod(a: i64, b: i64) ->(i64, i64)
{
  return (basis_int_div(a, b), basis_int_mod(a, b));
}
