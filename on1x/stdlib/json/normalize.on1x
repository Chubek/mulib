# Raw C11 bridge: linked against Exotract's single-implementation MuLIB archive.
import "../_bridge/status.on1x";
extern fn on1x_mulib_json_normalize(text: string) -> string;
extern fn on1x_mulib_json_is_valid(text: string) -> bool;
fn json_valid(text: string) -> bool
{
  return on1x_mulib_json_is_valid(text);
}

fn json_normalize(text: string) -> string
{
  return on1x_mulib_json_normalize(text);
}

fn basis_json_normalize(text: string) ->(i64, string)
{
  let value = on1x_mulib_json_normalize(text);
  return (on1x_mulib_bridge_status(), value);
}
