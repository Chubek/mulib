# Raw operation-local status; read before any other MuLIB bridge call.
extern fn on1x_mulib_bridge_status() -> i64;
fn basis_bridge_ok() -> i64
{
  return 0;
}
fn basis_bridge_missing() -> i64
{
  return 1;
}
fn basis_bridge_eof() -> i64
{
  return 2;
}
fn basis_bridge_again() -> i64
{
  return 3;
}
fn basis_bridge_invalid() -> i64
{
  return - 1;
}
fn basis_bridge_parse() -> i64
{
  return - 2;
}
fn basis_bridge_memory() -> i64
{
  return - 3;
}
fn basis_bridge_limit() -> i64
{
  return - 4;
}
fn basis_bridge_io() -> i64
{
  return - 5;
}
fn basis_bridge_binary() -> i64
{
  return - 6;
}
