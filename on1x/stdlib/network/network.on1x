import "../socket/socket.on1x";
# Transport-level convenience with partial-send handling.
fn network_send_all(handle: i64, payload: string) -> bool
{
  var offset = 0;
  let length = text_len(payload);
  var attempts = 0;
  while offset < length
  {
    let n = on1x_mulib_socket_send_from(handle, payload, offset);
    if n <= 0 || n > length - offset
    {
      return false;
    }
    offset = offset + n;
    attempts = attempts + 1;
    if attempts > 4096
    {
      return false;
    }
  }
  return true;
}
