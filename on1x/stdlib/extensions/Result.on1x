# Extra: Result-like tagged i64 success/error code pair.
fn basis_result_ok(value: i64) ->(bool, i64)
{
  return (true, value);
}
fn basis_result_err(code: i64) ->(bool, i64)
{
  return (false, code);
}
fn basis_result_is_ok(result: (bool, i64)) -> bool
{
  let(ok, value) = result;
  return ok;
}
fn basis_result_unwrap_or(result: (bool, i64), fallback: i64) -> i64
{
  let(ok, value) = result;
  if ok
  {
    return value;
  }
  return fallback;
}
