fn basis_function_compose_int(f:fn(i64)->i64,g:fn(i64)->i64,x:i64)->i64 { return f(g(x)); }
fn basis_function_pipe_int(x:i64,f:fn(i64)->i64)->i64 { return f(x); }
fn basis_function_apply_twice_int(x:i64,f:fn(i64)->i64)->i64 { return f(f(x)); }
fn basis_function_compose(f,g) -> _ { return fn(x) -> _ { return f(g(x)); }; }
fn basis_function_pipe(value,f) -> _ { return f(value); }
fn basis_function_flip(f) -> _ { return fn(a,b) -> _ { return f(b,a); }; }
fn basis_function_curry(f) -> _ { return fn(a) -> _ { return fn(b) -> _ { return f((a,b)); }; }; }
fn basis_function_uncurry(f) -> _ { return fn(pair) -> _ { let (a,b)=pair; return f(a)(b); }; }
