fn increment(value: i64) -> i64
{
  return value + 1;
}

fn positive(value: i64) -> bool
{
  return value > 0;
}

fn bool_number(value: bool) -> i64
{
  if value
  {
    return 42;
  }
  return -1;
}

fn checked_positive(value: i64) -> Result<bool, i64>
{
  if value >= 0
  {
    return result_ok(positive(value));
  }
  return result_error(-9);
}

fn checked_number(value: bool) -> Result<i64, i64>
{
  if value
  {
    return result_ok(bool_number(value));
  }
  return result_error(-2);
}

fn must_not_map(value: i64) -> bool
{
  assert(value >= 0);
  return positive(value);
}

fn must_not_chain(value: i64) -> Result<bool, i64>
{
  assert(value >= 0);
  return checked_positive(value);
}

fn main()
{
  assert((20 |> increment |> increment) == 22);
  assert((positive <| increment <| -1) == false);
  assert((2 + 3 |> positive >>. bool_number) == 42);
  assert((bool_number <<. positive)(0) == -1);
  assert((3 |> positive) && ((true |> bool_number) == 42));
  let apply = operator("|>");
  assert(apply(41, increment) == 42);

  let source: Result<i64, i64> = result_ok(6);
  let failure: Result<i64, i64> = result_error(-17);
  let mapped = positive <$> source;
  assert(match mapped with { Ok(flag) => flag, Err(_) => false });
  let flipped_map = source <&> positive;
  assert(match flipped_map with { Ok(flag) => flag, Err(_) => false });
  let skipped_map = failure <&> must_not_map;
  assert(match skipped_map with { Ok(_) => false, Err(code) => code == -17 });

  let chained = source >>= checked_positive >>= checked_number;
  assert(match chained with { Ok(value) => value == 42, Err(_) => false });
  let flipped_chain = checked_number =<< checked_positive =<< source;
  assert(match flipped_chain with { Ok(value) => value == 42, Err(_) => false });
  let skipped_chain = must_not_chain =<< failure;
  assert(match skipped_chain with { Ok(_) => false, Err(code) => code == -17 });

  let forward = checked_positive >=> checked_number;
  let backward = checked_number <=< checked_positive;
  assert(match forward(3) with { Ok(value) => value == 42, Err(_) => false });
  assert(match backward(3) with { Ok(value) => value == 42, Err(_) => false });
  assert(match forward(-1) with { Ok(_) => false, Err(code) => code == -9 });
  assert(match backward(0) with { Ok(_) => false, Err(code) => code == -2 });
}
