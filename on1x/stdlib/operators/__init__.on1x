from ..core.Pervasive import Result;
from ..operator import utils as OperatorUtils;

operator <A, B> (lexeme: "|>", arity: "binary", precedence: 1, tightness: 0,
  binds: "left", formals: value: A, function: fn(A) -> B) -> B
{
  return OperatorUtils.basis_operator_apply(function, value);
}

operator <A, B> (lexeme: "<|", arity: "binary", precedence: 1, tightness: 0,
  binds: "right", formals: function: fn(A) -> B, value: A) -> B
{
  return OperatorUtils.basis_operator_apply(function, value);
}

operator <A, B, C> (lexeme: ">>.", arity: "binary", precedence: 7, tightness: 0,
  binds: "left", formals: inner: fn(A) -> B, outer: fn(B) -> C) -> fn(A) -> C
{
  return OperatorUtils.basis_operator_compose(outer, inner);
}

operator <A, B, C> (lexeme: "<<.", arity: "binary", precedence: 7, tightness: 0,
  binds: "right", formals: outer: fn(B) -> C, inner: fn(A) -> B) -> fn(A) -> C
{
  return OperatorUtils.basis_operator_compose(outer, inner);
}

operator <A, B, E> (lexeme: "<$>", arity: "binary", precedence: 2, tightness: 0,
  binds: "left", formals: function: fn(A) -> B, value: Result<A, E>) -> Result<B, E>
{
  return OperatorUtils.basis_operator_result_map(value, function);
}

operator <A, B, E> (lexeme: "<&>", arity: "binary", precedence: 2, tightness: 0,
  binds: "left", formals: value: Result<A, E>, function: fn(A) -> B) -> Result<B, E>
{
  return OperatorUtils.basis_operator_result_map(value, function);
}

operator <A, B, E> (lexeme: ">>=", arity: "binary", precedence: 0, tightness: 0,
  binds: "left", formals: value: Result<A, E>, function: fn(A) -> Result<B, E>) -> Result<B, E>
{
  return OperatorUtils.basis_operator_result_chain(value, function);
}

operator <A, B, E> (lexeme: "=<<", arity: "binary", precedence: 0, tightness: 0,
  binds: "right", formals: function: fn(A) -> Result<B, E>, value: Result<A, E>) -> Result<B, E>
{
  return OperatorUtils.basis_operator_result_chain(value, function);
}

operator <A, B, C, E> (lexeme: ">=>", arity: "binary", precedence: 7, tightness: 0,
  binds: "left", formals: inner: fn(A) -> Result<B, E>,
  outer: fn(B) -> Result<C, E>) -> fn(A) -> Result<C, E>
{
  return OperatorUtils.basis_operator_result_compose(outer, inner);
}

operator <A, B, C, E> (lexeme: "<=<", arity: "binary", precedence: 7, tightness: 0,
  binds: "right", formals: outer: fn(B) -> Result<C, E>,
  inner: fn(A) -> Result<B, E>) -> fn(A) -> Result<C, E>
{
  return OperatorUtils.basis_operator_result_compose(outer, inner);
}
