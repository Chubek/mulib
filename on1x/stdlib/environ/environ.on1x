extern fn on1x_environ_argc() -> i64;
extern fn on1x_environ_arg(index: i64) -> string;
extern fn on1x_environ_count() -> i64;
extern fn on1x_environ_entry(index: i64) -> string;
extern fn on1x_environ_has(name: string) -> bool;
extern fn on1x_environ_getenv(name: string) -> string;
extern fn on1x_environ_uname_ready() -> bool;
extern fn on1x_environ_uname_field(index: i64) -> string;
extern fn on1x_environ_exec(path: string, count: i64, wire: string) -> i64;
extern fn on1x_environ_system(command: string) -> i64;

fn basis_argc() -> i64 {
  return on1x_environ_argc();
}

fn basis_argv() -> sexpr {
  var index = on1x_environ_argc();
  var args = sx_nil();
  while index > 0 {
    index = index - 1;
    args = sx_cons(sx_string(on1x_environ_arg(index)), args);
  }
  return args;
}

fn basis_environ() -> sexpr {
  var index = on1x_environ_count();
  var entries = sx_nil();
  while index > 0 {
    index = index - 1;
    entries = sx_cons(sx_string(on1x_environ_entry(index)), entries);
  }
  return entries;
}

fn basis_getenv(name: string) -> (bool, string) {
  if !on1x_environ_has(name) { return (false, ""); }
  return (true, on1x_environ_getenv(name));
}

# Field order: success, sysname, nodename, release, version, machine.
fn basis_uname() -> (bool, string, string, string, string, string) {
  if !on1x_environ_uname_ready() { return (false, "", "", "", "", ""); }
  return (true, on1x_environ_uname_field(0), on1x_environ_uname_field(1),
          on1x_environ_uname_field(2), on1x_environ_uname_field(3),
          on1x_environ_uname_field(4));
}

fn basis_os() -> (bool, string) {
  if !on1x_environ_uname_ready() { return (false, ""); }
  return (true, on1x_environ_uname_field(0));
}

fn basis_exec(path: string, args: sexpr) -> i64 {
  # The raw C ABI accepts only scalar values. Frame each argument as
  # decimal byte count, colon, then exactly that many bytes.
  var rest = args;
  var count = 0;
  let wire = buffer_new();
  while sx_kind(rest) == 3 {
    let arg = sx_head(rest);
    if sx_kind(arg) != 2 { return on1x_environ_exec(path, -1, ""); }
    count = count + 1;
    if count > 4095 { return on1x_environ_exec(path, count, ""); }
    let text = sx_text(arg);
    buffer_append(wire, format("{}:", text_len(text)));
    buffer_append(wire, text);
    rest = sx_tail(rest);
  }
  if sx_kind(rest) != 0 { return on1x_environ_exec(path, -1, ""); }
  return on1x_environ_exec(path, count, buffer_text(wire));
}

fn basis_system(command: string) -> i64 {
  return on1x_environ_system(command);
}
