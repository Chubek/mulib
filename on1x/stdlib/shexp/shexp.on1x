# Pure S-expression command AST. Shell execution is opt-in and not implemented here.
fn shexp_exec(program: string, arguments: sexpr) -> sexpr
{
  return sx_cons(sx_symbol("exec"), sx_cons(sx_string(program), arguments));
}

fn shexp_sequence(a: sexpr, b: sexpr) -> sexpr
{
  return sx_cons(sx_symbol("seq"), sx_cons(a, sx_cons(b, sx_nil())));
}

fn shexp_chdir(path: string, action: sexpr) -> sexpr
{
  return sx_cons(sx_symbol("chdir"),
    sx_cons(sx_string(path),
    sx_cons(action,
    sx_nil())));
}

fn shexp_render(command: sexpr) -> string
{
  return sx_text(sx_head(command));
}
