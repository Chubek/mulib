# In-process mailbox built on persistent managed S-expressions.
fn ipc_empty() -> sexpr
{
  return sx_nil();
}
fn ipc_send(messages: sexpr, message: sexpr) -> sexpr
{
  basis_shape_list(messages);
  return sx_cons(message, messages);
}
fn ipc_has_message(messages: sexpr) -> bool
{
  basis_shape_list(messages);
  return sx_kind(messages) == 3;
}
fn ipc_receive(messages: sexpr) ->(sexpr, sexpr)
{
  basis_shape_list(messages);
  if sx_kind(messages) != 3
  {
    tool_fail("ipc: mailbox empty");
  }
  return (sx_head(messages), sx_tail(messages));
}
import "../base/shape.on1x";
