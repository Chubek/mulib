from . . import basis_daemon_ipc_dispatch;

fn must_not_dispatch(byte: i64) -> i64
{
  assert(false);
  return byte;
}

fn main()
{
  # The runner leaves only one descriptor slot; socketpair needs two.
  let invalid = basis_daemon_ipc_dispatch(7u8, 0, must_not_dispatch);
  assert(match invalid with { Ok(value) => false, Err(status) => status == -1 });
  let unavailable = basis_daemon_ipc_dispatch(7u8, 1000, must_not_dispatch);
  assert(match unavailable with { Ok(value) => false, Err(status) => status == -2 });
}
