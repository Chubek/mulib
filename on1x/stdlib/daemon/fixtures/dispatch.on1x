from . . import basis_daemon_ipc_dispatch;

fn identity(byte: i64) -> i64
{
  return byte;
}

fn reject_timeout(timeout_ms: i64)
{
  let failed = basis_daemon_ipc_dispatch(7u8, timeout_ms, fn(byte: i64) -> i64 {
    assert(false);
    return byte;
  });
  assert(match failed with { Ok(value) => false, Err(status) => status == -1 });
}

fn main()
{
  let captured = 42;
  let nul = basis_daemon_ipc_dispatch(0u8, 1000, fn(byte: i64) -> i64 {
    println(byte);
    return byte - captured;
  });
  assert(match nul with { Ok(value) => value == -42, Err(status) => false });

  let high = basis_daemon_ipc_dispatch(255u8, 1000, fn(byte: i64) -> i64 {
    println(byte);
    return byte;
  });
  assert(match high with { Ok(value) => value == 255, Err(status) => false });

  reject_timeout(0);
  reject_timeout(1001);
  reject_timeout(-9223372036854775807 - 1);
  reject_timeout(9223372036854775807);

  # More than the adapter's 128-live-owner limit, without explicit caller cleanup.
  var count = 0;
  while count < 260 {
    let result = basis_daemon_ipc_dispatch(7u8, 1000, identity);
    assert(match result with { Ok(value) => value == 7, Err(status) => false });
    count = count + 1;
  }
  println(count);
}
