unsafe import kernel mulib.ipc_framed as DaemonFramed;

# One local byte and one synchronous handler call. No process or endpoint escapes.
fn basis_daemon_ipc_dispatch(request: u8, timeout_ms: i64, handler: fn(i64) -> i64)
    -> DaemonFramed.Result<i64, i64>
{
  if timeout_ms < 1 || timeout_ms > 1000 {
    return variant<DaemonFramed.Result<i64, i64>>(Err, -1);
  }
  let pending = unsafe { DaemonFramed.open_pair() };
  let pair = pending?;
  return unsafe { DaemonFramed.roundtrip(move(pair), request, timeout_ms, handler) };
}
