# These are application-side values, not kernel handles, IPC messages, or a
# serializer. A trusted host must resolve a runner and validate its own data
# encoding before handing bytes to the native companion.
from . .core.Pervasive import Option;

record DaemonBudget {
  startup_ms: i64, run_ms: i64, grace_ms: i64, reap_ms: i64
}

record DaemonRetry {
  max_restarts: i64, backoff_ms: i64
}

enum DaemonRestart { DaemonNever, DaemonOnFailure(DaemonRetry), DaemonAlways(DaemonRetry) }

record DaemonPolicy {
  budget: DaemonBudget, restart: DaemonRestart
}

record DaemonSpecification < C > {
  runner: string, context: C, policy: DaemonPolicy
}

# Queue-local identifiers describe commands in the application, not owners.
record DaemonJobId { id: u64 }

enum DaemonMessage < C > {
  DaemonSubmit(DaemonSpecification<C>), DaemonCancel(DaemonJobId),
  DaemonStatus(DaemonJobId), DaemonShutdown
}

fn basis_daemon_job_id(id: u64) -> Option<DaemonJobId> {
  if id == 0u64 {
    return variant<Option<DaemonJobId>>(None, record {});
  }
  return variant<Option<DaemonJobId>>(Some, record<DaemonJobId>{id: id});
}

fn basis_daemon_retry_valid(retry: DaemonRetry) -> bool {
  let count = retry["max_restarts"];
  let backoff = retry["backoff_ms"];
  return count >= 1 && count <= 8 && backoff >= 1 && backoff <= 60000;
}

fn basis_daemon_policy_valid(policy: DaemonPolicy) -> bool {
  let budget = policy["budget"];
  let startup = budget["startup_ms"];
  let run = budget["run_ms"];
  let grace = budget["grace_ms"];
  let reap = budget["reap_ms"];
  if startup < 1 || startup > 60000 || run < 1 || run > 60000 ||
      grace < 0 || grace > 60000 || reap < 1 || reap > 60000 {
    return false;
  }
  return match policy["restart"] with {
    DaemonNever() => true,
    DaemonOnFailure(retry) => basis_daemon_retry_valid(retry),
    DaemonAlways(retry) => basis_daemon_retry_valid(retry)
  };
}
