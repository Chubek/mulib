# Pure On1x byte-index scanning primitives, complements MuLIB Parsec contracts.
fn parsec_in_range(text: string, pos: i64, low: i64, high: i64) -> bool {
 if pos < 0 || pos >= text_len(text) { return false; }
 let b = text_byte(text,pos); return b >= low && b <= high;
}
fn parsec_literal(text: string, pos: i64, expected: string) -> bool {
 if pos < 0 || pos > text_len(text) { return false; }
 let n=text_len(expected);if n>text_len(text)-pos{return false;}
 var i=0;while i<n{if text_byte(text,pos+i)!=text_byte(expected,i){return false;}i=i+1;}return true;
}
fn parsec_space(text: string, start: i64) -> i64 {
 var i = start; if i < 0 || i>text_len(text) { tool_fail("parsec position outside input"); }
 while i < text_len(text) {
  let c = text_byte(text,i);
  if c != 32 && c != 9 && c != 10 && c != 13 { return i; }
  i = i + 1;
 }
 return i;
}
fn basis_parsec_int(text:string,start:i64)->(bool,i64,i64) {
 let length=text_len(text);if start<0||start>=length{return (false,0,start);}
 var pos=start;var negative=false;
 if text_byte(text,pos)==45||text_byte(text,pos)==43{negative=text_byte(text,pos)==45;pos=pos+1;}
 let first=pos;var value=0;var limit=-9223372036854775807;
 if negative{limit=-9223372036854775808;}
 while pos<length{
  let digit=text_byte(text,pos)-48;if digit<0||digit>9{if pos==first{return (false,0,start);}if negative{return (true,value,pos);}return (true,-value,pos);}
  if value<limit/10{return (false,0,start);}value=value*10;
  if value<limit+digit{return (false,0,start);}value=value-digit;pos=pos+1;
 }
 if pos==first{return (false,0,start);}if negative{return (true,value,pos);}return (true,-value,pos);
}
fn parsec_uint(text: string, start: i64) -> (bool,i64,i64) {
 var i = start; var n = 0;
 if i < 0 || i >= text_len(text) { return (false,0,start); }
 while i < text_len(text) {
  let c = text_byte(text,i); if c < 48 || c > 57 { return (i > start,n,i); }
  let d = c - 48;
  if n > (9223372036854775807 - d) / 10 { return (false,0,start); }
  n = n * 10 + d; i = i + 1;
 }
 return (i > start,n,i);
}
