import std.html as H;

extern fn on1x_html_test_budget_v1(n: i64) -> void;
extern fn on1x_html_test_live_v1() -> i64;

fn check_query(doc: H.BasisHtml) -> bool
{
  var failed = false;
  var succeeded = false;
  for i in 0 .. 180
  {
    on1x_html_test_budget_v1(i);
    let result = H.basis_html_xpath(doc, "//li[@checked]/text()");
    assert(on1x_html_test_live_v1() == 0);
    match result with
    {
      Ok(selection) =>
      {
        let (status, count) = H.basis_html_selection_count(selection);
        assert(status == 0 && count == 1);
        succeeded = true;
      },
      Err(error) =>
      {
        assert(error == -3);
        failed = true;
      }
    };
  }
  return failed && succeeded;
}

fn main()
{
  let source = "<!doctype html><html><head><title>Site</title></head><body><ul><li checked>one<li>two</ul></body></html>";
  var failed = false;
  var succeeded = false;
  for i in 0 .. 180
  {
    on1x_html_test_budget_v1(i);
    let result = H.basis_html_parse(source);
    assert(on1x_html_test_live_v1() == 0);
    match result with
    {
      Ok(_) => { succeeded = true; },
      Err(error) => { assert(error == -3); failed = true; }
    };
  }
  assert(failed && succeeded && data_live_nodes() == 0);
  on1x_html_test_budget_v1(-1);
  match H.basis_html_parse(source) with
  {
    Ok(doc) => assert(check_query(doc)),
    Err(_) => assert(false)
  };
  assert(on1x_html_test_live_v1() == 0 && data_live_nodes() == 0);
}
