# Canonical, immutable HTML snapshot. No foreign object or handle is retained.
from . .core.Pervasive import Option, Result;
from ._Trusted import on1x_html_parse_v1, on1x_html_node_v1;

record BasisHtml
{
  markup: sexpr, fragment: bool
}

record BasisHtmlNode
{
  document: BasisHtml, ordinal: i64
}

record BasisHtmlSelection
{
  document: BasisHtml, ordinals: sexpr
}

fn html_reply_status(reply: string) -> i64
{
  let n = text_len(reply);
  if n > 0 && text_byte(reply, 0) == 43 { return 0; }
  if n == 2 && text_byte(reply, 0) == 45
  {
    let code = text_byte(reply, 1) - 48;
    if code >= 1 && code <= 5 { return -code; }
  }
  return -5;
}

fn html_reply_text(reply: string) -> (i64, string)
{
  let status = html_reply_status(reply);
  if status != 0 { return (status, ""); }
  if text_len(reply) == 1 { return (0, ""); }
  return (0, text_slice(reply, 1, text_len(reply)));
}

fn html_hex4(wire: string, at: i64) -> i64
{
  if at < 0 || at > text_len(wire) - 4 { return -1; }
  var value = 0;
  for i in at .. at + 4
  {
    let c = text_byte(wire, i);
    if c >= 48 && c <= 57 { value = value * 16 + c - 48; }
    else
    {
      if c < 97 || c > 102 { return -1; }
      value = value * 16 + c - 87;
    }
  }
  return value;
}

fn html_reply_int(reply: string) -> (i64, i64)
{
  let status = html_reply_status(reply);
  if status != 0 { return (status, 0); }
  if text_len(reply) != 5 { return (-5, 0); }
  let value = html_hex4(reply, 1);
  if value < 0 { return (-5, 0); }
  return (0, value);
}

fn html_parse(source: string, profile: i64, hex: i64) -> Result<BasisHtml, i64>
{
  let wire = on1x_html_parse_v1(source, text_len(source), profile, hex);
  let (status, markup) = html_reply_text(wire);
  if status != 0 { return variant<Result<BasisHtml, i64>>(Err, status); }
  return variant<Result<BasisHtml, i64>>(Ok, record<BasisHtml>
  {
    markup: sx_string(markup), fragment: profile == 2
  });
}

fn basis_html_parse(source: string) -> Result<BasisHtml, i64>
{
  return html_parse(source, 0, 0);
}

fn basis_html_parse_hex(source: string) -> Result<BasisHtml, i64>
{
  return html_parse(source, 0, 1);
}

fn basis_html_parse_strict(source: string) -> Result<BasisHtml, i64>
{
  return html_parse(source, 1, 0);
}

fn basis_html_parse_fragment(source: string) -> Result<BasisHtml, i64>
{
  return html_parse(source, 2, 0);
}

fn html_node(document: BasisHtml, ordinal: i64) -> BasisHtmlNode
{
  return record<BasisHtmlNode> { document: document, ordinal: ordinal };
}

fn basis_html_root(document: BasisHtml) -> BasisHtmlNode
{
  return html_node(document, 0);
}

fn html_node_op(node: BasisHtmlNode, op: i64, arg: string, index: i64) -> string
{
  let document = node["document"];
  let markup = document["markup"];
  if sx_kind(markup) != 2 { return "-1"; }
  var fragment = 0;
  if document["fragment"] { fragment = 1; }
  return on1x_html_node_v1(sx_text(markup), fragment, node["ordinal"], op, arg, index);
}

fn basis_html_node_kind(node: BasisHtmlNode) -> (i64, i64)
{
  return html_reply_int(html_node_op(node, 0, "", 0));
}

fn basis_html_node_name(node: BasisHtmlNode) -> (i64, string)
{
  return html_reply_text(html_node_op(node, 1, "", 0));
}

fn basis_html_node_value(node: BasisHtmlNode) -> (i64, string)
{
  return html_reply_text(html_node_op(node, 2, "", 0));
}

fn basis_html_node_text(node: BasisHtmlNode) -> (i64, string)
{
  return html_reply_text(html_node_op(node, 3, "", 0));
}

fn basis_html_node_serialize(node: BasisHtmlNode) -> (i64, string)
{
  return html_reply_text(html_node_op(node, 4, "", 0));
}

fn basis_html_serialize(document: BasisHtml) -> (i64, string)
{
  return basis_html_node_serialize(basis_html_root(document));
}

fn html_edge(node: BasisHtmlNode, op: i64) -> Result<Option<BasisHtmlNode>, i64>
{
  let (status, ordinal) = html_reply_int(html_node_op(node, op, "", 0));
  if status == -4
  {
    return variant<Result<Option<BasisHtmlNode>, i64>>(Ok,
      variant<Option<BasisHtmlNode>>(None, record {}));
  }
  if status != 0 { return variant<Result<Option<BasisHtmlNode>, i64>>(Err, status); }
  return variant<Result<Option<BasisHtmlNode>, i64>>(Ok,
    variant<Option<BasisHtmlNode>>(Some, html_node(node["document"], ordinal)));
}

fn basis_html_node_parent(node: BasisHtmlNode) -> Result<Option<BasisHtmlNode>, i64>
{
  return html_edge(node, 5);
}

fn basis_html_node_first_child(node: BasisHtmlNode) -> Result<Option<BasisHtmlNode>, i64>
{
  return html_edge(node, 6);
}

fn basis_html_node_next_sibling(node: BasisHtmlNode) -> Result<Option<BasisHtmlNode>, i64>
{
  return html_edge(node, 7);
}

fn basis_html_node_attr(node: BasisHtmlNode, attr: string) -> (i64, string)
{
  return html_reply_text(html_node_op(node, 9, attr, 0));
}

fn basis_html_node_attr_count(node: BasisHtmlNode) -> (i64, i64)
{
  return html_reply_int(html_node_op(node, 10, "", 0));
}

fn basis_html_node_attr_name(node: BasisHtmlNode, index: i64) -> (i64, string)
{
  return html_reply_text(html_node_op(node, 11, "", index));
}

fn basis_html_node_attr_value(node: BasisHtmlNode, index: i64) -> (i64, string)
{
  return html_reply_text(html_node_op(node, 12, "", index));
}

fn basis_html_node_xpath(node: BasisHtmlNode, expression: string) -> Result<BasisHtmlSelection, i64>
{
  let (status, wire) = html_reply_text(html_node_op(node, 13, expression, 0));
  if status != 0 { return variant<Result<BasisHtmlSelection, i64>>(Err, status); }
  if text_len(wire) > 4096 || text_len(wire) % 4 != 0
  {
    return variant<Result<BasisHtmlSelection, i64>>(Err, -5);
  }
  return variant<Result<BasisHtmlSelection, i64>>(Ok, record<BasisHtmlSelection>
  {
    document: node["document"], ordinals: sx_string(wire)
  });
}

fn basis_html_xpath(document: BasisHtml, expression: string) -> Result<BasisHtmlSelection, i64>
{
  return basis_html_node_xpath(basis_html_root(document), expression);
}

fn basis_html_selection_count(selection: BasisHtmlSelection) -> (i64, i64)
{
  let data = selection["ordinals"];
  if sx_kind(data) != 2 { return (-1, 0); }
  let n = text_len(sx_text(data));
  if n > 4096 || n % 4 != 0 { return (-1, 0); }
  return (0, n / 4);
}

fn basis_html_selection_get(selection: BasisHtmlSelection, index: i64) -> Result<BasisHtmlNode, i64>
{
  let (status, count) = basis_html_selection_count(selection);
  if status != 0 { return variant<Result<BasisHtmlNode, i64>>(Err, status); }
  if index < 0 { return variant<Result<BasisHtmlNode, i64>>(Err, -1); }
  if index >= count { return variant<Result<BasisHtmlNode, i64>>(Err, -4); }
  let id = html_hex4(sx_text(selection["ordinals"]), index * 4);
  if id < 0 || id >= 1024 { return variant<Result<BasisHtmlNode, i64>>(Err, -1); }
  return variant<Result<BasisHtmlNode, i64>>(Ok, html_node(selection["document"], id));
}

# Preorder includes the supplied root. A false visitor result stops early.
fn basis_html_walk(root: BasisHtmlNode, visit: fn(BasisHtmlNode) -> bool) -> (i64, bool)
{
  let (status, end) = html_reply_int(html_node_op(root, 8, "", 0));
  if status != 0 { return (status, false); }
  if end <= root["ordinal"] || end > 1024 { return (-5, false); }
  for index in root["ordinal"] .. end
  {
    if !visit(html_node(root["document"], index)) { return (0, false); }
  }
  return (0, true);
}

# The accumulator is a managed S-expression, not a C callback context.
fn basis_html_fold(root: BasisHtmlNode, initial: sexpr,
                   visit: fn(sexpr, BasisHtmlNode) -> sexpr) -> Result<sexpr, i64>
{
  let (status, end) = html_reply_int(html_node_op(root, 8, "", 0));
  if status != 0 { return variant<Result<sexpr, i64>>(Err, status); }
  if end <= root["ordinal"] || end > 1024 { return variant<Result<sexpr, i64>>(Err, -5); }
  var result = initial;
  for index in root["ordinal"] .. end
  {
    result = visit(result, html_node(root["document"], index));
  }
  return variant<Result<sexpr, i64>>(Ok, result);
}
