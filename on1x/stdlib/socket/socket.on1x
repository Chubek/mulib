# Opaque-generation-checked socket handles are positive i64s; -1 reports failure.
# Implemented by MuLIB mulib-socket.h; no implicit TLS.
extern fn on1x_mulib_socket_connect_ipv4(address: string, port: i64) -> i64;
extern fn on1x_mulib_socket_send(handle: i64, text: string) -> i64;
extern fn on1x_mulib_socket_recv(handle: i64, limit: i64) -> string;
extern fn on1x_mulib_socket_close(handle: i64) -> bool;
extern fn on1x_mulib_socket_send_from(handle: i64,
  text: string,
  offset: i64) -> i64;
extern fn on1x_mulib_socket_recv_hex(handle: i64, limit: i64) -> string;
fn socket_connect(address: string, port: i64) -> i64
{
  return on1x_mulib_socket_connect_ipv4(address, port);
}

fn socket_send(handle: i64, text: string) -> i64
{
  return on1x_mulib_socket_send(handle, text);
}

fn socket_recv(handle: i64, limit: i64) -> string
{
  return on1x_mulib_socket_recv(handle, limit);
}

fn socket_close(handle: i64) -> bool
{
  return on1x_mulib_socket_close(handle);
}

fn basis_socket_receive(handle: i64, limit: i64) ->(i64, string)
{
  let value = on1x_mulib_socket_recv(handle, limit);
  return (on1x_mulib_bridge_status(), value);
}

fn basis_socket_receive_hex(handle: i64, limit: i64) ->(i64, string)
{
  let value = on1x_mulib_socket_recv_hex(handle, limit);
  return (on1x_mulib_bridge_status(), value);
}

import "../_bridge/status.on1x";
