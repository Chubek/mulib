# Helpers for HTTP status, normalized response header lines, and binary bodies.
fn basis_http_success(status: i64) -> bool
{
  return status >= 200 && status < 300;
}

fn basis_http_fold_ascii(byte: i64) -> i64
{
  if byte >= 65 && byte <= 90 { return byte + 32; }
  return byte;
}

# First match, preserving the distinction between absent and empty.
# Client header lines are "Name:value\n"; duplicates are kept in wire order.
fn basis_http_header(headers: string, name: string) -> (bool, string)
{
  let width = text_len(name);
  let n = text_len(headers);
  if width == 0 { return (false, ""); }
  var start = 0;
  while start < n
  {
    var end = start;
    var colon = -1;
    while end < n && text_byte(headers, end) != 10
    {
      if colon == -1 && text_byte(headers, end) == 58 { colon = end; }
      end = end + 1;
    }
    if colon >= start && colon - start == width
    {
      var i = 0;
      while i < width && basis_http_fold_ascii(text_byte(headers, start + i)) == basis_http_fold_ascii(text_byte(name, i))
      {
        i = i + 1;
      }
      if i == width { return (true, text_slice(headers, colon + 1, end)); }
    }
    if end == n { return (false, ""); }
    start = end + 1;
  }
  return (false, "");
}

fn basis_http_nibble(byte: i64) -> i64
{
  if byte >= 48 && byte <= 57 { return byte - 48; }
  if byte >= 97 && byte <= 102 { return byte - 87; }
  return -1;
}

# Lowercase hex from the client. Returns -1 for a bad index or malformed pair.
fn basis_http_body_byte(hex: string, index: i64) -> i64
{
  let n = text_len(hex);
  if n % 2 != 0 || index < 0 || index >= n / 2 { return -1; }
  let off = index * 2;
  let hi = basis_http_nibble(text_byte(hex, off));
  let lo = basis_http_nibble(text_byte(hex, off + 1));
  if hi < 0 || lo < 0 { return -1; }
  return hi * 16 + lo;
}
