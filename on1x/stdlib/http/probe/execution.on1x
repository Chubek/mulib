from . . .core.Pervasive import Option, Result;
from . . .elvi.elvi import ElviProgram, ElviError, ElviStageKind,
  basis_elvi_inspect, basis_elvi_stage;
from . . .elvi.provider import ElviScript;
from . . .elvi.capture import BasisElviCaptureRequest as ProbeRequest,
  BasisElviCaptureError, basis_elvi_capture;
from . . .elvi.document import BasisElviDocument, BasisElviDocumentMetadata;
from . . .html.html import BasisHtml, basis_html_parse_hex;
from .spec import ProbeSpec, ProbeOptions, ProbeResult, ProbeHandler, ProbeSpecError, ProbeParseError,
  ProbeArtifactPolicy, ProbeArtifactRequest, basis_http_probe_validate, basis_http_probe_configure,
  basis_http_probe_artifact_request, basis_http_probe_result;

record Probe < T >
{
  spec: ProbeSpec,
  parse: fn(BasisHtml) -> Result<T, ProbeParseError>
}

# Trusted application functions, not authority derived from ProbeSpec. A
# backend owns all live/replay transport checks; neither function is saved.
record FetchBackend
{
  capture: fn(ElviProgram, ProbeRequest) -> Result<BasisElviDocument, i64>
}

record ProbeHost
{
  authorize: fn(ProbeRequest) -> bool,
  backend: FetchBackend
}

enum ProbeArtifactEffect
{
  ProbeArtifactCommitted, ProbeArtifactUncertain, ProbeArtifactRejected(i64)
}

# An effect policy has no default executor. A trusted application independently
# authorizes the destination key and performs the requested action once.
record ProbeArtifactSink
{
  authorize: fn(ProbeArtifactRequest, ProbeRequest) -> bool,
  write: fn(ProbeArtifactRequest, BasisHtml) -> ProbeArtifactEffect
}

# The one-shot document output is separate from optional artifacts in
# ProbeResult<T>. Result handlers receive the latter, not this run receipt.
record ProbeRun < T >
{
  document: BasisHtml,
  result: ProbeResult<T>
}

impl < T > ProbeRun<T>
{
  fn basis_http_probe_run_document(borrow self) -> BasisHtml
  {
    return self["document"];
  }
}

enum ProbeRunError
{
  ProbeInvalidSpec(ProbeSpecError),
  ProbeElviFailure(ElviError),
  ProbeUnsupportedCookies,
  ProbeArtifactSinkRequired,
  ProbeArtifactDenied,
  ProbeDenied,
  ProbeCaptureFailure(i64),
  ProbeCapturePolicyFailure(BasisElviCaptureError),
  ProbeInvalidDocument,
  ProbeHttpFailure(i64),
  ProbeUnsupportedMedia,
  ProbeHtmlFailure(i64),
  ProbeParserFailure(ProbeParseError),
  ProbeArtifactWriteFailure(i64),
  ProbeArtifactWriteUncertain
}

record ProbeTargets < T >
{
  count: i64,
  at: fn(i64) -> Option<Probe<T>>
}

enum ProbeBatchCause
{
  ProbeBatchBadCount, ProbeBatchMissingTarget, ProbeBatchRunFailure(ProbeRunError)
}

record ProbeBatchError
{
  index: i64, # -1 for an invalid whole-batch count
  cause: ProbeBatchCause
}

impl < T > Probe < T >
{
  fn basis_http_probe_from_spec(spec: ProbeSpec,
    parse: fn(BasisHtml) -> Result<T, ProbeParseError>) -> Result<Probe<T>, ProbeSpecError>
  {
    return basis_http_probe_make(spec, parse);
  }

  fn basis_http_probe_from_options(options: ProbeOptions,
    parse: fn(BasisHtml) -> Result<T, ProbeParseError>) -> Result<Probe<T>, ProbeSpecError>
  {
    return match basis_http_probe_configure(options) with {
      Ok(spec) => basis_http_probe_make(spec, parse),
      Err(error) => variant<Result<Probe<T>, ProbeSpecError>>(Err, error)
    };
  }

  fn basis_http_probe_spec(borrow self) -> ProbeSpec
  {
    return self["spec"];
  }

  fn basis_http_probe_validated_program(borrow self) -> Result<ElviProgram, ProbeSpecError>
  {
    return basis_http_probe_validate(self["spec"]);
  }

  fn basis_http_probe_reconfigure(borrow self, options: ProbeOptions) -> Result<Probe<T>, ProbeSpecError>
  {
    return Probe<T>::basis_http_probe_from_options(options, self["parse"]);
  }

  # The named receiver remains usable. Snapshot only its immutable fields
  # into the by-value entry, without letting the lexical loan escape.
  fn basis_http_probe_run < C > (borrow self, host: ProbeHost,
      handler: ProbeHandler<C, T>) -> Result<BasisHtml, ProbeRunError>
  {
    let probe = record<Probe<T>>{spec: self["spec"], parse: self["parse"]};
    return basis_http_probe_run_html(probe, host, handler);
  }

  fn basis_http_probe_run_result < C > (borrow self, host: ProbeHost,
      handler: ProbeHandler<C, T>) -> Result<ProbeResult<T>, ProbeRunError>
  {
    let probe = record<Probe<T>>{spec: self["spec"], parse: self["parse"]};
    return basis_http_probe_run_result(probe, host, handler);
  }
}

# This checks only configuration. Do not invoke the callback during formation.
fn basis_http_probe_make < T > (spec: ProbeSpec,
  parse: fn(BasisHtml) -> Result<T, ProbeParseError>) -> Result<Probe<T>, ProbeSpecError>
{
  return match basis_http_probe_validate(spec) with {
    Ok(_) => variant<Result<Probe<T>, ProbeSpecError>>(Ok,
      record<Probe<T>>{spec: spec, parse: parse}),
    Err(error) => variant<Result<Probe<T>, ProbeSpecError>>(Err, error)
  };
}

fn basis_http_probe_from_elvi < T > (program: ElviProgram, max_body_bytes: i64,
  artifact_policy: ProbeArtifactPolicy, parse: fn(BasisHtml) -> Result<T, ProbeParseError>)
    -> Result<Probe<T>, ProbeSpecError>
{
  return basis_http_probe_make(record<ProbeSpec>{
    source: program["source"], max_body_bytes: max_body_bytes, artifact_policy: artifact_policy
  }, parse);
}

fn basis_http_probe_from_elvi_script < T > (script: ElviScript, max_body_bytes: i64,
  artifact_policy: ProbeArtifactPolicy, parse: fn(BasisHtml) -> Result<T, ProbeParseError>)
    -> Result<Probe<T>, ProbeSpecError>
{
  # Revalidate the program, not the public script record's cached profile.
  return basis_http_probe_from_elvi(script["program"], max_body_bytes, artifact_policy, parse);
}

fn probe_canonical_document(document: BasisHtml) -> Result<BasisHtml, ProbeParseError>
{
  return variant<Result<BasisHtml, ProbeParseError>>(Ok, document);
}

fn basis_http_probe_make_html(spec: ProbeSpec) -> Result<Probe<BasisHtml>, ProbeSpecError>
{
  return basis_http_probe_make(spec, probe_canonical_document);
}

fn probe_failure < T > (error: ProbeRunError) -> Result<ProbeRun<T>, ProbeRunError>
{
  return variant<Result<ProbeRun<T>, ProbeRunError>>(Err, error);
}

fn probe_capture_error(error: BasisElviCaptureError) -> ProbeRunError
{
  return match error with {
    CaptureTransportFailure(code) => variant<ProbeRunError>(ProbeCaptureFailure, code),
    CaptureInvalidResponse() => variant<ProbeRunError>(ProbeInvalidDocument, record {}),
    _ => variant<ProbeRunError>(ProbeCapturePolicyFailure, error)
  };
}

fn probe_ascii_lower(byte: i64) -> i64
{
  if byte >= 65 && byte <= 90 { return byte + 32; }
  return byte;
}

fn probe_media_match(media: string, at: i64, word: string) -> bool
{
  let n = text_len(word);
  if at < 0 || at > text_len(media) - n { return false; }
  for i in 0 .. n {
    if probe_ascii_lower(text_byte(media, at + i)) != text_byte(word, i) { return false; }
  }
  return true;
}

fn probe_media_skip_space(media: string, at: i64) -> i64
{
  let n = text_len(media);
  for i in at .. n {
    let c = text_byte(media, i);
    if c != 9 && c != 32 { return i; }
  }
  return n;
}

# This bounded profile admits text/html, with an optional UTF-8 parameter.
# It does not transcode or guess another charset or parse arbitrary MIME.
fn probe_html_media(content_type: string) -> bool
{
  let n = text_len(content_type);
  if !probe_media_match(content_type, 0, "text/html") { return false; }
  let parameter = probe_media_skip_space(content_type, 9);
  if parameter == n { return true; }
  if text_byte(content_type, parameter) != 59 { return false; }
  let name = probe_media_skip_space(content_type, parameter + 1);
  if !probe_media_match(content_type, name, "charset") { return false; }
  let equals = probe_media_skip_space(content_type, name + 7);
  if equals == n || text_byte(content_type, equals) != 61 { return false; }
  var value = probe_media_skip_space(content_type, equals + 1);
  if value == n { return false; }
  let quoted = text_byte(content_type, value) == 34;
  if quoted { value = value + 1; }
  if !probe_media_match(content_type, value, "utf-8") { return false; }
  var trailing = value + 5;
  if quoted {
    if trailing == n || text_byte(content_type, trailing) != 34 { return false; }
    trailing = trailing + 1;
  }
  return probe_media_skip_space(content_type, trailing) == n;
}

fn probe_authorize_artifact(effect: ProbeArtifactRequest, request: ProbeRequest,
    sink: Option<ProbeArtifactSink>) -> Result<bool, ProbeRunError>
{
  return match sink with {
    None() => variant<Result<bool, ProbeRunError>>(Err,
      variant<ProbeRunError>(ProbeArtifactSinkRequired, record {})),
    Some(supplied) => {
      let authorize = supplied["authorize"];
      if !authorize(effect, request) {
        return variant<Result<bool, ProbeRunError>>(Err,
          variant<ProbeRunError>(ProbeArtifactDenied, record {}));
      }
      variant<Result<bool, ProbeRunError>>(Ok, true)
    }
  };
}

fn probe_write_artifact(effect: ProbeArtifactRequest, html: BasisHtml,
    sink: Option<ProbeArtifactSink>) -> Result<bool, ProbeRunError>
{
  return match sink with {
    None() => variant<Result<bool, ProbeRunError>>(Err,
      variant<ProbeRunError>(ProbeArtifactSinkRequired, record {})),
    Some(supplied) => {
      let write = supplied["write"];
      match write(effect, html) with {
        ProbeArtifactCommitted() => variant<Result<bool, ProbeRunError>>(Ok, true),
        ProbeArtifactRejected(error) => variant<Result<bool, ProbeRunError>>(Err,
          variant<ProbeRunError>(ProbeArtifactWriteFailure, error)),
        ProbeArtifactUncertain() => variant<Result<bool, ProbeRunError>>(Err,
          variant<ProbeRunError>(ProbeArtifactWriteUncertain, record {}))
      }
    }
  };
}

record ProbePrepared
{
  document: BasisHtml,
  metadata: BasisElviDocumentMetadata,
  body_hex: string,
  artifact: Option<ProbeArtifactRequest>
}

fn probe_prepare_failure(error: ProbeRunError) -> Result<ProbePrepared, ProbeRunError>
{
  return variant<Result<ProbePrepared, ProbeRunError>>(Err, error);
}

# This stage is independent of the parser's payload type. Keep it
# monomorphic so callers do not specialize capture and policy repeatedly.
# No implicit transport, paths, trust, retries, redirects, or result sink.
fn probe_prepare(spec: ProbeSpec, host: ProbeHost, sink: Option<ProbeArtifactSink>)
    -> Result<ProbePrepared, ProbeRunError>
{
  let program = match basis_http_probe_validate(spec) with {
    Ok(value) => value,
    Err(error) => {
      return probe_prepare_failure(variant<ProbeRunError>(ProbeInvalidSpec, error));
    }
  };
  let profile = match basis_elvi_inspect(program) with {
    Ok(value) => value,
    Err(error) => {
      return probe_prepare_failure(variant<ProbeRunError>(ProbeElviFailure, error));
    }
  };
  match basis_elvi_stage(program, variant<ElviStageKind>(CookieFile, record {})) with {
    Ok(None()) => {},
    Ok(Some(_)) => {
      return probe_prepare_failure(variant<ProbeRunError>(ProbeUnsupportedCookies, record {}));
    },
    Err(error) => {
      return probe_prepare_failure(variant<ProbeRunError>(ProbeElviFailure, error));
    }
  };

  let request = record<ProbeRequest>{
    url: profile["home"], host: profile["host"], max_body_bytes: spec["max_body_bytes"]
  };
  let artifact = basis_http_probe_artifact_request(spec["artifact_policy"]);
  match artifact with {
    None() => {},
    Some(effect) => match probe_authorize_artifact(effect, request, sink) with {
      Ok(_) => {},
      Err(error) => { return probe_prepare_failure(error); }
    }
  };
  let authorize = host["authorize"];
  if !authorize(request) {
    return probe_prepare_failure(variant<ProbeRunError>(ProbeDenied, record {}));
  }

  let backend = host["backend"];
  let capture = backend["capture"];
  # The exact scope above received independent approval. The public Elvi
  # capture API rechecks the profile, request and returned document at use.
  let document = match basis_elvi_capture(program, request["host"], request["max_body_bytes"], capture) with {
    Ok(value) => value,
    Err(error) => { return probe_prepare_failure(probe_capture_error(error)); }
  };
  let metadata = document["metadata"];
  let status = metadata["status"];
  if status < 200 || status >= 300 {
    return probe_prepare_failure(variant<ProbeRunError>(ProbeHttpFailure, status));
  }
  if !probe_html_media(metadata["content_type"]) {
    return probe_prepare_failure(variant<ProbeRunError>(ProbeUnsupportedMedia, record {}));
  }

  let body_hex = document["body_hex"];
  let html = match basis_html_parse_hex(body_hex) with {
    Ok(value) => value,
    Err(error) => {
      return probe_prepare_failure(variant<ProbeRunError>(ProbeHtmlFailure, error));
    }
  };
  return variant<Result<ProbePrepared, ProbeRunError>>(Ok, record<ProbePrepared>{
    document: html, metadata: metadata, body_hex: body_hex, artifact: artifact
  });
}

fn probe_run < T > (probe: Probe<T>, host: ProbeHost, sink: Option<ProbeArtifactSink>)
    -> Result<ProbeRun<T>, ProbeRunError>
{
  let spec = probe["spec"];
  let prepared = match probe_prepare(spec, host, sink) with {
    Ok(value) => value,
    Err(error) => { return probe_failure(error); }
  };
  let html = prepared["document"];
  let parse = probe["parse"];
  let value = match parse(html) with {
    Ok(value) => value,
    Err(error) => {
      return probe_failure(variant<ProbeRunError>(ProbeParserFailure, error));
    }
  };
  match prepared["artifact"] with {
    None() => {},
    Some(effect) => match probe_write_artifact(effect, html, sink) with {
      Ok(_) => {},
      Err(error) => { return probe_failure(error); }
    }
  };
  return variant<Result<ProbeRun<T>, ProbeRunError>>(Ok, record<ProbeRun<T>>{
    document: html,
    result: basis_http_probe_result(spec["artifact_policy"], value,
      prepared["metadata"], prepared["body_hex"], html)
  });
}

fn probe_deliver < C, T > (result: Result<ProbeRun<T>, ProbeRunError>,
    handler: ProbeHandler<C, T>) -> Result<ProbeRun<T>, ProbeRunError>
{
  match result with {
    Ok(value) => {
      let deliver = handler["deliver"];
      deliver(value["result"], handler["context"]);
    },
    Err(_) => {}
  };
  return result;
}

fn basis_http_probe_run < T > (probe: Probe<T>, host: ProbeHost) -> Result<ProbeRun<T>, ProbeRunError>
{
  return probe_run(probe, host, variant<Option<ProbeArtifactSink>>(None, record {}));
}

# Calls the result handler once, synchronously, and only with the final
# policy-projected success. Context and closures stay in this process.
fn basis_http_probe_run_with < C, T > (probe: Probe<T>, host: ProbeHost,
    handler: ProbeHandler<C, T>) -> Result<ProbeRun<T>, ProbeRunError>
{
  return probe_deliver(basis_http_probe_run(probe, host), handler);
}

fn basis_http_probe_run_artifact_with < C, T > (probe: Probe<T>, host: ProbeHost,
    sink: ProbeArtifactSink, handler: ProbeHandler<C, T>) -> Result<ProbeRun<T>, ProbeRunError>
{
  return probe_deliver(probe_run(probe, host, variant<Option<ProbeArtifactSink>>(Some, sink)),
    handler);
}

fn basis_http_probe_run_html < C, T > (probe: Probe<T>, host: ProbeHost,
    handler: ProbeHandler<C, T>) -> Result<BasisHtml, ProbeRunError>
{
  return match basis_http_probe_run_with(probe, host, handler) with {
    Ok(run) => variant<Result<BasisHtml, ProbeRunError>>(Ok, run["document"]),
    Err(error) => variant<Result<BasisHtml, ProbeRunError>>(Err, error)
  };
}

fn basis_http_probe_run_result < C, T > (probe: Probe<T>, host: ProbeHost,
    handler: ProbeHandler<C, T>) -> Result<ProbeResult<T>, ProbeRunError>
{
  return match basis_http_probe_run_with(probe, host, handler) with {
    Ok(run) => variant<Result<ProbeResult<T>, ProbeRunError>>(Ok, run["result"]),
    Err(error) => variant<Result<ProbeResult<T>, ProbeRunError>>(Err, error)
  };
}

fn probe_batch_failure(index: i64, cause: ProbeBatchCause) -> Result<i64, ProbeBatchError>
{
  return variant<Result<i64, ProbeBatchError>>(Err,
    record<ProbeBatchError>{index: index, cause: cause});
}

# A bounded sequential group, not a background scanner or concurrent engine.
# The caller supplies one independently configured target per index. Stop on
# the first failure; earlier successful handler effects are not rolled back.
fn basis_http_probe_run_targets < C, T > (targets: ProbeTargets<T>, host: ProbeHost,
    handler: ProbeHandler<C, T>) -> Result<i64, ProbeBatchError>
{
  let count = targets["count"];
  if count < 1 || count > 8 {
    return probe_batch_failure(-1, variant<ProbeBatchCause>(ProbeBatchBadCount, record {}));
  }
  let at = targets["at"];
  for index in 0 .. count {
    let probe = match at(index) with {
      Some(value) => value,
      None() => {
        return probe_batch_failure(index,
          variant<ProbeBatchCause>(ProbeBatchMissingTarget, record {}));
      }
    };
    match basis_http_probe_run_with(probe, host, handler) with {
      Ok(_) => {},
      Err(error) => {
        return probe_batch_failure(index, variant<ProbeBatchCause>(ProbeBatchRunFailure, error));
      }
    };
  }
  return variant<Result<i64, ProbeBatchError>>(Ok, count);
}
