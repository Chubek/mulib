from . . .html.html import BasisHtml, basis_html_serialize;
from ._ArtifactTrusted import on1x_http_probe_artifact_write_v1;

enum ProbeArtifactError {
  ArtifactInvalid, ArtifactDenied, ArtifactLimit, ArtifactExists,
  ArtifactSerialization(i64), ArtifactIo
}

enum ProbeArtifactOutcome {
  ArtifactSaved, ArtifactUncertain, ArtifactRejected(ProbeArtifactError)
}

# Write-once publication of serialized canonical HTML, not live response bytes
# or sanitized content. The trusted host independently maps the slot to a
# preauthorized destination in a private workspace.
fn basis_http_probe_save_html(slot: string, document: BasisHtml) -> ProbeArtifactOutcome
{
  let (status, markup) = basis_html_serialize(document);
  if status != 0 {
    return variant<ProbeArtifactOutcome>(ArtifactRejected,
      variant<ProbeArtifactError>(ArtifactSerialization, status));
  }
  let rc = on1x_http_probe_artifact_write_v1(slot, markup);
  if rc == 0 { return variant<ProbeArtifactOutcome>(ArtifactSaved, record {}); }
  if rc == 1 { return variant<ProbeArtifactOutcome>(ArtifactUncertain, record {}); }
  let error = match rc with {
    -1 => variant<ProbeArtifactError>(ArtifactInvalid, record {}),
    -2 => variant<ProbeArtifactError>(ArtifactDenied, record {}),
    -3 => variant<ProbeArtifactError>(ArtifactLimit, record {}),
    -4 => variant<ProbeArtifactError>(ArtifactExists, record {}),
    _ => variant<ProbeArtifactError>(ArtifactIo, record {})
  };
  return variant<ProbeArtifactOutcome>(ArtifactRejected, error);
}
