# Optional adapter. Importing std.http.probe does not load this module.
from . . .core.Pervasive import Result;
from . . .elvi.elvi import ElviProgram;
from . . .elvi.document import BasisElviDocument;
from . . .elvi.live import basis_elvi_live_fetch;
from .execution import FetchBackend, ProbeRequest;

fn probe_live_capture(program: ElviProgram, request: ProbeRequest)
    -> Result<BasisElviDocument, i64>
{
  return basis_elvi_live_fetch(program, request["url"], request["max_body_bytes"]);
}

# In addition to the Probe authorizer, this requires Elvi's mandatory native
# host authorizer at link time. The adapter supplies no network authority.
fn basis_http_probe_live_backend() -> FetchBackend
{
  return record<FetchBackend>{capture: probe_live_capture};
}
