from std.http.probe.artifact import basis_http_probe_save_html;
from std.html import HTML, basis_html_parse;

extern fn artifact_fixture_init() -> i64;
extern fn artifact_fixture_check() -> i64;

fn main()
{
  assert(artifact_fixture_init() == 1);
  let doc: HTML = match basis_html_parse("<p>hello</p>") with {
    Ok(parsed) => parsed,
    Err(_) => { assert(false); return; }
  };
  match basis_http_probe_save_html("primary", doc) with {
    ArtifactSaved() => {},
    _ => assert(false)
  };
  match basis_http_probe_save_html("primary", doc) with {
    ArtifactRejected(ArtifactExists()) => {},
    _ => assert(false)
  };
  match basis_http_probe_save_html("../escape", doc) with {
    ArtifactRejected(ArtifactInvalid()) => {},
    _ => assert(false)
  };
  match basis_http_probe_save_html("unknown", doc) with {
    ArtifactRejected(ArtifactDenied()) => {},
    _ => assert(false)
  };
  match basis_http_probe_save_html("symlink", doc) with {
    ArtifactRejected(ArtifactDenied()) => {},
    _ => assert(false)
  };
  assert(artifact_fixture_check() == 1);
  println("Probe artifact: ok");
}
