from std.html import BasisHtml;
from std.http.probe import Probe, ProbeSpec, ProbeParseError, ProbeArtifactPolicy,
  ProbeHost, ProbeRequest, basis_http_probe_run;
from std.http.probe.live import basis_http_probe_live_backend;

# Counter functions from Elvi's socket-free TLS/HTTP wire fixture only.
extern fn live_fixture_authorizations() -> i64;
extern fn live_fixture_connects() -> i64;
extern fn live_fixture_closes() -> i64;

fn main()
{
  let spec = record<ProbeSpec>{
    source: "elvi fixture\nhost example.org\nhome https://example.org/document\nmode document\nartifacts capture\n",
    max_body_bytes: 16,
    artifact_policy: variant<ProbeArtifactPolicy>(RetainBoth, record {})
  };
  let parse = fn(document: BasisHtml) -> Result<i64, ProbeParseError> {
    assert(false);
    return variant<Result<i64, ProbeParseError>>(Ok, 0);
  };
  let probe = record<Probe<i64>>{spec: spec, parse: parse};
  let backend = basis_http_probe_live_backend();
  let denied_host = record<ProbeHost>{
    authorize: fn(request: ProbeRequest) -> bool { return false; },
    backend: backend
  };
  let denied = basis_http_probe_run(probe, denied_host);
  assert(match denied with {
    Err(error) => match error with { ProbeDenied() => true, _ => false },
    _ => false
  });
  assert(live_fixture_authorizations() == 0 && live_fixture_connects() == 0);
  let allowed_host = record<ProbeHost>{
    authorize: fn(request: ProbeRequest) -> bool {
      return request["url"] == "https://example.org/document" && request["max_body_bytes"] == 16;
    },
    backend: backend
  };
  # Elvi consumes a complete authenticated fixture response containing a NUL;
  # the real HTML parser must reject it without calling the application parser.
  let failed = basis_http_probe_run(probe, allowed_host);
  assert(match failed with {
    Err(error) => match error with { ProbeHtmlFailure(_) => true, _ => false },
    _ => false
  });
  assert(live_fixture_authorizations() == 1 && live_fixture_connects() == 1 && live_fixture_closes() == 1);
}
