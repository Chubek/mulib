import std.http.probe as ProbeApi;
import std.elvi.elvi as Elvi;
import std.elvi.document as Document;
import std.html as Html;

fn source() -> string
{
  return "elvi fixture\nhost example.test\nhome https://example.test/status\nmode document\nartifacts capture\n";
}

fn body() -> string
{
  return "3c503e68656c6c6f3c2f503e"; # <P>hello</P>
}

fn authorized(request: ProbeApi.ProbeRequest) -> bool
{
  println(1);
  return request["url"] == "https://example.test/status" && request["host"] == "example.test";
}

fn probe_host(case: i64) -> ProbeApi.ProbeHost
{
  let authorize = fn(request: ProbeApi.ProbeRequest) -> bool {
    if case == 1 { println(1); return false; }
    return authorized(request);
  };
  let capture = fn(program: Elvi.ElviProgram, request: ProbeApi.ProbeRequest)
      -> Result<Document.BasisElviDocument, i64>
  {
    println(2);
    assert(program["source"] == source() && request["max_body_bytes"] == 4096);
    if case == 2 { return variant<Result<Document.BasisElviDocument, i64>>(Err, 99); }
    var url = request["url"];
    if case == 3 { url = "https://example.test/elsewhere"; }
    var content_type = "Text/HTML; charset=utf-8";
    if case == 4 { content_type = "text/htmlx"; }
    if case == 10 { content_type = "text/html; charset=iso-8859-1"; }
    var status = 200;
    if case == 5 { status = 404; }
    var length = 12;
    var hex = body();
    if case == 6 { length = 1; hex = "00"; }
    if case == 7 { length = 4097; }
    return variant<Result<Document.BasisElviDocument, i64>>(Ok,
      record<Document.BasisElviDocument>{
        metadata: record<Document.BasisElviDocumentMetadata>{
          status: status, requested_url: url, effective_url: url, content_type: content_type,
          http_protocol: "HTTP/1.1", alpn: "http/1.1", tls_version: 772,
          certificate_verified: true, hostname_verified: true, body_length: length,
          chunked: false, close_delimited: false
        },
        body_hex: hex
      });
  };
  return record<ProbeApi.ProbeHost>{
    authorize: authorize, backend: record<ProbeApi.FetchBackend>{capture: capture}
  };
}

fn fixture_probe(program: string, limit: i64, case: i64, policy: ProbeApi.ProbeArtifactPolicy)
    -> ProbeApi.Probe<i64>
{
  # Build the public record directly to test validation at the execution boundary.
  let spec = record<ProbeApi.ProbeSpec>{source: program, max_body_bytes: limit, artifact_policy: policy};
  let parse = fn(html: Html.BasisHtml) -> Result<i64, ProbeApi.ProbeParseError> {
    println(3);
    let selected = Html.basis_html_xpath(html, "/html/body/p");
    assert(match selected with {
      Ok(nodes) => {
        let (rc, count) = Html.basis_html_selection_count(nodes);
        rc == 0 && count == 1
      },
      Err(_) => false
    });
    if case == 8 {
      return variant<Result<i64, ProbeApi.ProbeParseError>>(Err,
        record<ProbeApi.ProbeParseError>{message: "declined by parser"});
    }
    return variant<Result<i64, ProbeApi.ProbeParseError>>(Ok, 42);
  };
  return record<ProbeApi.Probe<i64>>{spec: spec, parse: parse};
}

fn fixture_handler(want_raw: bool, want_html: bool) -> ProbeApi.ProbeHandler<string, i64>
{
  let callback = fn(result: ProbeApi.ProbeResult<i64>, context: string) -> void {
    println(4);
    assert(context == "local");
    assert(result["value"] == 42 && result["metadata"]["status"] == 200);
    let (status, canonical) = Html.basis_html_serialize(result["document"]);
    assert(status == 0 && text_len(canonical) > 0);
    assert(match result["raw"] with { None() => !want_raw, Some(bytes) => want_raw && bytes == body() });
    assert(match result["html"] with { None() => !want_html, Some(_) => want_html });
  };
  return record<ProbeApi.ProbeHandler<string, i64>>{context: "local", deliver: callback};
}

fn execute(program: string, limit: i64, case: i64, policy: ProbeApi.ProbeArtifactPolicy,
    want_raw: bool, want_html: bool) -> Result<ProbeApi.ProbeRun<i64>, ProbeApi.ProbeRunError>
{
  return ProbeApi.basis_http_probe_run_with(fixture_probe(program, limit, case, policy),
    probe_host(case), fixture_handler(want_raw, want_html));
}

fn expect_error(case: i64, result: Result<ProbeApi.ProbeRun<i64>, ProbeApi.ProbeRunError>)
{
  assert(match result with {
    Err(error) => match error with {
      ProbeInvalidSpec(_) => case == 0,
      ProbeDenied() => case == 1,
      ProbeCaptureFailure(code) => case == 2 && code == 99,
      ProbeInvalidDocument() => case == 3 || case == 7,
      ProbeUnsupportedMedia() => case == 4 || case == 10,
      ProbeHttpFailure(code) => case == 5 && code == 404,
      ProbeHtmlFailure(_) => case == 6,
      ProbeParserFailure(detail) => case == 8 && detail["message"] == "declined by parser",
      ProbeUnsupportedCookies() => case == 9,
      ProbeArtifactSinkRequired() => case == 20,
      ProbeArtifactDenied() => case == 21,
      ProbeArtifactWriteUncertain() => case == 23,
      _ => false
    },
    Ok(_) => false
  });
}

fn fixture_sink(case: i64) -> ProbeApi.ProbeArtifactSink
{
  let authorize = fn(effect: ProbeApi.ProbeArtifactRequest, request: ProbeApi.ProbeRequest) -> bool {
    println(5);
    assert(effect["destination"] == "slot" && request["host"] == "example.test");
    assert(match effect["action"] with { ProbeArtifactAtomicSave() => true, _ => false });
    return case != 21;
  };
  let write = fn(effect: ProbeApi.ProbeArtifactRequest, document: Html.BasisHtml)
      -> ProbeApi.ProbeArtifactEffect
  {
    println(6);
    assert(effect["destination"] == "slot");
    let (rc, serialized) = Html.basis_html_serialize(document);
    assert(rc == 0 && text_len(serialized) > 0);
    if case == 23 {
      return variant<ProbeApi.ProbeArtifactEffect>(ProbeArtifactUncertain, record {});
    }
    return variant<ProbeApi.ProbeArtifactEffect>(ProbeArtifactCommitted, record {});
  };
  return record<ProbeApi.ProbeArtifactSink>{authorize: authorize, write: write};
}

fn artifact_execution()
{
  let policy = variant<ProbeApi.ProbeArtifactPolicy>(SaveHtmlAtomic, "slot");
  let probe = fixture_probe(source(), 4096, 0, policy);
  let host = probe_host(0);
  let handler = fixture_handler(false, false);
  println(20);
  expect_error(20, ProbeApi.basis_http_probe_run_with(probe, host, handler));
  for case in 21 .. 25 {
    println(case);
    let select_probe = match case with {
      24 => fixture_probe(source(), 4096, 8, policy),
      _ => probe
    };
    let result = ProbeApi.basis_http_probe_run_artifact_with(select_probe, host, fixture_sink(case), handler);
    if case == 22 {
      assert(match result with { Ok(_) => true, Err(_) => false });
    } else {
      let expected = match case with { 24 => 8, _ => case };
      expect_error(expected, result);
    }
  }
}

fn batch_execution()
{
  let policy = variant<ProbeApi.ProbeArtifactPolicy>(DiscardArtifacts, record {});
  let probe = fixture_probe(source(), 4096, 0, policy);
  let second = fixture_probe(
    "elvi fixture\nhost denied.test\nhome https://denied.test/status\nmode document\nartifacts capture\n",
    4096, 0, policy);
  let host = probe_host(0);
  let handler = fixture_handler(false, false);
  let at = fn(index: i64) -> Option<ProbeApi.Probe<i64>> {
    println(7);
    let selected = match index with { 0 => probe, _ => second };
    return variant<Option<ProbeApi.Probe<i64>>>(Some, selected);
  };
  println(30);
  let out_of_bounds = record<ProbeApi.ProbeTargets<i64>>{count: 9, at: at};
  assert(match ProbeApi.basis_http_probe_run_targets(out_of_bounds, host, handler) with {
    Err(error) => error["index"] == -1,
    _ => false
  });
  println(31);
  let two = record<ProbeApi.ProbeTargets<i64>>{count: 2, at: at};
  assert(match ProbeApi.basis_http_probe_run_targets(two, host, handler) with {
    Err(error) => error["index"] == 1 && match error["cause"] with {
      ProbeBatchRunFailure(cause) => match cause with { ProbeDenied() => true, _ => false },
      _ => false
    },
    _ => false
  });
  println(32);
  assert(match probe::basis_http_probe_run(host, handler) with {
    Ok(html) => {
      let (rc, serialized) = Html.basis_html_serialize(html);
      rc == 0 && text_len(serialized) > 0
    },
    _ => false
  });
  println(33);
  assert(match probe::basis_http_probe_run_result(host, handler) with {
    Ok(result) => result["value"] == 42,
    _ => false
  });
}

fn main()
{
  let discard = variant<ProbeApi.ProbeArtifactPolicy>(DiscardArtifacts, record {});
  let raw = variant<ProbeApi.ProbeArtifactPolicy>(RetainRaw, record {});
  let html = variant<ProbeApi.ProbeArtifactPolicy>(RetainHtml, record {});
  let both = variant<ProbeApi.ProbeArtifactPolicy>(RetainBoth, record {});
  assert(match execute(source(), 4096, 0, discard, false, false) with {
    Ok(run) => {
      let document = run::basis_http_probe_run_document();
      let (rc, serialized) = Html.basis_html_serialize(document);
      rc == 0 && text_len(serialized) > 0
    },
    Err(_) => false
  });
  assert(match execute(source(), 4096, 0, raw, true, false) with { Ok(_) => true, Err(_) => false });
  assert(match execute(source(), 4096, 0, html, false, true) with { Ok(_) => true, Err(_) => false });
  assert(match execute(source(), 4096, 0, both, true, true) with { Ok(_) => true, Err(_) => false });
  println(10);
  expect_error(0, execute(source(), 0, 0, discard, false, false));
  expect_error(0, execute(
    "elvi fixture\nhost example.test\nhome https://example.test/\nmode scrape\nartifacts discard\nxpath provide{mulib-xpath}\nlogic lua{/fixture.lua}\nforward ipc{/fixture.sock}\n",
    4096, 0, discard, false, false));
  expect_error(9, execute(text_concat(source(), "cookies provide{/fixture.cookie}\n"),
    4096, 0, discard, false, false));
  for case in 1 .. 9 {
    println(10 + case);
    expect_error(case, execute(source(), 4096, case, discard, false, false));
  }
  println(19);
  expect_error(10, execute(source(), 4096, 10, discard, false, false));
  artifact_execution();
  batch_execution();
}
