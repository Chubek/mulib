from . .__init__ import ProbeHandler, ProbeResult;

fn wrong_handler(result: ProbeResult<i64>, expected: i64) -> bool
{
  return result["value"] == expected;
}

fn main()
{
  # A delivery callback is a void effect, not a second application parser.
  let invalid = record<ProbeHandler<i64, i64>>{context: 42, deliver: wrong_handler};
}
