from . .__init__ import ProbeSpec, ProbeArtifactPolicy, ProbeParseError, basis_http_probe_make;

fn parse_bytes(body: string) -> Result<i64, ProbeParseError>
{
  return variant<Result<i64, ProbeParseError>>(Ok, text_len(body));
}

fn main()
{
  let spec = record<ProbeSpec>{
    source: "", max_body_bytes: 4096,
    artifact_policy: variant<ProbeArtifactPolicy>(DiscardArtifacts, record {})
  };
  # The parser takes normalized BasisHtml, not the transport's raw string.
  let invalid = basis_http_probe_make(spec, parse_bytes);
}
