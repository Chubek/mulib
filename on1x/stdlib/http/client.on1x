# Explicit-link client for trusted C11 programs. See README.md.
extern fn on1x_http_exchange_v1(url: string, head: i64) -> string;

# (error, HTTP status, header lines, body hex).
# Reconstruct one result from a single immutable reply; no "last result" slots.
fn basis_http_exchange(url: string, head: i64) -> (i64, i64, string, string)
{
  let reply = on1x_http_exchange_v1(url, head);
  let n = text_len(reply);
  if n == 2 && text_byte(reply, 0) == 45
  {
    let digit = text_byte(reply, 1) - 48;
    if digit >= 1 && digit <= 6 { return (-digit, 0, "", ""); }
  }
  if n < 5 || text_byte(reply, 3) != 10 { return (-6, 0, "", ""); }
  var status = 0;
  for i in 0 .. 3
  {
    let digit = text_byte(reply, i) - 48;
    if digit < 0 || digit > 9 { return (-6, 0, "", ""); }
    status = status * 10 + digit;
  }
  if status < 100 || status > 599 { return (-6, 0, "", ""); }
  var sep = 4;
  while sep < n
  {
    if text_byte(reply, sep - 1) == 10 && text_byte(reply, sep) == 10
    {
      var headers = "";
      var body = "";
      if sep != 4 { headers = text_slice(reply, 4, sep); }
      if sep + 1 != n { body = text_slice(reply, sep + 1, n); }
      return (0, status, headers, body);
    }
    sep = sep + 1;
  }
  return (-6, 0, "", "");
}

fn basis_http_get(url: string) -> (i64, i64, string, string)
{
  return basis_http_exchange(url, 0);
}

fn basis_http_head(url: string) -> (i64, i64, string, string)
{
  return basis_http_exchange(url, 1);
}
