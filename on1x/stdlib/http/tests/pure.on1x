import std.http as H;

fn main()
{
  assert(H.success(200) && H.success(299));
  assert(!H.success(199) && !H.success(300));
  let (found, value) = H.header("X-Test:yes:no\nx-test:other\n", "x-TeST");
  assert(found && value == "yes:no");
  let (empty_found, empty) = H.header("Bad\nTest:\n", "test");
  assert(empty_found && empty == "");
  let (absent, nothing) = H.header("X-Test:yes\n", "X-Tes");
  assert(!absent && nothing == "");
  assert(H.body_byte("00ff80", 0) == 0);
  assert(H.body_byte("00ff80", 1) == 255);
  assert(H.body_byte("00ff80", 2) == 128);
  assert(H.body_byte("01", 9223372036854775807) == -1);
  assert(H.body_byte("01", -9223372036854775807) == -1);
  assert(H.body_byte("00f", 0) == -1);
  assert(H.body_byte("xx", 0) == -1);
}
