import std.http as H;
import std.http.client as Client;

fn show(response: (i64, i64, string, string))
{
  let (error, status, headers, body) = response;
  println(error);
  println(status);
  println(H.success(status));
  let (have_header, value) = H.header(headers, "x-MiXeD");
  println(have_header);
  println(value);
  let (have_empty, empty) = H.header(headers, "x-empty");
  println(have_empty && text_len(empty) == 0);
  println(body);
  println(H.body_byte(body, 1));
}

fn main()
{
  let url = io_stdin();
  if text_len(url) != 0 && text_byte(url, 0) == 72
  {
    show(Client.basis_http_head(text_slice(url, 1, text_len(url))));
  }
  else { show(Client.basis_http_get(url)); }
}
