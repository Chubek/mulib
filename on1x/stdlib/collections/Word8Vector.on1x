import "Vector.on1x";
# Checked word8 vector encoded as sexpr list of decimal atoms.
# Exposes immutable storage in this experimental On1x profile.
fn basis_word8_vector_length(v:sexpr)->i64 { return basis_vector_length(v); }
fn basis_word8_vector_from_list(v:sexpr)->sexpr { return basis_vector_from_list(v); }
