import "Array.on1x";
fn basis_bool_array_new(n: i64, initial: bool) -> i64
{
  if initial
  {
    return basis_array_array(n, 1);
  }
  return basis_array_array(n, 0);
}
fn basis_bool_array_sub(h: i64, i: i64) -> bool
{
  return basis_array_sub(h, i) != 0;
}
fn basis_bool_array_update(h: i64, i: i64, value: bool)
{
  if value
  {
    basis_array_update(h, i, 1);
  }
  else
  {
    basis_array_update(h, i, 0);
  }
}
