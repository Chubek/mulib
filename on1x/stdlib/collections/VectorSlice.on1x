import "Vector.on1x";
# Portable immutable slice as pair of start and length over a sexpr vector.
fn basis_vector_slice(v:sexpr,start:i64,length:i64)->sexpr {
  if start<0 || length<0 || start>basis_vector_length(v) || length>basis_vector_length(v)-start { tool_fail("vector slice bounds"); }
  return basis_list_take(basis_list_drop(v,start),length);
}
