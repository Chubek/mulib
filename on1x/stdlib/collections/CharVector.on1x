import "../text/String.on1x";
# Immutable char vector reuses current byte-oriented String.
fn basis_char_vector_length(s:string)->i64 { return text_len(s); }
fn basis_char_vector_sub(s:string,i:i64)->i64 { return text_byte(s,i); }
fn basis_char_vector_slice(s:string,start:i64,n:i64)->string { return basis_string_substring(s,start,n); }
