import "Array.on1x";
fn basis_word8_array_new(n: i64, initial: i64) -> i64
{
  if initial < 0 || initial > 255
  {
    tool_fail("word8 array value must be 0..255");
  }
  return basis_array_array(n, initial);
}

fn basis_word8_array_update(h: i64, i: i64, v: i64)
{
  if v < 0 || v > 255
  {
    tool_fail("word8 array value must be 0..255");
  }
  basis_array_update(h, i, v);
}

fn basis_word8_array_sub(h: i64, i: i64) -> i64
{
  return basis_array_sub(h, i);
}

fn basis_word8_array_destroy(h: i64)
{
  basis_array_destroy(h);
}
