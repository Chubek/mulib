# Unique heap storage backed by On1x's own<Nominal> lifecycle.
record Box < T >
{
  value: T
}

fn basis_box_new < T > (value: T) -> own < Box < T > >
{
  return box(record < Box < T > >
  {
    value: value
  });
}

# Copy the payload, not the owner or its address.
fn basis_box_get < T > (owner: borrow Box < T >) -> T
{
  return owner["value"];
}

fn basis_box_replace < T > (owner: ref Box < T >, value: T) -> T
{
  let previous = ref_replace(owner, record < Box < T > >
  {
    value: value
  });
  return previous["value"];
}

# Exchange a uniquely owned payload without copying it or reallocating the
# outer box. The parameter and the previous payload each transfer once.
fn basis_box_exchange_box < T > (owner: ref Box < own < Box < T > > >, value: own < Box < T > >) -> own < Box < T > >
{
  let previous = ref_replace(owner, record < Box < own < Box < T > > > >
  {
    value: move(value)
  });
  return match previous with { record{value:item} => move(item) };
}

# Consume and free the box, returning its payload.
fn basis_box_into_inner < T > (owner: own < Box < T > >) -> T
{
  let contents = take(owner);
  return contents["value"];
}
