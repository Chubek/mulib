# A bounded native file operation, not an owned FD type or raw-handle registry.
from . .core.Pervasive import Option, Result;

enum BasisForeignFileError
{
  ForeignInvalid, ForeignOpenFailed, ForeignNotRegular,
  ForeignReadFailed, ForeignCloseFailed
}

extern fn on1x_container_file_byte_at(path: string, offset: i64) -> i64;

fn basis_foreign_file_byte_at(path: string, offset: i64) -> Result<Option<u8>, BasisForeignFileError>
{
  let code = on1x_container_file_byte_at(path, offset);
  if code >= 0 && code <= 255
  {
    return variant<Result<Option<u8>, BasisForeignFileError>>(Ok,
      variant<Option<u8>>(Some, u8_from_i64(code)));
  }
  if code == 256
  {
    return variant<Result<Option<u8>, BasisForeignFileError>>(Ok,
      variant<Option<u8>>(None, record {}));
  }
  return variant<Result<Option<u8>, BasisForeignFileError>>(Err, match code with
  {
    status if status == -1 => variant<BasisForeignFileError>(ForeignInvalid, record {}),
    status if status == -2 => variant<BasisForeignFileError>(ForeignOpenFailed, record {}),
    status if status == -3 => variant<BasisForeignFileError>(ForeignNotRegular, record {}),
    status if status == -5 => variant<BasisForeignFileError>(ForeignCloseFailed, record {}),
    _ => variant<BasisForeignFileError>(ForeignReadFailed, record {})
  });
}
