# Opaque marker. The standard module loader supplies the checked C11
# operations; this record's representation is not accessible to On1x.
record Rc < T >
{
}

# Legacy shared immutable S-expression graphs use the runtime's existing RC;
# this is not a general shared heap or an atomic/cross-thread owner.
record RcSExpr
{
  node: sexpr
}

fn basis_rc_sexpr_new(node: sexpr) -> RcSExpr
{
  return record < RcSExpr >
  {
    node: node
  };
}

fn basis_rc_sexpr_clone(owner: borrow RcSExpr) -> RcSExpr
{
  return record < RcSExpr >
  {
    node: owner["node"]
  };
}

fn basis_rc_sexpr_get(owner: borrow RcSExpr) -> sexpr
{
  return owner["node"];
}
