# MuLIB YAML 1.2-inspired subset, not full YAML; bridge serializes as JSON.
extern fn on1x_mulib_yaml_to_json(text: string) -> string;
fn yaml_as_json(text: string) -> string { return on1x_mulib_yaml_to_json(text); }
import "../_bridge/status.on1x";
fn basis_yaml_as_json(text:string)->(i64,string) {
 let value=on1x_mulib_yaml_to_json(text);return (on1x_mulib_bridge_status(),value);
}
