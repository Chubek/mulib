import std.operator.utils as U;
from ...core.Pervasive import Result;

fn positive(value: i64) -> bool
{
  return value > 0;
}

fn bool_number(value: bool) -> i64
{
  if value
  {
    return 42;
  }
  return -1;
}

fn binary(flag: bool, value: i64) -> i64
{
  if flag
  {
    return value + 1;
  }
  return value - 1;
}

fn tupled(pair: (bool, i64)) -> i64
{
  let(flag, value) = pair;
  return binary(flag, value);
}

fn checked_positive(value: i64) -> Result<bool, i64>
{
  if value >= 0
  {
    return U.basis_operator_result_ok(positive(value));
  }
  return U.basis_operator_result_error(-9);
}

fn checked_number(value: bool) -> Result<i64, i64>
{
  if value
  {
    return U.basis_operator_result_ok(bool_number(value));
  }
  return U.basis_operator_result_error(-2);
}

fn unexpected_map(value: i64) -> bool
{
  assert(value >= 0);
  return positive(value);
}

fn unexpected_chain(value: i64) -> Result<bool, i64>
{
  assert(value >= 0);
  return checked_positive(value);
}

fn main()
{
  assert(U.basis_operator_apply(positive, 11));
  assert(U.basis_operator_apply(bool_number, false) == -1);
  assert(U.basis_operator_compose(bool_number, positive)(7) == 42);
  assert(U.basis_operator_compose(positive, bool_number)(false) == false);
  assert(U.basis_operator_flip(binary)(9, false) == 8);
  assert(U.basis_operator_curry(tupled)(true)(2) == 3);
  assert(U.basis_operator_uncurry(U.basis_operator_curry(tupled))((false, 4)) == 3);

  let source: Result<i64, i64> = U.basis_operator_result_ok(3);
  let failure: Result<i64, i64> = U.basis_operator_result_error(-17);
  let lifted: fn(i64) -> Result<bool, i64> = U.basis_operator_result_lift(positive);
  assert(match lifted(5) with { Ok(flag) => flag, Err(_) => false });

  let mapped = U.basis_operator_result_map(source, positive);
  assert(match mapped with { Ok(flag) => flag, Err(_) => false });
  let map_error = U.basis_operator_result_map(failure, unexpected_map);
  assert(match map_error with { Ok(_) => false, Err(code) => code == -17 });

  let chained = U.basis_operator_result_chain(source, checked_positive);
  assert(match chained with { Ok(flag) => flag, Err(_) => false });
  let chain_error = U.basis_operator_result_chain(failure, unexpected_chain);
  assert(match chain_error with { Ok(_) => false, Err(code) => code == -17 });

  let composed = U.basis_operator_result_compose(checked_number, checked_positive);
  assert(match composed(6) with { Ok(value) => value == 42, Err(_) => false });
  assert(match composed(0) with { Ok(_) => false, Err(code) => code == -2 });
  assert(match composed(-1) with { Ok(_) => false, Err(code) => code == -9 });
}
