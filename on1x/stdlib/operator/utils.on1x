from ..core.Pervasive import Result;

fn basis_operator_apply<A, B>(function: fn(A) -> B, value: A) -> B
{
  return function(value);
}

fn basis_operator_compose<A, B, C>(outer: fn(B) -> C, inner: fn(A) -> B) -> fn(A) -> C
{
  return fn(value: A) -> C
  {
    return outer(inner(value));
  };
}

fn basis_operator_flip<A, B, C>(function: fn(A, B) -> C) -> fn(B, A) -> C
{
  return fn(second: B, first: A) -> C
  {
    return function(first, second);
  };
}

fn basis_operator_curry<A, B, C>(function: fn((A, B)) -> C) -> fn(A) -> fn(B) -> C
{
  return fn(first: A) -> fn(B) -> C
  {
    return fn(second: B) -> C
    {
      return function((first, second));
    };
  };
}

fn basis_operator_uncurry<A, B, C>(function: fn(A) -> fn(B) -> C) -> fn((A, B)) -> C
{
  return fn(pair: (A, B)) -> C
  {
    let(first, second) = pair;
    return function(first)(second);
  };
}

fn basis_operator_result_ok<A, E>(value: A) -> Result<A, E>
{
  return variant<Result<A, E>>(Ok, value);
}

fn basis_operator_result_error<A, E>(error: E) -> Result<A, E>
{
  return variant<Result<A, E>>(Err, error);
}

fn basis_operator_result_lift<A, B, E>(function: fn(A) -> B) -> fn(A) -> Result<B, E>
{
  return fn(value: A) -> Result<B, E>
  {
    return variant<Result<B, E>>(Ok, function(value));
  };
}

fn basis_operator_result_map<A, B, E>(value: Result<A, E>, function: fn(A) -> B) -> Result<B, E>
{
  return match value with
  {
    Ok(item) => variant<Result<B, E>>(Ok, function(item)),
    Err(error) => variant<Result<B, E>>(Err, error)
  };
}

fn basis_operator_result_chain<A, B, E>(value: Result<A, E>, function: fn(A) -> Result<B, E>) -> Result<B, E>
{
  return match value with
  {
    Ok(item) => function(item),
    Err(error) => variant<Result<B, E>>(Err, error)
  };
}

fn basis_operator_result_compose<A, B, C, E>(
  outer: fn(B) -> Result<C, E>,
  inner: fn(A) -> Result<B, E>) -> fn(A) -> Result<C, E>
{
  return fn(value: A) -> Result<C, E>
  {
    return basis_operator_result_chain(inner(value), outer);
  };
}
