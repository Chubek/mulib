import "syntax.on1x";
import "../source.on1x";
import "metadata.on1x";

# Internal models never escape as runtime evidence. Only ordinary typed functions
# and explicit evidence requests are emitted; the host independently substitutes
# interface binders and checks every generated function after inference.
fn ppx_category_substitute(type: sexpr, concrete: sexpr) -> sexpr {
  if visitor_tag(type)=="SelfSlot" { return concrete; }return type;
}
fn ppx_category_collect_declarations(carriers: sexpr) -> (sexpr,sexpr) {
  var protocols=sx_nil();var witnesses=sx_nil();var heads=sx_nil();var names=sx_nil();var spans=carriers;var count=0;
  while sx_kind(spans)==3 {
    let carrier=sx_head(spans);spans=sx_tail(spans);
    if sx_text(sexpr_nth(carrier,1))!="Protocols" { tool_fail("ON1X-CAT-PPX: wrong carrier owner"); }
    var tokens=ppx_read_tokens(carrier);
    while ppx_peek(tokens)!="<eof>" {
      count=count+1;if count>64 { ppx_token_error(tokens,"ON1X-CAT-OBLIGATION","declaration budget exhausted"); }
      if ppx_peek(tokens)=="protocol" {
        let (protocol,end)=ppx_category_parse_protocol(tokens);let name=sx_text(sexpr_nth(protocol,1));
        if sx_kind(ppx_lookup(protocols,name))!=0 { ppx_token_error(tokens,"ON1X-CAT-PROTOCOL","duplicate nominal protocol"); }
        protocols=sx_cons(ppx_list2(sx_string(name),protocol),protocols);tokens=end;
      }else {
        if ppx_peek(tokens)!="impl"&&ppx_peek(tokens)!="witness" { ppx_token_error(tokens,"ON1X-CAT-SYNTAX","only protocol/impl/witness declarations are supported; generics, inheritance and associated types require typed metadata"); }
        let (witness,end)=ppx_category_parse_witness(tokens);let name=sx_text(sexpr_nth(witness,1));
        if sx_kind(ppx_lookup(names,name))!=0 { ppx_token_error(tokens,"ON1X-CAT-COHERENCE","duplicate witness name"); }
        names=sx_cons(ppx_list2(sx_string(name),sx_symbol("1")),names);
        if sx_text(sexpr_nth(witness,6))=="true" {
          let head=text_concat(sx_text(sexpr_nth(witness,2)),text_concat("<",text_concat(sx_text(sexpr_nth(witness,3)),">")));
          if sx_kind(ppx_lookup(heads,head))!=0 { ppx_token_error(tokens,"ON1X-CAT-COHERENCE","overlapping canonical implementation"); }
          heads=sx_cons(ppx_list2(sx_string(head),sx_symbol("1")),heads);
        }
        witnesses=sx_cons(witness,witnesses);tokens=end;
      }
    }
  }
  return (protocols,sexpr_reverse(witnesses));
}
fn ppx_category_function(name: string, params: sexpr, result: sexpr, body: sexpr, at: sexpr) -> sexpr {
  return ppx_node("Function",sx_cons(sx_string(name),sx_cons(params,sx_cons(result,ppx_list3(body,sx_nil(),at)))));
}
fn ppx_category_fact(kind: string, name: string, identity: string, at: sexpr) -> sexpr {
  return ppx_node("ExtensionFact",sx_cons(sx_string("Protocols"),ppx_list4(sx_string(kind),sx_string(name),sx_string(identity),at)));
}
fn ppx_category_expand(packet: sexpr) -> sexpr {
  if visitor_tag(packet)!="ModuleSyntax" { tool_fail("ON1X-CAT-PPX: expected ModuleSyntax"); }
  let origin=sx_text(sexpr_nth(packet,2));let (protocols,witnesses)=ppx_category_collect_declarations(sexpr_nth(packet,4));
  let prefix=ppx_source_prefix(sx_text(sexpr_nth(packet,5)));
  var provenance=sexpr_nth(packet,4);
  while sx_kind(provenance)==3 {
    if sx_text(sexpr_nth(sexpr_nth(sx_head(provenance),3),1))!=origin { tool_fail("ON1X-CAT-PPX: carrier/module origin mismatch"); }
    provenance=sx_tail(provenance);
  }
  var names=sx_nil();var rest=sexpr_nth(packet,3);var functions=sx_nil();var facts=sx_nil();var serial=0;var emitted=0;
  var contracts=sx_nil();var implementations=sx_nil();
  while sx_kind(rest)==3 { names=sx_cons(ppx_list2(sx_head(rest),sx_symbol("1")),names);rest=sx_tail(rest); }
  rest=protocols;
  while sx_kind(rest)==3 {
    let protocol=sexpr_nth(sx_head(rest),1);let name=sx_text(sexpr_nth(protocol,1));let id=text_concat(origin,text_concat("::protocol::",name));
     facts=sx_cons(ppx_category_fact("protocol",name,id,sexpr_nth(protocol,3)),facts);rest=sx_tail(rest);
     contracts=sx_cons(ppx_category_emit_metadata(protocol),contracts);
  }
  rest=witnesses;
  while sx_kind(rest)==3 {
    let witness=sx_head(rest);rest=sx_tail(rest);let name=sx_text(sexpr_nth(witness,1));let protocol_name=sx_text(sexpr_nth(witness,2));
    let at=sexpr_nth(witness,5);let target=sx_text(sexpr_nth(witness,3));let concrete=ppx_category_scalar(target);
    let found=ppx_lookup(protocols,protocol_name);
    if sx_kind(found)==0 { ppx_diagnostic(at,"ON1X-CAT-COHERENCE",text_concat("protocol is not defined in this module (cross-module evidence/orphans unsupported): ",protocol_name)); }
    let protocol=sx_head(found);let requirements=sexpr_nth(protocol,2);let members=sexpr_nth(witness,4);
    if sexpr_size(requirements)!=sexpr_size(members) { ppx_diagnostic(at,"ON1X-CAT-WITNESS",text_concat(protocol_name,": missing/extra protocol members")); }
    let id=text_concat(origin,text_concat("::protocol::",text_concat(protocol_name,text_concat("::",text_concat(target,text_concat("::witness::",name))))));
    facts=sx_cons(ppx_category_fact("witness",name,id,at),facts);
    var methods=members;var bindings=sx_nil();
    while sx_kind(methods)==3 {
      let method=sx_head(methods);methods=sx_tail(methods);let member_name=sx_text(sexpr_nth(method,1));var wanted=sx_nil();var pending=requirements;
      let location=sexpr_nth(method,5);let context=text_concat(protocol_name,text_concat("<",text_concat(target,text_concat(">.",text_concat(member_name,": ")))));
      while sx_kind(pending)==3 { let candidate=sx_head(pending);if sx_text(sexpr_nth(candidate,1))==member_name { wanted=candidate; }pending=sx_tail(pending); }
      if sx_kind(wanted)==0 { ppx_diagnostic(location,"ON1X-CAT-WITNESS",text_concat(context,"unexpected protocol member")); }
      var actual=sexpr_nth(method,2);var expected=sexpr_nth(wanted,2);var params=sx_nil();var arguments=sx_nil();
      if sexpr_size(actual)!=sexpr_size(expected) { ppx_diagnostic(location,"ON1X-CAT-WITNESS",text_concat(context,"member arity mismatch")); }
      while sx_kind(actual)==3 {
        let param=sx_head(actual);let type=ppx_category_substitute(sexpr_nth(sx_head(expected),2),concrete);
        if sexpr_print(type)!=sexpr_print(sexpr_nth(param,2)) { ppx_diagnostic(location,"ON1X-CAT-WITNESS",text_concat(context,"member parameter type mismatch")); }
        let parameter_name=sx_text(sexpr_nth(param,1));let where=sexpr_nth(param,3);
        params=sx_cons(ppx_node("Parameter",ppx_list3(sx_string(parameter_name),type,where)),params);
        arguments=sx_cons(ppx_ident(parameter_name,where),arguments);actual=sx_tail(actual);expected=sx_tail(expected);
      }
      let result=ppx_category_substitute(sexpr_nth(wanted,3),concrete);
      if sexpr_print(result)!=sexpr_print(sexpr_nth(method,3)) { ppx_diagnostic(location,"ON1X-CAT-WITNESS",text_concat(context,"member result type mismatch")); }
      let exported=text_concat(name,text_concat("_",member_name));
      if sx_kind(ppx_lookup(names,exported))!=0 { ppx_diagnostic(location,"ON1X-CAT-WITNESS",text_concat("generated selector collision: ",exported)); }
      names=sx_cons(ppx_list2(sx_string(exported),sx_symbol("1")),names);
      let (helper,next)=ppx_fresh_prefixed(packet,prefix,serial);serial=next;let ps=sexpr_reverse(params);
      functions=sx_cons(ppx_category_function(helper,ps,result,sexpr_nth(method,4),location),functions);
      let call=ppx_call(helper,sexpr_reverse(arguments),location);var statement=ppx_node("Return",ppx_list2(call,location));
      if visitor_tag(result)=="VoidType" { statement=ppx_node("Do",ppx_list2(call,location)); }
      let body=ppx_node("Block",ppx_list2(ppx_list1(statement),location));
      functions=sx_cons(ppx_category_function(exported,ps,result,body,location),functions);
      bindings=sx_cons(ppx_node("EvidenceBinding",ppx_list4(sx_string(member_name),sx_string(helper),sx_string(exported),location)),bindings);
      emitted=emitted+2;if emitted>256 { tool_fail("ON1X-CAT-OBLIGATION: generated function budget exhausted"); }
    }
    implementations=sx_cons(ppx_node("EvidenceImplementation",sx_cons(sx_string(name),sx_cons(sx_string(protocol_name),
      ppx_list4(ppx_list1(concrete),sexpr_nth(witness,6),sexpr_reverse(bindings),at)))),implementations);
  }
  let core=ppx_node("Unit",ppx_list2(sx_symbol("1"),sexpr_reverse(functions)));
  return ppx_node("ModuleEvidenceExpansion",sx_cons(sx_symbol("1"),sx_cons(sx_string(origin),
    ppx_list4(core,sexpr_reverse(facts),sexpr_reverse(contracts),sexpr_reverse(implementations)))));
}
