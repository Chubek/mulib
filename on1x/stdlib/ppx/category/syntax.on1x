import "../tokens.on1x";

fn ppx_category_name(tokens: sexpr) -> (string,sexpr) {
  let name=ppx_peek(tokens);if !ppx_name(name) || text_len(name)>128 { ppx_token_error(tokens,"ON1X-CAT-SYNTAX","expected bounded identifier"); }
  return (name,sx_tail(tokens));
}
fn ppx_category_scalar(name: string) -> sexpr {
  if name=="i64" { return ppx_node("I64Type",sx_nil()); }if name=="bool" { return ppx_node("BoolType",sx_nil()); }
  if name=="u8" { return ppx_node("U8Type",sx_nil()); }if name=="u16" { return ppx_node("U16Type",sx_nil()); }
  if name=="u32" { return ppx_node("U32Type",sx_nil()); }if name=="u64" { return ppx_node("U64Type",sx_nil()); }
  if name=="f32" { return ppx_node("F32Type",sx_nil()); }if name=="f64" { return ppx_node("F64Type",sx_nil()); }
  if name=="void" { return ppx_node("VoidType",sx_nil()); }return sx_nil();
}
fn ppx_category_type(tokens: sexpr, self: bool) -> (sexpr,sexpr) {
  let name=ppx_peek(tokens);if self && name=="Self" { return (ppx_node("SelfSlot",sx_nil()),sx_tail(tokens)); }
  let type=ppx_category_scalar(name);if sx_kind(type)==0 { ppx_token_error(tokens,"ON1X-CAT-PROTOCOL","only concrete numeric/bool types and bound Self are supported"); }
  return (type,sx_tail(tokens));
}
fn ppx_category_precedence(op: string) -> i64 {
  if op=="||" { return 1; }if op=="&&" { return 2; }if op=="=="||op=="!=" { return 3; }
  if op=="<"||op==">"||op=="<="||op==">=" { return 4; }if op=="+"||op=="-" { return 5; }
  if op=="*"||op=="/"||op=="%" { return 6; }return 0;
}
fn ppx_category_expression(tokens: sexpr, minimum: i64, depth: i64) -> (sexpr,sexpr) {
  if depth>=64 { ppx_token_error(tokens,"ON1X-CAT-OBLIGATION","expression depth budget exhausted"); }
  let at=ppx_source_location(tokens);let text=ppx_peek(tokens);var rest=sx_tail(tokens);var value=sx_nil();
  if text=="-"||text=="!" {
    if text=="-"&&ppx_peek(rest)=="9223372036854775808" { value=ppx_integer("-9223372036854775808",at);rest=sx_tail(rest); }else {
      let (operand,end)=ppx_category_expression(rest,7,depth+1);rest=end;value=ppx_node("Unary",ppx_list3(sx_symbol(text),operand,at));
    }
  }else {
    if text=="(" { let (inner,end)=ppx_category_expression(rest,1,depth+1);value=inner;rest=ppx_expect(end,")"); }else {
      if text=="true"||text=="false" { value=ppx_node("BooleanLiteral",ppx_list2(sx_symbol(text),at)); }else {
        if text_len(text)>0 && ppx_digit(text_byte(text,0)) {
          var kind="DecimalLiteral";
          if ppx_scalar(sx_string(text),"UnsignedSpelling") { kind="UnsignedLiteral"; }else {
            if ppx_scalar(sx_string(text),"FloatSpelling") { kind="FloatLiteral"; }else {
              if text_len(text)>2 && text_byte(text,0)==48 && (text_byte(text,1)==120||text_byte(text,1)==88) { kind="HexLiteral"; }
            }
          }
          value=ppx_node(kind,ppx_list2(sx_string(text),at));
        }else { if !ppx_name(text) { ppx_token_error(tokens,"ON1X-CAT-SYNTAX","unsupported expression"); }value=ppx_ident(text,at); }
      }
    }
  }
  var nodes=0;
  while ppx_peek(rest)=="(" {
    rest=sx_tail(rest);var args=sx_nil();var count=0;
    while ppx_peek(rest)!=")" {
      let (arg,end)=ppx_category_expression(rest,1,depth+1);rest=end;args=sx_cons(arg,args);count=count+1;
      if count>16 { ppx_token_error(rest,"ON1X-CAT-OBLIGATION","call arity budget exhausted"); }
      if ppx_peek(rest)!=")" { rest=ppx_expect(rest,","); }
    }
    rest=ppx_expect(rest,")");value=ppx_node("Call",ppx_list3(value,sexpr_reverse(args),at));nodes=nodes+1;
    if nodes>64 { ppx_token_error(rest,"ON1X-CAT-OBLIGATION","call chain budget exhausted"); }
  }
  while ppx_category_precedence(ppx_peek(rest))>=minimum {
    let op=ppx_peek(rest);let where=ppx_source_location(rest);let precedence=ppx_category_precedence(op);
    let (right,end)=ppx_category_expression(sx_tail(rest),precedence+1,depth+1);rest=end;
    value=ppx_node("Binary",ppx_list4(sx_symbol(op),value,right,where));nodes=nodes+1;
    if nodes>64 { ppx_token_error(rest,"ON1X-CAT-OBLIGATION","expression growth budget exhausted"); }
  }
  return (value,rest);
}
fn ppx_category_block(tokens: sexpr, depth: i64) -> (sexpr,sexpr) {
  if depth>=32 { ppx_token_error(tokens,"ON1X-CAT-OBLIGATION","block depth budget exhausted"); }
  let at=ppx_source_location(tokens);var rest=ppx_expect(tokens,"{");var body=sx_nil();var count=0;
  while ppx_peek(rest)!="}" {
    count=count+1;if count>256 { ppx_token_error(rest,"ON1X-CAT-OBLIGATION","statement budget exhausted"); }
    let where=ppx_source_location(rest);let kind=ppx_peek(rest);
    if kind=="return" {
      rest=sx_tail(rest);
      if ppx_peek(rest)==";" { body=sx_cons(ppx_node("ReturnVoid",ppx_list1(where)),body); }else {
        let (value,end)=ppx_category_expression(rest,1,0);rest=end;body=sx_cons(ppx_node("Return",ppx_list2(value,where)),body);
      }
      rest=ppx_expect(rest,";");
    }else {
      if kind=="if" {
        let (condition,end)=ppx_category_expression(sx_tail(rest),1,0);let (yes,after)=ppx_category_block(end,depth+1);rest=after;
        var no=ppx_node("Block",ppx_list2(sx_nil(),where));
        if ppx_peek(rest)=="else" { let (other,finish)=ppx_category_block(sx_tail(rest),depth+1);no=other;rest=finish; }
        body=sx_cons(ppx_node("If",ppx_list4(condition,yes,no,where)),body);
      }else {
        if kind=="let"||kind=="var" {
          let (name,end)=ppx_category_name(sx_tail(rest));rest=end;var type=ppx_node("Inferred",sx_nil());
          if ppx_peek(rest)==":" { let (annotation,after)=ppx_category_type(sx_tail(rest),false);type=annotation;rest=after; }
          rest=ppx_expect(rest,"=");let (value,after)=ppx_category_expression(rest,1,0);rest=ppx_expect(after,";");
          var tag="Let";if kind=="var" { tag="Var"; }body=sx_cons(ppx_node(tag,ppx_list4(sx_string(name),type,value,where)),body);
        }else {
          let (value,end)=ppx_category_expression(rest,1,0);rest=ppx_expect(end,";");body=sx_cons(ppx_node("Do",ppx_list2(value,where)),body);
        }
      }
    }
  }
  return (ppx_node("Block",ppx_list2(sexpr_reverse(body),at)),ppx_expect(rest,"}"));
}
fn ppx_category_members(tokens: sexpr, abstract: bool) -> (sexpr,sexpr) {
  var rest=ppx_expect(tokens,"{");var members=sx_nil();var names=sx_nil();var count=0;
  while ppx_peek(rest)!="}" {
    let at=ppx_source_location(rest);rest=ppx_expect(rest,"fn");let (name,end)=ppx_category_name(rest);rest=ppx_expect(end,"(");
    if sx_kind(ppx_lookup(names,name))!=0 { ppx_token_error(rest,"ON1X-CAT-PROTOCOL","duplicate member"); }
    names=sx_cons(ppx_list2(sx_string(name),sx_symbol("1")),names);var params=sx_nil();var parameter_names=sx_nil();var arity=0;
    while ppx_peek(rest)!=")" {
      let where=ppx_source_location(rest);let (param,after)=ppx_category_name(rest);rest=ppx_expect(after,":");
      if sx_kind(ppx_lookup(parameter_names,param))!=0 { ppx_token_error(rest,"ON1X-CAT-PROTOCOL","duplicate parameter name"); }
      parameter_names=sx_cons(ppx_list2(sx_string(param),sx_symbol("1")),parameter_names);
      let (type,finish)=ppx_category_type(rest,abstract);rest=finish;
      if visitor_tag(type)=="VoidType" { ppx_token_error(rest,"ON1X-CAT-PROTOCOL","void parameter"); }
      params=sx_cons(ppx_node("Parameter",ppx_list3(sx_string(param),type,where)),params);arity=arity+1;
      if arity>16 { ppx_token_error(rest,"ON1X-CAT-PROTOCOL","parameter budget exhausted"); }
      if ppx_peek(rest)!=")" { rest=ppx_expect(rest,","); }
    }
    rest=ppx_expect(ppx_expect(rest,")"),"->");let (result,after)=ppx_category_type(rest,abstract);rest=after;var body=sx_nil();
    if abstract { rest=ppx_expect(rest,";"); }else { let (block,finish)=ppx_category_block(rest,0);body=block;rest=finish; }
    members=sx_cons(ppx_node("Member",sx_cons(sx_string(name),ppx_list4(sexpr_reverse(params),result,body,at))),members);
    count=count+1;if count>16 { ppx_token_error(rest,"ON1X-CAT-PROTOCOL","member budget exhausted"); }
  }
  if count==0 { ppx_token_error(rest,"ON1X-CAT-PROTOCOL","empty member set"); }
  return (sexpr_reverse(members),ppx_expect(rest,"}"));
}
fn ppx_category_parse_protocol(tokens: sexpr) -> (sexpr,sexpr) {
  let at=ppx_source_location(tokens);let (name,after)=ppx_category_name(ppx_expect(tokens,"protocol"));
  let rest=ppx_expect(ppx_expect(ppx_expect(after,"<"),"Self"),">");
  let (members,end)=ppx_category_members(rest,true);return (ppx_node("Protocol",ppx_list3(sx_string(name),members,at)),end);
}
fn ppx_category_parse_witness(tokens: sexpr) -> (sexpr,sexpr) {
  let at=ppx_source_location(tokens);var rest=tokens;var protocol="";var name="";var canonical=false;var concrete="";
  if ppx_peek(rest)=="impl" {
    canonical=true;let (p,after)=ppx_category_name(sx_tail(rest));protocol=p;rest=ppx_expect(after,"for");
    let (type,finish)=ppx_category_name(rest);concrete=type;rest=finish;name=text_concat(p,text_concat("_",type));
  }else {
    rest=ppx_expect(rest,"witness");let (w,after)=ppx_category_name(rest);name=w;rest=ppx_expect(after,":");
    let (p,end)=ppx_category_name(rest);protocol=p;rest=ppx_expect(end,"<");let (type,finish)=ppx_category_name(rest);concrete=type;rest=ppx_expect(finish,">");
  }
  let type=ppx_category_scalar(concrete);if sx_kind(type)==0||concrete=="void" { ppx_token_error(tokens,"ON1X-CAT-WITNESS","unsupported witness target type"); }
  let (members,end)=ppx_category_members(rest,false);
  var flag="false";if canonical { flag="true"; }
  return (ppx_node("Witness",sx_cons(sx_string(name),sx_cons(sx_string(protocol),sx_cons(sx_string(concrete),ppx_list3(members,at,sx_symbol(flag)))))),end);
}
