module std.base.ordering;

public fn base_compare_i64(a: i64, b: i64) -> i64
{
  if a < b
  {
    return - 1;
  }
  if a > b
  {
    return 1;
  }
  return 0;
}

public fn base_sign_i64(value: i64) -> i64
{
  if value < 0
  {
    return - 1;
  }
  if value > 0
  {
    return 1;
  }
  return 0;
}

public fn base_clamp_i64(value: i64, low: i64, high: i64) -> i64
{
  assert(low <= high);
  if value < low
  {
    return low;
  }
  if value > high
  {
    return high;
  }
  return value;
}
