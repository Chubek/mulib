# Bounded structural validation for the S-expression-backed extension APIs.
fn basis_shape_list(items:sexpr)->i64 {
 var rest=items;var n=0;
 while sx_kind(rest)==3{n=n+1;if n>262144{tool_fail("list exceeds work bound");}rest=sx_tail(rest);}
 if sx_kind(rest)!=0{tool_fail("expected a proper list");}return n;
}
fn basis_shape_text(item:sexpr) {
 if sx_kind(item)!=2{tool_fail("expected a string atom");}
}
fn basis_shape_pair(item:sexpr) {
 if sx_kind(item)!=3{tool_fail("expected a two-element list");}
 let rest=sx_tail(item);
 if sx_kind(rest)!=3{tool_fail("expected a two-element list");}
 if sx_kind(sx_tail(rest))!=0{tool_fail("expected a two-element list");}
}
