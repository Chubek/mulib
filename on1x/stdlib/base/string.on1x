fn base_string_is_empty(value: string) -> bool
{
  return text_len(value) == 0;
}

fn base_string_starts_with(value: string, prefix: string) -> bool
{
  return basis_string_is_prefix(prefix, value);
}

fn base_string_ends_with(value: string, suffix: string) -> bool
{
  return basis_string_is_suffix(suffix, value);
}

fn base_string_contains(value: string, needle: string) -> bool
{
  return basis_string_contains(value, needle);
}

import "../text/String.on1x";
