# Persistent S-expression sequence; bounded scalar helpers.
fn base_sequence_singleton(x: sexpr) -> sexpr
{
  return sx_cons(x, sx_nil());
}
fn base_sequence_append(left: sexpr, right: sexpr) -> sexpr
{
  basis_list_length(left);
  basis_list_length(right);
  return basis_list_append(left, right);
}
import "../collections/List.on1x";
