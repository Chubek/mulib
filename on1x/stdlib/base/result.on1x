fn base_ok(value: sexpr) -> sexpr
{
  return sx_cons(sx_symbol("ok"), sx_cons(value, sx_nil()));
}
fn base_error(message: string) -> sexpr
{
  return sx_cons(sx_symbol("error"), sx_cons(sx_string(message), sx_nil()));
}
fn basis_result_validate(value: sexpr)
{
  basis_shape_pair(value);
  let tag = sx_head(value);
  if sx_kind(tag) != 1 || (sx_text(tag) != "ok" && sx_text(tag) != "error")
  {
    tool_fail("invalid result tag");
  }
  if sx_text(tag) == "error"
  {
    basis_shape_text(sx_head(sx_tail(value)));
  }
}
fn base_result_ok(value: sexpr) -> bool
{
  basis_result_validate(value);
  return sx_text(sx_head(value)) == "ok";
}
fn base_result_payload(value: sexpr) -> sexpr
{
  basis_result_validate(value);
  return sx_head(sx_tail(value));
}
fn basis_result_map(value: sexpr, f: fn(sexpr) -> sexpr) -> sexpr
{
  if ! base_result_ok(value)
  {
    return value;
  }
  return base_ok(f(base_result_payload(value)));
}
fn basis_result_and_then(value: sexpr, f: fn(sexpr) -> sexpr) -> sexpr
{
  if ! base_result_ok(value)
  {
    return value;
  }
  let out = f(base_result_payload(value));
  basis_result_validate(out);
  return out;
}
import "shape.on1x";
