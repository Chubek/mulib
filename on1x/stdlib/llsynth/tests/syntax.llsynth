.language "SyntaxFixture"
.skip /[ \t\r\n]+/
.token TEXT: String = /[a-z]+/
.token LINE: String = /^@@[a-z]+$/
.token NUL: String = /\x00/
.token UTF8: String = /\xc3\xa9/
.token NUMBER: Int = /[0-9]+/
.precedence nonassoc "<"

.rule Document
'syntax: Statements EOF
'semantics: return 1 / 0;
.end
.rule Statements
'syntax: Statements Statement ";" |
.end
.rule Statement
'syntax: "if" TEXT | TEXT | LINE | NUL | UTF8 | NUMBER | "[" Expr "]"
.end
.rule Expr
'syntax: Expr "<" Expr | NUMBER
.end
