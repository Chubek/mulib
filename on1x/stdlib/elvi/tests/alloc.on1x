import std.elvi as E;

fn main()
{
  let input = "elvi fixture\nhost example.org\nhome https://example.org/\nsearch https://example.org/?q={query}\nanchor any\n";
  let resource_error = match E.basis_elvi_compile(input) with {
    Ok(program) => match E.basis_elvi_extract_search(program, "<p>empty</p>", 1) with {
      Err(error) => match error["code"] with { ElviResource() => true, _ => false },
      Ok(_) => false
    },
    Err(_) => false
  };
  assert(resource_error);
}
