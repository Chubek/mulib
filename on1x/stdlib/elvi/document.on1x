from . .core.Pervasive import Result;

# A data snapshot from an explicit trusted transport. It is not authority to
# fetch, proof of TLS by itself, or a view of a discarded script artifact.
record BasisElviDocumentMetadata
{
  status: i64,
  requested_url: string,
  effective_url: string,
  content_type: string,
  http_protocol: string,
  alpn: string,
  tls_version: i64,
  certificate_verified: bool,
  hostname_verified: bool,
  body_length: i64,
  chunked: bool,
  close_delimited: bool
}

record BasisElviDocument
{
  metadata: BasisElviDocumentMetadata,
  body_hex: string
}

fn basis_elvi_document_metadata_valid(metadata: BasisElviDocumentMetadata) -> bool
{
  let status = metadata["status"];
  let url = metadata["requested_url"];
  let url_len = text_len(url);
  let content_type = metadata["content_type"];
  let type_len = text_len(content_type);
  if status < 200 || status >= 600 || (status >= 300 && status < 400) ||
      url_len < 9 || url_len >= 8192 || url != metadata["effective_url"] ||
      text_slice(url, 0, 8) != "https://" ||
      type_len >= 256 || metadata["http_protocol"] != "HTTP/1.1" ||
      (metadata["alpn"] != "" && metadata["alpn"] != "http/1.1") ||
      (metadata["tls_version"] != 771 && metadata["tls_version"] != 772) ||
      !metadata["certificate_verified"] || !metadata["hostname_verified"] ||
      metadata["body_length"] < 0 || metadata["body_length"] > 2097152 ||
      (metadata["chunked"] && metadata["close_delimited"])
  {
    return false;
  }
  for i in 8 .. url_len
  {
    let byte = text_byte(url, i);
    if byte < 33 || byte > 126 || byte == 35 || byte == 92
    {
      return false;
    }
  }
  for i in 0 .. type_len
  {
    let byte = text_byte(content_type, i);
    if byte != 9 && (byte < 32 || byte > 126)
    {
      return false;
    }
  }
  return true;
}

fn basis_elvi_capture_hex_valid(body_hex: string, byte_count: i64) -> bool
{
  let n = text_len(body_hex);
  if byte_count < 0 || byte_count > 2097152 || n != 2 * byte_count
  {
    return false;
  }
  for i in 0 .. n
  {
    let byte = text_byte(body_hex, i);
    if (byte < 48 || byte > 57) && (byte < 97 || byte > 102)
    {
      return false;
    }
  }
  return true;
}

fn basis_elvi_document_valid(document: BasisElviDocument) -> bool
{
  let metadata = document["metadata"];
  return basis_elvi_document_metadata_valid(metadata) &&
    basis_elvi_capture_hex_valid(document["body_hex"], metadata["body_length"]);
}

fn basis_elvi_document_from_hex(metadata: BasisElviDocumentMetadata, body_hex: string) ->
    Result<BasisElviDocument, i64>
{
  if !basis_elvi_document_metadata_valid(metadata) ||
      !basis_elvi_capture_hex_valid(body_hex, metadata["body_length"])
  {
    return variant<Result<BasisElviDocument, i64>>(Err, 1);
  }
  return variant<Result<BasisElviDocument, i64>>(Ok,
    record<BasisElviDocument> { metadata: metadata, body_hex: body_hex });
}
