from . .core.Pervasive import Option, Result;
from .elvi import ElviProgram, ElviProfile, ElviMode, ElviFormat, ElviError, ElviErrorCode,
  ElviStage, ElviStageKind, ElviSearchResults, basis_elvi_compile, basis_elvi_inspect,
  basis_elvi_load, basis_elvi_stage, basis_elvi_extract_search,
  elvi_error, elvi_number, elvi_field_end, elvi_bridge_error;

enum ElviAnchor { ElviAnyAnchor, ElviChildTag, ElviParentTag }
enum ElviRewrite { ElviDirect, ElviGoogle, ElviRelative }
record ElviSearchTemplate { text: string }
record ElviHtmlSelectors { anchor: ElviAnchor, tag: string, anchor_class: Option<string> }
record ElviJsonSelectors { results: string, title: string, url: string }
enum ElviSelectors { ElviSelectHtml(ElviHtmlSelectors), ElviSelectJson(ElviJsonSelectors) }
record ElviExclusions { count: i64, snapshot: string }
record ElviSearchSpec
{
  template: ElviSearchTemplate, selectors: ElviSelectors, rewrite: ElviRewrite,
  excluded_hosts: ElviExclusions, max_results: i64
}
record ElviProvider { profile: ElviProfile, program: ElviProgram }

# Compiled identity/profile snapshot plus replayable source; no FFI owner.
# Do not trust caller-constructed fields as authorization.
record ElviScript { program: ElviProgram, profile: ElviProfile }

extern fn on1x_elvi_search_spec_v1(source: string) -> string;

fn elvi_exclusion_at(wire: string, at: i64, count: i64, index: i64) -> (bool, i64, i64)
{
  let n = text_len(wire);
  if count < 0 || count > 8 || at < 0 || at > n { return (false, 0, 0); }
  var pos = at;
  var start = 0;
  var end = 0;
  for i in 0 .. count {
    let next = elvi_field_end(wire, pos, n, 1, 253);
    if next < 0 { return (false, 0, 0); }
    if index == i { start = pos + 6; end = next; }
    pos = next;
  }
  return (pos == n, start, end);
}

fn basis_elvi_excluded_host(exclusions: ElviExclusions, index: i64) -> Option<string>
{
  let count = exclusions["count"];
  if index < 0 || index >= count { return variant<Option<string>>(None, record {}); }
  let wire = exclusions["snapshot"];
  let (ok, start, end) = elvi_exclusion_at(wire, 0, count, index);
  if !ok { return variant<Option<string>>(None, record {}); }
  return variant<Option<string>>(Some, text_slice(wire, start, end));
}

fn basis_elvi_search_spec(program: ElviProgram) -> Result<Option<ElviSearchSpec>, ElviError>
{
  let wire = on1x_elvi_search_spec_v1(program["source"]);
  if wire == "N" {
    return variant<Result<Option<ElviSearchSpec>, ElviError>>(Ok, variant<Option<ElviSearchSpec>>(None, record {}));
  }
  let n = text_len(wire);
  if n < 15 || n >= 7000 || text_byte(wire, 0) != 79 {
    return variant<Result<Option<ElviSearchSpec>, ElviError>>(Err, elvi_error(wire));
  }
  let tag = text_byte(wire, 1);
  let rewrite = text_byte(wire, 2);
  let max_results = elvi_number(wire, 3, n);
  let count = elvi_number(wire, 9, n);
  let template_end = elvi_field_end(wire, 15, n, 1, 4095);
  let json = tag == 74;
  var a_cap = 31;
  var b_min = 0;
  var b_cap = 127;
  var c_min = 0;
  var c_cap = 0;
  if json {
    a_cap = 255; b_min = 1; b_cap = 255; c_min = 1; c_cap = 255;
  }
  let a_end = elvi_field_end(wire, template_end, n, 1, a_cap);
  let b_end = elvi_field_end(wire, a_end, n, b_min, b_cap);
  let c_end = elvi_field_end(wire, b_end, n, c_min, c_cap);
  let (ok, unused_start, unused_end) = elvi_exclusion_at(wire, c_end, count, -1);
  if !ok || max_results < 1 || max_results > 64 ||
     (!json && tag != 65 && tag != 67 && tag != 80) ||
     (rewrite != 68 && rewrite != 82 && (rewrite != 71 || json)) {
    return variant<Result<Option<ElviSearchSpec>, ElviError>>(Err, elvi_bridge_error());
  }
  let template = record<ElviSearchTemplate>{text: text_slice(wire, 21, template_end)};
  let selectors = match json with {
    true => variant<ElviSelectors>(ElviSelectJson, record<ElviJsonSelectors>{
      results: text_slice(wire, template_end + 6, a_end),
      title: text_slice(wire, a_end + 6, b_end), url: text_slice(wire, b_end + 6, c_end)
    }),
    false => {
      let anchor = match tag with {
        byte if byte == 67 => variant<ElviAnchor>(ElviChildTag, record {}),
        byte if byte == 80 => variant<ElviAnchor>(ElviParentTag, record {}),
        _ => variant<ElviAnchor>(ElviAnyAnchor, record {})
      };
      let css_class = match a_end + 6 == b_end with {
        true => variant<Option<string>>(None, record {}),
        false => variant<Option<string>>(Some, text_slice(wire, a_end + 6, b_end))
      };
      variant<ElviSelectors>(ElviSelectHtml, record<ElviHtmlSelectors>{
        anchor: anchor, tag: text_slice(wire, template_end + 6, a_end), anchor_class: css_class
      })
    }
  };
  let typed_rewrite = match rewrite with {
    byte if byte == 71 => variant<ElviRewrite>(ElviGoogle, record {}),
    byte if byte == 82 => variant<ElviRewrite>(ElviRelative, record {}),
    _ => variant<ElviRewrite>(ElviDirect, record {})
  };
  let spec = record<ElviSearchSpec>{
    template: template, selectors: selectors, rewrite: typed_rewrite, max_results: max_results,
    excluded_hosts: record<ElviExclusions>{count: count, snapshot: text_slice(wire, c_end, n)}
  };
  return variant<Result<Option<ElviSearchSpec>, ElviError>>(Ok, variant<Option<ElviSearchSpec>>(Some, spec));
}

fn basis_elvi_provider(program: ElviProgram) -> Result<ElviProvider, ElviError>
{
  let profile = basis_elvi_inspect(program)?;
  return variant<Result<ElviProvider, ElviError>>(Ok,
    record<ElviProvider>{profile: profile, program: program});
}

fn basis_elvi_provider_search(provider: ElviProvider) -> Result<Option<ElviSearchSpec>, ElviError>
{
  return basis_elvi_search_spec(provider["program"]);
}

fn basis_elvi_provider_stage(provider: ElviProvider, kind: ElviStageKind) -> Result<Option<ElviStage>, ElviError>
{
  return basis_elvi_stage(provider["program"], kind);
}

fn basis_elvi_script_from_program(program: ElviProgram) -> Result<ElviScript, ElviError>
{
  let profile = basis_elvi_inspect(program)?;
  return variant<Result<ElviScript, ElviError>>(Ok, record<ElviScript>{program: program, profile: profile});
}

fn basis_elvi_script_provider(script: ElviScript) -> Result<ElviProvider, ElviError>
{
  return basis_elvi_provider(script["program"]);
}

fn basis_elvi_script_compile(source: string) -> Result<ElviScript, ElviError>
{
  let program = basis_elvi_compile(source)?;
  return basis_elvi_script_from_program(program);
}

fn basis_elvi_compile_buffer(source: buffer) -> Result<ElviProgram, ElviError>
{
  let length = buffer_len(source);
  if length > 65536 {
    return variant<Result<ElviProgram, ElviError>>(Err, record<ElviError>{
      code: variant<ElviErrorCode>(ElviInvalid, record {}), line: 0,
      message: "profile source exceeds 65536 bytes"
    });
  }
  var line = 1;
  for i in 0 .. length {
    let byte = u8_to_i64(buffer_at(source, i));
    if byte == 0 {
      return variant<Result<ElviProgram, ElviError>>(Err, record<ElviError>{
        code: variant<ElviErrorCode>(ElviSyntax, record {}), line: line,
        message: "profile source contains a NUL byte"
      });
    }
    if byte == 10 { line = line + 1; }
  }
  return basis_elvi_compile(buffer_text(source));
}

fn basis_elvi_script_compile_buffer(source: buffer) -> Result<ElviScript, ElviError>
{
  let program = basis_elvi_compile_buffer(source)?;
  return basis_elvi_script_from_program(program);
}

fn basis_elvi_script_load(path: string, approved_path: string,
    read_text: fn(string, i64) -> Result<string, ElviError>) -> Result<ElviScript, ElviError>
{
  let program = basis_elvi_load(path, approved_path, read_text)?;
  return basis_elvi_script_from_program(program);
}

# A document type is selected by the caller, but the compiled format must
# match the adapter before it is called. HTML and JSON never share a nominal
# input type or silently fall back to the other parser.
record ElviExtractor < D > { format: ElviFormat, source: fn(D) -> string }
record ElviHtmlInput { html: string }
record ElviJsonInput { json: string }

fn elvi_html_source(input: ElviHtmlInput) -> string { return input["html"]; }
fn elvi_json_source(input: ElviJsonInput) -> string { return input["json"]; }

fn basis_elvi_html_extractor() -> ElviExtractor<ElviHtmlInput>
{
  return record<ElviExtractor<ElviHtmlInput>>{
    format: variant<ElviFormat>(ElviHtml, record {}), source: elvi_html_source
  };
}

fn basis_elvi_json_extractor() -> ElviExtractor<ElviJsonInput>
{
  return record<ElviExtractor<ElviJsonInput>>{
    format: variant<ElviFormat>(ElviJson, record {}), source: elvi_json_source
  };
}

fn basis_elvi_extract_with < D > (program: ElviProgram, document: D, limit: i64,
    extractor: ElviExtractor<D>) -> Result<ElviSearchResults, ElviError>
{
  let profile = basis_elvi_inspect(program)?;
  let expected = extractor["format"];
  let matches = match profile["format"] with {
    Some(ElviHtml()) => match expected with { ElviHtml() => true, _ => false },
    Some(ElviJson()) => match expected with { ElviJson() => true, _ => false },
    _ => false
  };
  if !matches {
    return variant<Result<ElviSearchResults, ElviError>>(Err, record<ElviError>{
      code: variant<ElviErrorCode>(ElviModeMismatch, record {}), line: 0,
      message: "document representation does not match search profile"
    });
  }
  if limit < 1 || limit > profile["max_results"] {
    return variant<Result<ElviSearchResults, ElviError>>(Err, record<ElviError>{
      code: variant<ElviErrorCode>(ElviInvalid, record {}), line: 0,
      message: "search limit outside profile bounds"
    });
  }
  let snapshot = extractor["source"];
  return basis_elvi_extract_search(program, snapshot(document), limit);
}
