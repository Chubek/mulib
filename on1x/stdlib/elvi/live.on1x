from . .core.Pervasive import Result;
from .elvi import ElviProgram;
from .document import BasisElviDocument, BasisElviDocumentMetadata, basis_elvi_document_from_hex;
from ._LiveTrusted import on1x_elvi_live_snapshot_v1;

fn elvi_live_decimal(wire: string, pos: i64, end: i64) -> i64
{
  if pos > end - 6 { return -1; }
  var value = 0;
  for i in pos .. pos + 6 {
    let byte = text_byte(wire, i);
    if byte < 48 || byte > 57 { return -1; }
    value = value * 10 + byte - 48;
  }
  return value;
}

fn elvi_live_field(wire: string, pos: i64, end: i64, limit: i64) -> (i64, string)
{
  let count = elvi_live_decimal(wire, pos, end);
  if count < 0 || count > limit || count > end - pos - 6 { return (-1, ""); }
  let next = pos + 6 + count;
  return (next, text_slice(wire, pos + 6, next));
}

fn elvi_live_error(wire: string, end: i64) -> i64
{
  if end != 2 || text_byte(wire, 0) != 69 { return -10; }
  let kind = text_byte(wire, 1);
  if kind == 73 { return -1; } # invalid
  if kind == 68 { return -2; } # denied
  if kind == 67 { return -3; } # credentials
  if kind == 84 { return -4; } # TLS
  if kind == 78 { return -5; } # transport
  if kind == 82 { return -6; } # response
  if kind == 77 { return -7; } # redirect
  if kind == 76 { return -8; } # limit
  if kind == 65 { return -9; } # allocation
  return -10;                 # inconsistent bridge reply
}

# Requires an explicit trusted native host at link time. No closure or native
# pointer crosses the ABI. Use an empty URL for the compiled profile's home.
fn basis_elvi_live_fetch(program: ElviProgram, url: string, limit: i64) ->
  Result<BasisElviDocument, i64>
{
  let wire = on1x_elvi_live_snapshot_v1(program["source"], url, limit);
  let end = text_len(wire);
  if end < 23 || text_byte(wire, 0) != 79 {
    return variant<Result<BasisElviDocument,i64>>(Err, elvi_live_error(wire, end));
  }
  let status = elvi_live_decimal(wire, 1, end);
  let tls_version = elvi_live_decimal(wire, 7, end);
  let length = elvi_live_decimal(wire, 13, end);
  if status < 0 || tls_version < 0 || length < 0 || length > limit || length > 65536 {
    return variant<Result<BasisElviDocument,i64>>(Err, -10);
  }
  for i in 19 .. 23 {
    let byte = text_byte(wire, i);
    if byte != 48 && byte != 49 {
      return variant<Result<BasisElviDocument,i64>>(Err,-10);
    }
  }
  let (a, requested_url) = elvi_live_field(wire, 23, end, 8191);
  if a < 0 { return variant<Result<BasisElviDocument,i64>>(Err,-10); }
  let (b, content_type) = elvi_live_field(wire, a, end, 255);
  if b < 0 { return variant<Result<BasisElviDocument,i64>>(Err,-10); }
  let (c, protocol) = elvi_live_field(wire, b, end, 8);
  if c < 0 { return variant<Result<BasisElviDocument,i64>>(Err,-10); }
  let (d, alpn) = elvi_live_field(wire, c, end, 15);
  if d < 0 || end - d != length * 2 {
    return variant<Result<BasisElviDocument,i64>>(Err,-10);
  }
  let metadata = record<BasisElviDocumentMetadata> {
    status:status, requested_url:requested_url, effective_url:requested_url,
    content_type:content_type, http_protocol:protocol, alpn:alpn,
    tls_version:tls_version, certificate_verified:text_byte(wire,19)==49,
    hostname_verified:text_byte(wire,20)==49, body_length:length,
    chunked:text_byte(wire,21)==49, close_delimited:text_byte(wire,22)==49
  };
  return match basis_elvi_document_from_hex(metadata, text_slice(wire, d, end)) with {
    Ok(doc) => variant<Result<BasisElviDocument,i64>>(Ok,doc),
    Err(_) => variant<Result<BasisElviDocument,i64>>(Err,-10)
  };
}
