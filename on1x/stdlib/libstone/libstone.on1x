# Interchange helpers for LibStone ASDL/PPX serialized trees.
# Full C++ LibStone integration needs an explicitly versioned C ABI shim.
fn libstone_node(tag: string, children: sexpr) -> sexpr
{
  basis_shape_list(children);
  return sx_cons(sx_symbol(tag), children);
}

fn basis_libstone_validate(node: sexpr) -> i64
{
  if sx_kind(node) != 3 || sx_kind(sx_head(node)) != 1
  {
    tool_fail("expected symbol node tag");
  }
  # Use the same bound as libstone_node: the tag is not a child.
  return basis_shape_list(sx_tail(node));
}

fn libstone_tag(node: sexpr) -> string
{
  basis_libstone_validate(node);
  return sx_text(sx_head(node));
}

fn libstone_child(node: sexpr, index: i64) -> sexpr
{
  let count = basis_libstone_validate(node);
  if index < 0 || index >= count
  {
    tool_fail("child index outside node");
  }
  var tail = sx_tail(node);
  for _ in 0 .. index
  {
    tail = sx_tail(tail);
  }
  return sx_head(tail);
}

import "../base/shape.on1x";
