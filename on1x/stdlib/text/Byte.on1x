import "Char.on1x";
# Byte.byteToChar / charToByte are identity on 1..255.
fn basis_byte_char_to_byte(c: i64) -> i64
{
  if c < 0 || c > 255
  {
    tool_fail("byte out of range");
  }
  return c;
}
fn basis_byte_byte_to_char(c: i64) -> i64
{
  return basis_byte_char_to_byte(c);
}
fn basis_byte_pack_string(s: string) -> string
{
  return s;
}
fn basis_byte_unpack_string(s: string) -> string
{
  return s;
}
