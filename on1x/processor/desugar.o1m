meta 1;
budget steps 8388608 nodes 262144 depth 520;

# These are the two remaining all-literal pairs. Neither rule has a capture.
rule lazy_and_false_literals phase desugar priority 250
match Binary("&&", Boolean("false"), Boolean("false"))
replace Boolean("false")
guard boolean;

rule lazy_or_true_literals phase desugar priority 250
match Binary("||", Boolean("true"), Boolean("true"))
replace Boolean("true")
guard boolean;

# These literal operands leave exactly one evaluation of the captured bool.
# Match before Select would introduce storage and branches for the identity.
rule lazy_and_true_left phase desugar priority 240
match Binary("&&", Boolean("true"), $x)
replace $x
guard boolean;

rule lazy_and_true_right phase desugar priority 230
match Binary("&&", $x, Boolean("true"))
replace $x
guard boolean;

rule lazy_or_false_left phase desugar priority 220
match Binary("||", Boolean("false"), $x)
replace $x
guard boolean;

rule lazy_or_false_right phase desugar priority 210
match Binary("||", $x, Boolean("false"))
replace $x
guard boolean;

# Select evaluates its condition once, then exactly one result.
rule lazy_and phase desugar priority 200
match Binary("&&", $left, $right)
replace Select($left, $right, Boolean("false"))
guard boolean;

rule lazy_or phase desugar priority 190
match Binary("||", $left, $right)
replace Select($left, Boolean("true"), $right)
guard boolean;

# Integer order is total; these are deliberately not float rewrites.
rule integer_not_equal phase desugar priority 180
match Binary("!=", $left, $right)
replace Unary("!", Binary("==", $left, $right))
guard integer;

rule integer_less_equal phase desugar priority 170
match Binary("<=", $left, $right)
replace Unary("!", Binary(">", $left, $right))
guard integer;

rule integer_greater_equal phase desugar priority 160
match Binary(">=", $left, $right)
replace Unary("!", Binary("<", $left, $right))
guard integer;

rule boolean_not_equal phase desugar priority 150
match Binary("!=", $left, $right)
replace Unary("!", Binary("==", $left, $right))
guard boolean;
