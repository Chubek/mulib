extern fn live_environments()->i64;
fn make(value:bool)->fn()->bool {
    return fn()->bool { return !(!(value && true)); };
}
fn early()->bool {
    let outer=make(true);
    for i in 0..3 {
        let inner=make(false);
        if false || (i==1) { return outer() && !inner(); }
    }
    return false;
}
fn main() {
    println(early());
    assert(live_environments()==0);
    outer:for i in 0..10 {
        let f=make(i==9);
        { let g=make(false);
          if f() && true { break outer; }
          if !g() || false { continue outer; }
        }
    }
    assert(live_environments()==0);
    println(42);
}
