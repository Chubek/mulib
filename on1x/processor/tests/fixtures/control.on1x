fn bound(mark:i64, value:i64)->i64 { println(mark); return value; }
fn main() {
    var sum=0;
    outer:for i in bound(10,0)..bound(11,4) {
        if (i==1) && true { continue outer; }
        for j in 0..3 {
            if false || (j==2) { break; }
            sum=sum+i+j;
        }
    }
    println(sum);
    var n=0;
    while !(!(n<3)) { n=n+1; }
    println(n);
}
