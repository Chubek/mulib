meta 1;
budget steps 8388608 nodes 262144 depth 520;

# Structural contracts run before control lowering and again on checked HIR.
constraint unary_arity phase semantic
match Unary require arity "1" message "unary expression needs one operand";
constraint binary_arity phase semantic
match Binary require arity "2" message "binary expression needs two operands";
constraint call_callee phase semantic
match Call require callee "present" message "call needs a callee";
constraint unary_no_callee phase semantic
match Unary require callee "absent" message "unary expression cannot hide a callee";
constraint binary_no_callee phase semantic
match Binary require callee "absent" message "binary expression cannot hide a callee";
constraint unary_no_body phase semantic
match Unary require body "absent" message "unary expression cannot hide a statement body";
constraint binary_no_body phase semantic
match Binary require body "absent" message "binary expression cannot hide a statement body";
constraint call_no_body phase semantic
match Call require body "absent" message "call cannot hide a statement body";
constraint integer_arity phase semantic
match Integer require arity "0" message "integer literal cannot have operands";
constraint boolean_arity phase semantic
match Boolean require arity "0" message "boolean literal cannot have operands";
constraint float_arity phase semantic
match Float require arity "0" message "float literal cannot have operands";
constraint string_arity phase semantic
match String require arity "0" message "string literal cannot have operands";
constraint variable_arity phase semantic
match Variable require arity "0" message "variable cannot hide operands";
constraint variable_no_body phase semantic
match Variable require body "absent" message "variable cannot hide a statement body";
constraint variable_no_callee phase semantic
match Variable require callee "absent" message "variable cannot hide a callee";
constraint lambda_arity phase semantic
match Lambda require arity "0" message "lambda operands belong in its body";
constraint unit_arity phase semantic
match Unit require arity "0" message "unit cannot have operands";
constraint unit_no_body phase semantic
match Unit require body "absent" message "unit cannot hide a statement body";
constraint tuple_arity phase semantic
match Tuple require min_arity "2" message "tuple needs at least two operands";
constraint region_result phase semantic
match Region require arity "1" message "value region needs one tail";
constraint unsafe_result phase semantic
match UnsafeBlock require arity "1" message "unsafe block needs one tail";
constraint match_arms phase semantic
match PatternMatch require min_arity "2" message "empty match is not exhaustive";
constraint case_operands phase semantic
match Case require arity "2" message "match arm needs a guard and a result";
constraint field_operand phase semantic
match Field require arity "1" message "field projection needs one operand";
constraint index_operands phase semantic
match Index require arity "2" message "index needs a subject and an index";
constraint slice_operands phase semantic
match Slice require arity "3" message "slice needs a subject and two bounds";
constraint length_operand phase semantic
match Length require arity "1" message "length needs one subject";
constraint propagate_operand phase semantic
match Propagate require arity "1" message "propagation needs one result operand";
constraint borrow_operand phase semantic
match Borrow require arity "1" message "borrow needs one place operand";
constraint quote_operand phase semantic
match Quote require arity "1" message "lowered quote needs one thunk";
constraint run_operand phase semantic
match Run require arity "1" message "run needs one code operand";
constraint tag_operand phase semantic
match TagTest require arity "1" message "tag test needs one subject";
constraint payload_operand phase semantic
match Payload require arity "1" message "payload projection needs one subject";
constraint project_operand phase semantic
match Project require arity "1" message "tuple projection needs one subject";

# Typed contracts inspect annotations rather than recomputing or repairing them.
constraint boolean_type phase semantic
match Boolean require type "bool" message "boolean literal must carry bool";
constraint unit_type phase semantic
match Unit require type "unit" message "unit must carry void";
constraint variable_resolved phase semantic
match Variable require resolved "true" message "checked variable must have a resolved identity";
constraint binary_operand_types phase semantic
match Binary require operands "same" message "binary operands must have the same checked type";
constraint unary_result_type phase semantic
match Unary require result "operand0" message "unary result must match its operand type";
constraint if_condition phase semantic
match StmtIf require value "boolean" message "if needs a checked boolean condition";
constraint while_condition phase semantic
match StmtWhile require value "boolean" message "while needs a checked boolean condition";
constraint let_value phase semantic
match StmtLet require value "present" message "let needs an initializer";
constraint assign_value phase semantic
match StmtAssign require value "present" message "assignment needs a value";
constraint expression_value phase semantic
match StmtExpr require value "present" message "expression statement needs a value";
constraint initialize_value phase semantic
match StmtInitialize require value "present" message "canonical initialization needs a value";
