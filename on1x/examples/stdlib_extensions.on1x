# The build helper selects the raw INI/JSON adapters and one MuLIB kernel TU.
import std.ini.ini as INI;
import std.json.normalize as JSON;
import std.parsec.parsec as Scan;
fn main() {
  let (status,value)=INI.basis_ini_get("[app]\nworkers=42\n","app","workers");
  if status!=0 { println("configuration unavailable");return; }
  let (ok,workers,end)=Scan.basis_parsec_int(value,0);
  if !ok||end!=text_len(value) { println("invalid worker count");return; }
  println(workers);
  let (invalid,unused)=JSON.basis_json_normalize("not JSON");
  assert(invalid==-2);
  println("recoverable parse failure");
}
