import kernel mulib.histprice as History;

fn forecast(samples:slice<f64,5>) -> History.Result<History.Forecast,History.Error> {
    let ema = History.ema(samples, 0.0, 2)?;
    println(ema["point"]);
    return History.holt(samples, 0.5, 0.2, 1.0, 2);
}

fn main() {
    let data = array[99.0, 10.0, 12.0, 14.0, 99.0];
    match forecast(data[1:4]) with {
        Ok(h) => { println(h["point"]); println(h["variance"] != h["variance"]); },
        Err(_) => { println(-1); }
    };
    match forecast(data[1:1]) with {
        Ok(_) => { println(-1); },
        Err(Rejected()) => { println(0); }
    };
}
