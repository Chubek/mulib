unsafe import foreign stdffi.ipc_framed as Framed;

fn exchange(byte: u8, timeout: i64, offset: i64) -> Framed.Result<i64, i64>
{
  let pending = unsafe { Framed.open_pair() };
  let pair = pending?;
  return unsafe {
    Framed.roundtrip(move(pair), byte, timeout, fn(received: i64) -> i64 {
      println(received);
      return received + offset;
    })
  };
}

fn main()
{
  println(match exchange(0u8, 1000, 42) with {
    Ok(value) => value, Err(status) => status
  });
  println(match exchange(255u8, 0, 42) with {
    Ok(value) => value, Err(status) => status
  });
}
