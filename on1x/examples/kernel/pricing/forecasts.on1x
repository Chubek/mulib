import kernel mulib.histprice as History;
fn predict(samples: slice < f64,
  5 >) -> History.Result < History.Forecast, History.Error >
{
  let ema = History.ema(samples, 0.0, 2)?;
  println(ema["point"]);
  return History.holt(samples, 0.5, 0.2, 1.0, 2);
}

# Select the lower squared error using the observation immediately after
# training. The next chronological observation is evaluated by the caller.
fn select(samples: slice < f64,
  5 >,
  validation: f64) -> History.Result < bool, History.Error >
{
  let ema = History.ema(samples, 0.0, 1)?;
  let holt = History.holt(samples, 0.5, 0.2, 1.0, 1)?;
  let ema_error = ema["point"] - validation;
  let holt_error = holt["point"] - validation;
  return variant < History.Result < bool, History.Error > > (Ok,
    holt_error * holt_error < ema_error * ema_error);
}
