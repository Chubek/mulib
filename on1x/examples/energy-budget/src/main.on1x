import "schedule.on1x";

fn main() -> i64 {
  let daily_cap_wh = 3500;
  var day = 1;
  var weekly_wh = 0;
  var peak_wh = 0;
  var over_budget_days = 0;
  var excess_wh = 0;

  while day <= 7 {
    let (pump, fan, lights) = duty_minutes(day);
    # The three loads draw 1200 W, 360 W, and 240 W, respectively.
    let used_wh = 20 * pump + 6 * fan + 4 * lights;
    println(used_wh);
    weekly_wh = weekly_wh + used_wh;
    if used_wh > peak_wh {
      peak_wh = used_wh;
    }
    if used_wh > daily_cap_wh {
      over_budget_days = over_budget_days + 1;
      excess_wh = excess_wh + (used_wh - daily_cap_wh);
    }
    day = day + 1;
  }

  println(weekly_wh);
  println(peak_wh);
  println(over_budget_days);
  println(excess_wh);
  return 0;
}
