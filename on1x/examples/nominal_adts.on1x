record Point
{
  x: i64, y: i64
}

enum Option < T >
{
  None, Some(T)
}

enum Result < T, E >
{
  Ok(T), Err(E)
}

fn magnitude(p: Point) -> i64
{
  return p["x"] + p["y"];
}

fn choose(value: Option < _ >, fallback: _) -> _
{
  return match value with
  {
    None() => fallback, Some(n) => n
  };
}

fn recover(value: Result < i64, u8 >) -> i64
{
  return match value with
  {
    Ok(n) => n, Err(code) => 0 - u8_to_i64(code)
  };
}

fn main()
{
  let p = record < Point >
  {
    y: 2, x: 40
  };
  println(choose(variant < Option < _ > > (Some, magnitude(p)), 0));
  println(choose(variant < Option < _ > > (None, record
  {
  }), true));
  println(recover(variant < Result < i64, u8 > > (Err, 7u8)));
}
