# Lexical loans refer directly to their checked local place.
fn main()
{
  let balance = 40;
  {
    let update = borrow mut balance;
    {
      let nested = borrow mut update;
      nested := nested + 2;
    }
    {
      let view = borrow update;
      println(view);
    }
  }
  assert(balance == 42);
}
