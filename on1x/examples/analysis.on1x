# Inspect with --emit-ir-facts or --analyze-ir in a Novostone-enabled build.
# <= 0 keeps the nonnegative recursion fixture in scalar MIR v1; a right-side
# zero equality would attach portable rewrite requests (MIR v4).
fn even(n: i64) -> bool
{
  if n <= 0
  {
    return true;
  }
  return odd(n - 1);
}

fn odd(n: i64) -> bool
{
  if n <= 0
  {
    return false;
  }
  return even(n - 1);
}

fn main()
{
  for n in 0 .. 4
  {
    println(even(n));
  }
}
