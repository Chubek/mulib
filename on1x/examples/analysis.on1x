# Inspect with --emit-ir-facts or --analyze-ir in a Novostone-enabled build.
fn even(n: i64) -> bool {
  if n == 0 { return true; }
  return odd(n - 1);
}
fn odd(n: i64) -> bool {
  if n == 0 { return false; }
  return even(n - 1);
}
fn main() {
  var n = 0;
  while n < 4 {
    println(even(n));
    n = n + 1;
  }
}
