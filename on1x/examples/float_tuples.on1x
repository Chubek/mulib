fn advance((x, (step, index)): (f64, (f64, i64))) ->(f64, (f64, i64))
{
  return (x + step, (step, index + 1));
}

fn main()
{
  var state = (0.0, (0.125, 0));
  for _ in 0 .. 4
  {
    state = advance(state);
  }
  let(value, (step, index)) = state;
  println(value);
  println(step);
  println(index);
  assert(f64_signbit(- 0.0));
  assert(f64_is_nan(0.0 / 0.0));
}
