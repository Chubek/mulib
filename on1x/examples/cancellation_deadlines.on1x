fn main() {
    taskgroup {
        let ready = ->(1,1){payload:i64,capacity:0,mode:uni};
        let (notify, observed) = split ready;
        let child = launch {
            defer println(90);
            let sent = notify <- 1;
            for i in 0..100000 { assert(i >= 0); }
            42
        };
        match <-observed with { Some(_) => assert(true), None(_) => assert(false) };
        assert(cancel child);
        let timeout = poll { after 5ms => 7 };
        println(timeout);
        poll { after 1s => assert(false), default => println(8) };
    }
}
