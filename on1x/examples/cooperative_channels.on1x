# The initial cooperative profile uses a single native thread and i64 messages.
fn main() {
    taskgroup {
        let pipe = ->(1, 1) { payload: i64, capacity: 0, mode: uni };
        let (tx, rx) = split pipe;
        let worker: ifiber<i64> = launch {
            for n in 1..4 {
                match tx <- n with {
                    Ok(_) => println(n),
                    Err(_) => println(-1)
                };
            }
            close tx;
            7
        };
        for n in 0..3 {
            match <-rx with {
                Some(value) => println(value * 10),
                None(_) => println(-2)
            };
        }
        match <-rx with {
            Some(_) => println(-3),
            None(_) => println(0)
        };
        println(join worker);
    }
}
