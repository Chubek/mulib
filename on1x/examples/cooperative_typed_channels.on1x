# Typed directional endpoints carry fixed-size pointer-free values. Splitting
# binds every declared sender first, then every declared receiver.
record Packet
{
  sequence: u16,
  accepted: bool
}

fn main()
{
  taskgroup
  {
    let pipe = ->(2, 2)
    {
      payload: Packet, capacity: 2, mode: uni
    };
    let(tx0, tx1, rx0, rx1) = split pipe;

    match try_recv(rx0) with
    {
      Empty(_) => println(0),
      Closed(_) => println(- 1),
      Value(_) => println(- 2)
    };
    match try_send(tx0, record<Packet>{sequence: 7u16, accepted: true}) with
    {
      Sent(_) => println(1),
      Closed(_) => println(- 3),
      WouldBlock(_) => println(- 4)
    };
    match tx1 <- record<Packet>{sequence: 9u16, accepted: false} with
    {
      Ok(_) => println(2),
      Err(_) => println(- 5)
    };

    assert(close tx0);
    match try_recv(rx0) with
    {
      Value(packet) => println(u16_to_bits(packet["sequence"])),
      Empty(_) => println(- 6),
      Closed(_) => println(- 7)
    };
    match try_recv(rx1) with
    {
      Value(packet) => println(u16_to_bits(packet["sequence"])),
      Empty(_) => println(- 8),
      Closed(_) => println(- 9)
    };
    match try_recv(rx0) with
    {
      Empty(_) => println(3),
      Closed(_) => println(- 10),
      Value(_) => println(- 11)
    };

    assert(close tx1);
    assert(! close tx1);
    match try_recv(rx1) with
    {
      Closed(_) => println(4),
      Empty(_) => println(- 12),
      Value(_) => println(- 13)
    };
  }
}
