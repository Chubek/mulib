# Build with on1x-build.py --mulib-fixture yantlr.
import std.mulib as MuLIB;
fn main()
{
  assert(MuLIB.abi_version() == 1);
  assert(MuLIB.fits_array(1024, 8));
  println(MuLIB.kernel_header("yantlr"));
  println(MuLIB.fixture_group("library/yantlr/example.y1"));
  let(found, source) = MuLIB.fixture_text("library/yantlr/example.y1");
  assert(found);
  io_stdout(source);
}
