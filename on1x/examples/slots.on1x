# Local slot forwarding preserves the old value and observable call ordering.
fn mark(n: i64) -> i64
{
  println(n);
  return n;
}
fn main()
{
  var n = 1;
  let old = n;
  n = mark(2);
  println(old);
  println(n);
  n = n + 3;
  println(n);
  var i = 0;
  while i < 3
  {
    println(i);
    i = i + 1;
  }
}
