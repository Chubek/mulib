# Bounded value data model: structural records, closed sums, fixed arrays and owning slices.
# Run with: python3 tools/on1x-build.py examples/data_model.on1x --on1xc <build>/on1xc -o data_model
fn magnitude(v: record
{
  x: f64, y: f64
}) -> f64
{
  return v["x"] * v["x"] + v["y"] * v["y"];
}
fn classify(s: sum
{
  None: record
  {
  }, Point: record
  {
    x: f64, y: f64
  }
}) -> f64
{
  return match s with
  {
    None() => 0.0, Point(p) => magnitude(p)
  };
}
fn sum_range(a: array < i64, 4 >) -> i64
{
  var acc: i64 = 0;
  let middle = a[1: 3]; # owning copy; escapes safely
  for i in 0 .. middle[]
  {
    acc = acc + middle[i];
  }
  return acc;
}
fn main()
{
  let origin = record
  {
    x: 3.0, y: 4.0
  };
  println(magnitude(origin)); # 0x1.9000000000000p+4 (25.0)
  println(classify(variant < sum
  {
    None: record
    {
    }, Point: record
    {
      x: f64, y: f64
    }
  } > (Point, origin)));
  println(classify(variant < sum
  {
    None: record
    {
    }, Point: record
    {
      x: f64, y: f64
    }
  } > (None, record
  {
  })));
  let samples = array[10, 20, 30, 40];
  println(sum_range(samples)); # 50
  println(samples[]); # 4
  println(samples[3]); # 40
}
