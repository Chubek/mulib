fn main() {
  let identity = fn(x) -> _ { return x; };
  let alias = identity;
  println(identity(42)); println(identity(true)); println(alias("text"));
  let apply = fn(f, x) -> _ { return f(x); };
  println(apply(fn(n: i64) -> i64 { return n + 1; }, 41));
  println(apply(fn(b: bool) -> bool { return !b; }, false));
  let unused = fn(x) -> _ { return x; };
}
