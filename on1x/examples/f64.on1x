# Initial binary64 value profile; literals remain i64, conversions are explicit.
fn half(value: f64) -> f64
{
  return value / f64_from_i64(2);
}

fn main()
{
  let answer = half(f64_from_i64(85));
  println(answer);
  assert(f64_to_i64(answer) == 42);
  let zero = f64_from_i64(0);
  assert(f64_signbit(- zero));
  assert(f64_is_nan(zero / zero));
  assert(! f64_is_finite(f64_from_i64(1) / zero));
}
