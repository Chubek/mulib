import std.cephyr as Cephyr;
import "../../../stdlib/text/String.on1x";

fn main()
{
  let (ok, notes) = Cephyr.check("int square(int x) { return x*x; }");
  assert(ok == 0);
  let (status, ir, diagnostics) = Cephyr.emit_mir(
    "int square(int x) { return x*x; }");
  assert(status == 0);
  let (bad, empty, error) = Cephyr.emit_mir("int broken( {");
  assert(bad == 1);
  assert(text_len(empty) == 0);
  assert(text_len(error) > 0);
  let (again, ignored) = Cephyr.check("int main(void) { return 71; }");
  assert(again == 0);
  assert(basis_string_contains(ir, "archon-mir 1"));
  assert(basis_string_contains(ir, "square"));
  let (identity_status, identity, identity_notes) = Cephyr.emit_mir(
    "unsigned long identity(unsigned long x) { return x*1ul; }");
  assert(identity_status == 0);
  # A default-enabled Blackstone would have simplified this multiply.
  assert(basis_string_contains(identity, "\nmul "));
  assert(basis_string_contains(error, "error"));
  let (native, assembly, messages) = Cephyr.emit_assembly("int square(int x) { return x*x; }");
  assert(native == 0);
  assert(basis_string_contains(assembly, "square:"));
  println(assembly);
}
