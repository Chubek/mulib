# The SDK test prepends the generated safe module import and checks its evidence.
fn mark_flag() -> bool
{
  println(1);
  return true;
}
fn mark_value() -> f64
{
  println(2);
  return 1.5;
}
fn mark_count() -> i64
{
  println(3);
  return 2;
}
fn main()
{
  println(on1x_safe_contract_add(40, 2));
  println(on1x_safe_contract_narrow(- 7));
  on1x_safe_contract_note(5);
  println(on1x_safe_contract_count());
  println(on1x_safe_contract_inline(42));
  println(on1x_safe_contract_io(9));
  println(on1x_safe_contract_bool(true));
  println(on1x_safe_contract_bool(false));
  println(on1x_safe_contract_double(1.5));
  println(on1x_safe_contract_mix(mark_flag(), mark_value(), mark_count()));
  println(on1x_safe_contract_mix(false, 1.5, 9));
  println(f64_to_bits(on1x_safe_contract_double(- 0.0)));
  println(f64_to_bits(on1x_safe_contract_double(f64_from_bits(1))));
  println(f64_to_bits(on1x_safe_contract_double(f64_from_bits(9218868437227405312))));
  println(f64_to_bits(on1x_safe_contract_double(f64_from_bits(- 4503599627370496))));
  println(f64_is_nan(on1x_safe_contract_double(f64_from_bits(9221120237041090561))));
  println(on1x_safe_contract_unsigned(u32_from_bits(- 1)));
  println(on1x_safe_contract_u8(u8_from_bits(- 1)));
  println(on1x_safe_contract_u16(u16_from_bits(- 1)));
  println(on1x_safe_contract_u64(u64_from_bits(- 1)));
  println(on1x_safe_contract_float(f32_from_f64(1.5)));
  println(f32_to_bits(on1x_safe_contract_float(f32_from_bits(1))));
}
