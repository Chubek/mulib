fn limit() -> i64 { println(10); return 1; }

fn compute() -> i64 {
    taskgroup within limit() s {
        let c = ->(1,1){payload:i64,capacity:0,mode:uni};
        let (tx, rx) = split c;
        let worker = launch {
            taskgroup within 2s {
                let sent = tx <- 42;
                match sent with { Ok(_) => assert(true), Err(_) => assert(false) };
            }
            7
        };
        match <-rx with {
            Some(value) => println(value),
            None(_) => assert(false)
        };
        return join worker;
    }
}

fn main() {
    println(compute());
    for i in 0..8 {
        taskgroup within 1ms { continue; }
    }
    loop { taskgroup within 1 { break; } }
    poll { after 2ms => println(8) };
}
