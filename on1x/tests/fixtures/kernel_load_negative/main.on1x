import foreign stdffi.clamp as Clamp;
import std.environ as Env;

fn main() {
    # The test host adapter records its initialization before main.
    if Env.argc() < 1 { return; }
    println(Clamp.i64(27, 0, 10));
    println(Clamp.add_i64(9223372036854775807, 1));
    println(Clamp.sub_i64(-9223372036854775808, 1));
}
