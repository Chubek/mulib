enum Node { Node(i64) }
enum Result<T,E> { Ok(T), Err(E) }

extern fn on1x_unique_live_allocations()->i64;

fn node(value:i64)->own<Node> {
  return box(variant<Node>(Node,value));
}

fn build()->Result<own<Node>,u8> {
  let first=node(1);
  let second=node(2);
  drop(first);
  return variant<Result<own<Node>,u8>>(Ok,move(second));
}

fn main() {
  let pending=build();
  let owner=match pending with {
    Ok(value)=>move(value),
    Err(_)=>node(3)
  };
  drop(owner);
  assert(on1x_unique_live_allocations()==0);
}
