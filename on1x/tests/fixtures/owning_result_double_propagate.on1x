enum Node
{
  Node(i64)
}

enum Result < T, E >
{
  Ok(T), Err(E)
}

fn make() -> Result < own < Node >, u8 >
{
  return variant < Result < own < Node >, u8 > > (Ok,
    box(variant < Node > (Node,
    1)));
}

fn bad() -> Result < i64, u8 >
{
  let pending = make();
  let first = pending?;
  drop(first);
  let second = pending?;
  drop(second);
  return variant < Result < i64, u8 > > (Ok, 0);
}

fn main()
{
}
