import std.container.Box as BoxModule;
import std.container.Cell as CellModule;
import std.container.Local as LocalModule;
import std.container.Quarantine as Quarantine;

extern fn on1x_unique_live_allocations() -> i64;
extern fn on1x_test_unique_allocator_allocations() -> i64;
extern fn on1x_test_unique_allocator_live() -> i64;

record RequireFlag { expected: bool }

impl Quarantine.BasisQuarantinePolicy<bool> for RequireFlag {
    fn basis_quarantine_accepts(policy: RequireFlag, value: bool) -> bool {
        return policy["expected"] == value;
    }
}

record StringAtomLength { expected: i64 }

impl Quarantine.BasisQuarantinePolicy<sexpr> for StringAtomLength {
    fn basis_quarantine_accepts(policy: StringAtomLength, value: sexpr) -> bool {
        return sx_kind(value) == 2 && text_len(sx_text(value)) == policy["expected"];
    }
}

fn test_boxes() {
    let owner = BoxModule.basis_box_new(sx_string("before"));
    assert(on1x_unique_live_allocations() == 1);
    assert(data_live_nodes() == 1);
    {
        let first = borrow owner;
        let second = borrow owner;
        assert(sx_text(BoxModule.basis_box_get(first)) == "before");
        assert(sx_text(BoxModule.basis_box_get(second)) == "before");
    }
    {
        let edit = borrow mut owner;
        let previous = BoxModule.basis_box_replace(edit, sx_string("after"));
        assert(sx_text(previous) == "before");
        assert(sx_text(BoxModule.basis_box_get(edit)) == "after");
        assert(on1x_unique_live_allocations() == 1);
        assert(data_live_nodes() == 2);
    }
    assert(data_live_nodes() == 1);
    let value = BoxModule.basis_box_into_inner(move(owner));
    assert(on1x_unique_live_allocations() == 0);
    assert(sx_text(value) == "after");

    # Move-only fields are supported by the compiler intrinsics and an explicit
    # consuming match, not by copy-based generic accessors.
    let inner = BoxModule.basis_box_new(41);
    let outer = box(record<BoxModule.Box<own<BoxModule.Box<i64>>>> { value: move(inner) });
    let contents = take(outer);
    match contents with {
        record{value: child} => assert(BoxModule.basis_box_into_inner(move(child)) == 41)
    };
    assert(on1x_unique_live_allocations() == 0);
    {
        let automatic = BoxModule.basis_box_new(sx_string("drop on scope exit"));
        assert(on1x_unique_live_allocations() == 1);
        assert(data_live_nodes() == 2);
    }
    assert(on1x_unique_live_allocations() == 0);
    assert(data_live_nodes() == 1);
}

fn test_cells() {
    var left = CellModule.basis_cell_new(0u8);
    var right = CellModule.basis_cell_new(255u8);
    CellModule.basis_cell_swap(left, right);
    assert(CellModule.basis_cell_get(left) == 255u8);
    assert(CellModule.basis_cell_replace(right, 7u8) == 0u8);
    CellModule.basis_cell_set(left, 19u8);
    assert(CellModule.basis_cell_get(left) == 19u8);
    assert(CellModule.basis_cell_get(right) == 7u8);

    let binary = CellModule.basis_cell_new(array[15u8, 0u8, 255u8]);
    let snapshot = CellModule.basis_cell_get(binary);
    assert(snapshot[0] == 15u8 && snapshot[1] == 0u8 && snapshot[2] == 255u8);

    var a = CellModule.basis_cell_new(sx_string("a"));
    var b = CellModule.basis_cell_new(sx_string("b"));
    CellModule.basis_cell_swap(a, b);
    assert(sx_text(CellModule.basis_cell_get(a)) == "b");
    assert(sx_text(CellModule.basis_cell_get(b)) == "a");
    assert(data_live_nodes() == 2);
}

fn test_locals() {
    var first: LocalModule.Local<sexpr> = LocalModule.basis_local_empty();
    var second: LocalModule.Local<sexpr> = LocalModule.basis_local_empty();
    assert(option_is_none(LocalModule.basis_local_peek(first)));
    assert(option_is_none(LocalModule.basis_local_put(first, sx_string("one"))));
    assert(option_is_none(LocalModule.basis_local_peek(second)));
    {
        let previous = LocalModule.basis_local_put(first, sx_string("two"));
        match previous with {
            Some(value) => assert(sx_text(value) == "one"),
            None() => assert(false)
        };
    }
    assert(data_live_nodes() == 1);
    {
        let taken = LocalModule.basis_local_take(first);
        match taken with {
            Some(value) => assert(option_is_none(LocalModule.basis_local_put(second, value))),
            None() => assert(false)
        };
        assert(option_is_none(LocalModule.basis_local_take(first)));
        assert(option_is_some(LocalModule.basis_local_peek(second)));
    }
    let taken = LocalModule.basis_local_take(second);
    match taken with {
        Some(value) => assert(sx_text(value) == "two"),
        None() => assert(false)
    };
    assert(option_is_none(LocalModule.basis_local_take(second)));
}

fn test_quarantine() {
    let low = -9223372036854775807 - 1;
    let high = 9223372036854775807;
    let reversed = record<Quarantine.BasisQuarantineI64Range> { low: high, high: low };
    let lower = record<Quarantine.BasisQuarantineI64Range> { low: low, high: low };
    let upper = record<Quarantine.BasisQuarantineI64Range> { low: high, high: high };

    let staged = Quarantine.basis_quarantine_stage(low);
    assert(!Quarantine.basis_quarantine_check(staged, reversed));
    assert(Quarantine.basis_quarantine_check(staged, lower));
    let allocations = on1x_test_unique_allocator_allocations();
    let initial = Quarantine.basis_quarantine_review(move(staged), reversed);
    match initial with {
        Ok(_) => assert(false),
        Err(retained) => {
            assert(on1x_unique_live_allocations() == 1);
            assert(on1x_test_unique_allocator_allocations() == allocations);
            match Quarantine.basis_quarantine_review(move(retained), lower) with {
                Ok(n) => assert(n == low),
                Err(_) => assert(false)
            };
        }
    };
    assert(on1x_unique_live_allocations() == 0);
    match Quarantine.basis_quarantine_review(Quarantine.basis_quarantine_stage(high), upper) with {
        Ok(n) => assert(n == high),
        Err(_) => assert(false)
    };

    match Quarantine.basis_quarantine_review(Quarantine.basis_quarantine_stage(true),
        record<RequireFlag> { expected: true }) with {
        Ok(flag) => assert(flag),
        Err(_) => assert(false)
    };
    match Quarantine.basis_quarantine_review(Quarantine.basis_quarantine_stage(sx_string("nine.....")),
        record<StringAtomLength> { expected: 8 }) with {
        Ok(_) => assert(false),
        Err(retained) => {
            assert(data_live_nodes() == 1);
            drop(retained);
            assert(data_live_nodes() == 0);
        }
    };
    match Quarantine.basis_quarantine_review(Quarantine.basis_quarantine_stage(sx_string("nine.....")),
        record<StringAtomLength> { expected: 9 }) with {
        Ok(found) => assert(sx_text(found) == "nine....."),
        Err(_) => assert(false)
    };
    assert(on1x_unique_live_allocations() == 0);
}

fn main() {
    test_boxes();
    assert(data_live_nodes() == 0);
    test_cells();
    assert(data_live_nodes() == 0);
    test_locals();
    assert(data_live_nodes() == 0);
    test_quarantine();
    assert(data_live_nodes() == 0);
    assert(on1x_test_unique_allocator_live() == 0);
    println("container local lifecycle");
}
