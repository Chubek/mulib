import std.container.RefCell as C;
extern fn on1x_test_unique_allocator_live() -> i64;
record Snapshot
{
  value: i64, tag: sexpr
}

fn acquire(cell: own < C.RefCell < Snapshot > >) -> C.RefCellBorrow < own < C.RefMut < Snapshot > > >
{
  return C.basis_refcell_try_borrow_mut(cell);
}

fn main()
{
  assert(data_live_nodes() == 0);
  let cell = C.basis_refcell_new(record < Snapshot >
  {
    value: 41, tag: sx_string("initial")
  });
  let alias = C.basis_refcell_clone(cell);
  match C.basis_refcell_try_borrow(cell) with
  {
    Busy() => assert(false), Granted(first) =>
    {
      assert(C.basis_refcell_read(first)["value"] == 41);
      match C.basis_refcell_try_borrow(alias) with
      {
        Busy() => assert(false), Granted(second) =>
        {
          assert(sx_text(C.basis_refcell_read(second)["tag"]) == "initial");
        }
      };
      match C.basis_refcell_try_borrow_mut(alias) with
      {
        Busy() => assert(true), Granted(unexpected) => assert(false)
      };
    }
  };
  match C.basis_refcell_try_borrow_mut(cell) with
  {
    Busy() => assert(false), Granted(writer) =>
    {
      match C.basis_refcell_try_borrow(alias) with
      {
        Busy() => assert(true), Granted(unexpected) => assert(false)
      };
      match C.basis_refcell_try_borrow_mut(alias) with
      {
        Busy() => assert(true), Granted(unexpected) => assert(false)
      };
      let old = C.basis_refcell_replace(writer, record < Snapshot >
      {
        value: 42, tag: sx_string("updated")
      });
      assert(old["value"] == 41 && sx_text(old["tag"]) == "initial");
      assert(C.basis_refcell_read_mut(writer)["value"] == 42);
    }
  };
  assert(data_live_nodes() == 1);
  drop(cell);
  let guard = acquire(move(alias));
  assert(on1x_test_unique_allocator_live() == 2);
  match guard with
  {
    Busy() => assert(false), Granted(writer) =>
    {
      assert(sx_text(C.basis_refcell_read_mut(writer)["tag"]) == "updated");
      drop(writer);
    }
  };
  assert(data_live_nodes() == 0 && on1x_test_unique_allocator_live() == 0);
  println("dynamic borrows");
}
