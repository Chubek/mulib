from std.html import BasisHtml, basis_html_serialize;
from std.http.probe import ProbeHandler, ProbeResult;

record Owner { document: BasisHtml }

impl Owner
{
  fn rejected(borrow self) -> ProbeHandler<i64, i64>
  {
    let deliver = fn(result: ProbeResult<i64>, context: i64) {
      let (_, markup) = basis_html_serialize(self["document"]);
      assert(result["value"] == context && text_len(markup) != 0);
    };
    # An escaping delivery closure may not retain the borrowed receiver.
    return record<ProbeHandler<i64, i64>>{context: 42, deliver: deliver};
  }
}

fn main() {}
