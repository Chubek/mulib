import std.container.Pod as Pod;

fn check_namespace(profile: Pod.BasisPodNamespace)
{
  # A separate native gate determines whether unshare is actually available.
  match Pod.basis_pod_echo_byte(173u8, 2000, profile, false) with
  {
    Ok(value) => assert(value == 173u8), Err(error) => match error with
    {
      PodDenied() => assert(true), _ => assert(false)
    }
  };
}

fn main()
{
  match Pod.basis_sandbox_echo_byte(0u8, 2000) with
  {
    Ok(value) => assert(value == 0u8), Err(_) => assert(false)
  };
  match Pod.basis_sandbox_echo_byte(255u8, 2000) with
  {
    Ok(value) => assert(value == 255u8), Err(_) => assert(false)
  };
  match Pod.basis_sandbox_echo_byte(42u8, 0) with
  {
    Ok(_) => assert(false), Err(error) => match error with
    {
      PodInvalid() => assert(true), _ => assert(false)
    }
  };
  match Pod.basis_pod_echo_byte(42u8, 2000, variant<Pod.BasisPodNamespace>(PodNoNamespace, record {}), true) with
  {
    Ok(_) => assert(false), Err(error) => match error with
    {
      PodNotAuthorized() => assert(true), _ => assert(false)
    }
  };
  check_namespace(variant<Pod.BasisPodNamespace>(PodUserNamespace, record {}));
  check_namespace(variant<Pod.BasisPodNamespace>(PodUserNetworkIpcUts, record {}));
  println("On1x Pod echo ok");
}
