import std.container.Tls as Tls;
import std.container.Foreign as Foreign;

fn expect_tls(expected: i64)
{
  match Tls.basis_tls_i64_current() with
  {
    Some(value) => assert(value == expected), None() => assert(false)
  };
}

fn expect_empty()
{
  match Tls.basis_tls_i64_current() with
  {
    None() => assert(true), Some(_) => assert(false)
  };
}

fn fail_callback() -> Result<i64, i64>
{
  return variant<Result<i64, i64>>(Err, 42);
}

fn test_tls()
{
  expect_empty();
  let result = Tls.basis_tls_i64_with(-1, fn() -> Result<i64, i64>
  {
    expect_tls(-1);
    let nested = Tls.basis_tls_i64_with(9223372036854775807, fn() -> bool
    {
      expect_tls(9223372036854775807);
      Tls.basis_tls_i64_clear();
      expect_empty();
      return true;
    });
    match nested with
    {
      Some(ok) => assert(ok), None() => assert(false)
    };
    expect_tls(-1);
    assert(Tls.basis_tls_i64_set(-9223372036854775807 - 1));
    expect_tls(-9223372036854775807 - 1);
    let unreachable = fail_callback()?;
    return variant<Result<i64, i64>>(Ok, unreachable);
  });
  match result with
  {
    None() => assert(false), Some(outcome) => match outcome with
    {
      Err(error) => assert(error == 42), Ok(_) => assert(false)
    }
  };
  expect_empty();
  assert(Tls.basis_tls_i64_set(0));
  expect_tls(0);
  Tls.basis_tls_i64_clear();
  expect_empty();
}

fn expect_byte(offset: i64, expected: u8)
{
  match Foreign.basis_foreign_file_byte_at("bytes", offset) with
  {
    Ok(option) => match option with
    {
      Some(byte) => assert(byte == expected), None() => assert(false)
    },
    Err(_) => assert(false)
  };
}

fn expect_file_error(path: string, offset: i64, expected: Foreign.BasisForeignFileError)
{
  match Foreign.basis_foreign_file_byte_at(path, offset) with
  {
    Err(error) => match error with
    {
      ForeignInvalid() => match expected with
      {
        ForeignInvalid() => assert(true), _ => assert(false)
      },
      ForeignOpenFailed() => match expected with
      {
        ForeignOpenFailed() => assert(true), _ => assert(false)
      },
      ForeignNotRegular() => match expected with
      {
        ForeignNotRegular() => assert(true), _ => assert(false)
      },
      _ => assert(false)
    },
    Ok(_) => assert(false)
  };
}

fn main()
{
  test_tls();
  expect_byte(0, 0u8);
  expect_byte(1, 255u8);
  expect_byte(2, 42u8);
  match Foreign.basis_foreign_file_byte_at("sparse", 4294967303) with
  {
    Ok(option) => match option with
    {
      Some(byte) => assert(byte == 173u8), None() => assert(false)
    },
    Err(_) => assert(false)
  };
  match Foreign.basis_foreign_file_byte_at("bytes", 3) with
  {
    Ok(option) => match option with
    {
      None() => assert(true), Some(_) => assert(false)
    },
    Err(_) => assert(false)
  };
  expect_file_error("bytes", -1, variant<Foreign.BasisForeignFileError>(ForeignInvalid, record {}));
  expect_file_error("bytes", 9223372036854775807, variant<Foreign.BasisForeignFileError>(ForeignInvalid, record {}));
  expect_file_error("absent", 0, variant<Foreign.BasisForeignFileError>(ForeignOpenFailed, record {}));
  expect_file_error("link", 0, variant<Foreign.BasisForeignFileError>(ForeignOpenFailed, record {}));
  expect_file_error("fifo", 0, variant<Foreign.BasisForeignFileError>(ForeignNotRegular, record {}));
  expect_file_error(".", 0, variant<Foreign.BasisForeignFileError>(ForeignNotRegular, record {}));
  println("container native ok");
}
