# Prospective replacement for pp_render and pp_format; no raw bridge fallback.
import kernel mulib.prettysexpr as PrettyKernel;
import std.sexpr.sexpr as SExpr;

fn pp_render(doc:sexpr,width:i64,algorithm:i64,target:i64,paragraph:i64)->(i64,string) {
  if width<1 || width>4096 { return (-1,""); }
  if algorithm<0 || algorithm>2 || target<0 || target>3 || paragraph<0 || paragraph>1 { return (-1,""); }
  let source=SExpr.sexpr_print(doc);
  if text_len(source)>2097152 { return (-4,""); }
  return PrettyKernel.render_expr(source,width,algorithm,target,paragraph);
}

fn pp_format(doc:sexpr,width:i64)->(i64,string) {
  return pp_render(doc,width,1,0,0);
}

fn main() {
  let doc=SExpr.sx_cons(SExpr.sx_symbol("text"),SExpr.sx_cons(SExpr.sx_string("café <&"),SExpr.sx_nil()));
  let (status,text)=pp_format(doc,16);
  assert(status==0 && text=="café <&");
  let (invalid,empty)=pp_format(doc,0);
  assert(invalid==-1 && empty=="");
}
