# Prospective replacement for std.json's scalar helpers.
import kernel mulib.json as Json;

fn json_valid(text:string)->bool {
  if text_len(text)>2097152 { return false; }
  let (ok,doc)=Json.parse(text);
  if !ok { return false; }
  Json.destroy(doc);
  return true;
}

fn basis_json_normalize(text:string)->(i64,string) {
  if text_len(text)>2097152 { return (-4,""); }
  let (ok,doc)=Json.parse(text);
  if !ok { return (-2,""); }
  let result=Json.stringify_compact(doc);
  Json.destroy(doc);
  return result;
}

fn json_normalize(text:string)->string {
  let (status,value)=basis_json_normalize(text);
  return value;
}

fn basis_json_array_length(text:string)->(bool,i64) {
  if text_len(text)>2097152 { return (false,0); }
  let (ok,doc)=Json.parse(text);
  if !ok { return (false,0); }
  if !Json.is_array(doc) {
    Json.destroy(doc);
    return (false,0);
  }
  let size=Json.size_i64(doc);
  Json.destroy(doc);
  return (true,size);
}

fn main() {
  assert(json_valid("null"));
  assert(!json_valid("{"));
  assert(json_normalize("{ \"a\" : 1 }")=="{\"a\":1}");
  let (ok,n)=basis_json_array_length("[1,2,3]");
  let (not_array,unused)=basis_json_array_length("{\"a\":1}");
  assert(ok && n==3 && !not_array);
}
