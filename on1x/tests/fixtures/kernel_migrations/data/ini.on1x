import kernel mulib.ini as Ini;
fn ini_has(source: string, section: string, key: string) -> bool
{
  if text_len(source) > 2097152 || text_len(section) > 2097152 || text_len(key) > 2097152
  {
    return false;
  }
  return Ini.has_first(source, section, key);
}
fn basis_ini_get(source: string, section: string, key: string) ->(i64, string)
{
  if text_len(source) > 2097152 || text_len(section) > 2097152 || text_len(key) > 2097152
  {
    return (- 4, "");
  }
  return Ini.get_first(source, section, key);
}
fn ini_get(source: string, section: string, key: string) -> string
{
  let(status, value) = basis_ini_get(source, section, key);
  return value;
}
fn main()
{
  let doc = "[a]\nk=\nk=second\n";
  let(ok, value) = basis_ini_get(doc, "a", "k");
  let(missing, unused) = basis_ini_get(doc, "a", "other");
  let(invalid, partial) = basis_ini_get("[a]\nk=value\ninvalid", "a", "k");
  assert(ini_has(doc, "a", "k") && ok == 0 && value == "");
  assert(missing == 1 && invalid == - 2 && partial == "");
}
