import kernel mulib.toml as Toml;
import kernel mulib.json as Json;
fn basis_toml_as_json(text: string) ->(i64, string)
{
  if text_len(text) > 2097152
  {
    return (- 4, "");
  }
  let(ok, doc) = Toml.parse(text);
  if ! ok
  {
    return (- 2, "");
  }
  let result = Json.stringify_compact(doc);
  Json.destroy(doc);
  return result;
}

fn toml_as_json(text: string) -> string
{
  let(status, value) = basis_toml_as_json(text);
  return value;
}

fn main()
{
  assert(toml_as_json("value = 42\n") == "{\"value\":42}");
}
