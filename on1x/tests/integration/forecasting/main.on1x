import forecast as Forecast;
import kernel mulib.priceopt as Optimization;

fn main() {
  # Named synthetic cases, not an application file format or pricing policy.
  let scenario = io_stdin();
  if scenario != "trend" && scenario != "flat" && scenario != "holdout" &&
      scenario != "descending" && scenario != "cap" && scenario != "infeasible" {
    println("invalid-case");
    return;
  }
  var samples = array[10.0, 12.0, 14.0, 16.0, 18.0, 20.0];
  if scenario == "flat" {
    samples = array[10.0, 10.0, 10.0, 10.0, 9.0, 11.0];
  }
  if scenario == "holdout" {
    samples = array[10.0, 12.0, 14.0, 16.0, 16.0, 16.0];
  }
  if scenario == "descending" {
    samples = array[10.0, 8.0, 6.0, 4.0, 2.0, 0.0];
  }
  match Forecast.backtest(samples) with {
    Err(_) => { println("forecast-rejected"); return; },
    Ok(stats) => {
      println("ok");
      if stats["holt"] { println("holt"); } else { println("ema"); }
      println(stats["ema_mae"]);
      println(stats["selected_mae"]);
      println(stats["next"]);
    }
  };
  # Independently test the kernel's documented quadratic objective:
  # (x - 4) * (40 - x). No forecast controls the optimization bounds.
  let kind = variant<Optimization.DemandKind>(Linear, record{});
  let objective = variant<Optimization.Objective>(Profit, record{});
  let model = record<Optimization.DemandModel>{
    kind: kind, scale: 40.0, shape: 1.0, reference: 0.0
  };
  var upper = 30.0;
  if scenario == "cap" { upper = 18.0; }
  if scenario == "infeasible" { upper = 3.0; }
  let limits = record<Optimization.Constraints>{
    min_price: 4.0, max_price: upper, unit_cost: 4.0,
    min_unit_margin: 0.0, previous_price: 0.0, max_relative_change: 0.0, tick: 1.0
  };
  match Optimization.optimize(model, limits, objective) with {
    Err(_) => { println("optimization-rejected"); },
    Ok(result) => {
      println("optimum");
      println(result["price"]);
      println(result["score"]);
      println(result["expected_demand"]);
      println(result["evaluations"]);
    }
  };
}
