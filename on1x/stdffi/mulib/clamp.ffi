(ffispec 1 (kernel clamp) (header mulib-clamp.h)
  (sha256 cf3d0cf6e27b0d2844e25ea1e5bf7637a34508d29c42411aa855dfe97a1205e0)
  (export i64 mulib_clamp_i64 (params x lo hi)
    (guard (le lo hi))
    (body (if (lt x lo) lo (if (gt x hi) hi x)))
    (hint kernel-hot (target x86_64-unknown-linux-gnu) (speculative))
    (hint private-code (backend mir-c11))
    (rewrite fold-identity (speculative)))
  (export add_i64 mulib_clamp_add_i64 (params a b)
    (guard true)
    (body (if (and (gt b 0) (gt a (sub 9223372036854775807 b))) 9223372036854775807 (if (and (lt b 0) (lt a (sub -9223372036854775808 b))) -9223372036854775808 (add a b))))
    (hint kernel-hot (target x86_64-unknown-linux-gnu) (speculative))
    (hint private-code (backend mir-c11))
    (rewrite fold-identity (speculative)))
  (export sub_i64 mulib_clamp_sub_i64 (params a b)
    (guard true)
    (body (if (and (lt b 0) (gt a (add 9223372036854775807 b))) 9223372036854775807 (if (and (gt b 0) (lt a (add -9223372036854775808 b))) -9223372036854775808 (sub a b))))
    (hint kernel-hot (target x86_64-unknown-linux-gnu) (speculative))
    (hint private-code (backend mir-c11))
    (rewrite fold-identity (speculative)))
)
