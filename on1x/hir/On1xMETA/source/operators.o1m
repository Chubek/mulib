meta 1;
budget steps 8388608 nodes 262144 depth 520;

# The host supplies one already-resolved, opaque binding from the match root.
# Captures are moved once, in source evaluation order, into an ordinary call.
rule operator_reference phase source priority 100
match OperatorReference()
replace BoundOperator()
guard host_binding;

rule operator_unary phase source priority 100
match OperatorUnary($operand)
replace Call(BoundOperator(), $operand)
guard host_binding;

rule operator_binary phase source priority 100
match OperatorBinary($left, $right)
replace Call(BoundOperator(), $left, $right)
guard host_binding;

rule operator_ternary phase source priority 100
match OperatorTernary($first, $second, $third)
replace Call(BoundOperator(), $first, $second, $third)
guard host_binding;

rule operator_definition phase source priority 100
match OperatorDeclaration($definition)
replace DefineOperator($definition)
guard host_binding;

# The source host (parser/macro expander/PPX admission) has applied the rank.
rule operator_fixity phase source priority 100
match FixityDirective()
replace Consumed()
guard resolved_fixity;
