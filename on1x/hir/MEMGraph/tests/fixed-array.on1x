fn mark(tag: i64, value: i64) -> i64 {
    println(tag);
    return value;
}

fn make_array(tag: i64) -> array<i64,3> {
    println(tag);
    return array[11,22,33];
}

fn main() {
    let a = array[11,22,33];
    println(a[0]);                                      # elide index
    println(a[2]);                                      # elide index
    println(a[0:3][]);                                  # elide slice
    println(a[3:3][]);                                  # elide slice
    println(a[1:3][1]);                                 # elide slice; keep index
    println(a[0:3][1:2][]);                             # elide slice; keep slice
    println(make_array(101)[1]);                        # elide index
    println(make_array(102)[1:2][]);                     # elide slice
    println(make_array(103)[mark(104,2)]);               # keep index
    println(make_array(105)[mark(106,1):mark(107,3)][]); # keep slice
    println(a[1+1]);                                    # elide index
    println(a[0:1+1][]);                                # elide slice
    println(a[(-9 / 4) + (7 % 4) * 1]);                 # elide index
}
