# The same genuine LLSynth grammar handles declarations and semantic deltas.
.language "FFIHandler"
.skip /[ \t\r\n]+/
.skip /#[^\n]*/
.token NAME: String = /[A-Za-z_][A-Za-z_0-9-]*/
.token NUMBER: String = /[0-9]+/
.token STRING: String = /"([^"\\\r\n]|\\["\\nrt])*"/

.rule Start
'syntax: Header Document EOF
'semantics: return nil;
.end
.rule Document
'syntax: Modules | Target TargetBody
.end
.rule Target
'syntax: "target" STRING Word STRING Word ";"
.end
.rule TargetBody
'syntax: TypedModule | Extension
.end
.rule Header
'syntax: "ffi" NUMBER ";"
.end
.rule Modules
'syntax: Modules Module | Module
.end
.rule Module
'syntax: "foreign" Word "." Word "{" "provider" Word STRING ";" "header" STRING ";" Functions "}"
.end
.rule Functions
'syntax: Functions Function | Function
.end
.rule Function
'syntax: Inline "fn" Word "(" Params ")" "->" Word "=" "c" "::" Word Guard ";"
.end
.rule Inline
'syntax: "inline" |
.end
.rule Params
'syntax: Param ParamTail |
.end
.rule Param
'syntax: Word ":" Word
.end
.rule ParamTail
'syntax: "," Param ParamTail |
.end
.rule Guard
'syntax: "requires" Word "<=" Word |
.end
.rule TypedModule
'syntax: "foreign" Word "." Word "{" "provider" Word STRING ";" "header" STRING ";" TypedBody "}"
.end
.rule TypedBody
'syntax: "unavailable" "reason" Word Audit ";" | Entries | GraphBody
.end
.rule Audit
'syntax: "audit" STRING |
.end
.rule Entries
'syntax: Entries Entry |
.end
.rule Entry
'syntax: TypedFunction | Unsupported
.end
.rule TypedFunction
'syntax: "fn" Word "(" Params ")" "->" Word "=" "c" "::" Word "native" Word Word "(" NativeTypes ")" "->" NativeType "profile" Word Effects Guards ";"
.end
.rule Unsupported
'syntax: "unsupported" Word "=" "c" "::" Word "reason" Word ";"
.end
.rule NativeTypes
'syntax: NativeType NativeTail |
.end
.rule NativeTail
'syntax: "," NativeType NativeTail |
.end
.rule NativeType
'syntax: Word NativeLayout
.end
.rule NativeLayout
'syntax: "(" Word "," NativeFields ")" |
.end
.rule NativeFields
'syntax: NUMBER "," NUMBER "," Word "," NUMBER "," NUMBER | Word "," NUMBER "," NUMBER "," NUMBER
.end
.rule Effects
'syntax: "effects" Word |
.end
.rule Guards
'syntax: Guards PositionGuard |
.end
.rule PositionGuard
'syntax: "requires" NUMBER "<=" NUMBER
.end
.rule Extension
'syntax: "extend" Word "." Word "{" Overrides "}"
.end
.rule Overrides
'syntax: Overrides OverrideItem | OverrideItem
.end
.rule OverrideItem
'syntax: Override | Selection | Obligation | Adapt
.end
.rule Selection
'syntax: "select" "c" "::" Word ";"
.end
.rule Obligation
'syntax: "obligation" Word Audit ";"
.end
.rule Override
'syntax: "fn" "c" "::" Word "fingerprint" STRING Guards ";"
.end
.rule Adapt
'syntax: "adapt" "c" "::" Word "fingerprint" STRING "surface" "(" SurfaceParams ")" "->" SurfaceShape "effects" Word "plan" "{" PlanOps "}"
.end
.rule SurfaceParams
'syntax: SurfaceParam SurfaceTail |
.end
.rule SurfaceTail
'syntax: "," SurfaceParam SurfaceTail |
.end
.rule SurfaceParam
'syntax: Word Word ":" SurfaceShape
.end
.rule SurfaceShape
'syntax: Word SurfaceArgs
.end
.rule SurfaceArgs
'syntax: "(" QualifiedName "," SurfaceShape "," SurfaceShape ")" | "(" QualifiedName ")" | "(" Word "," NUMBER ")" |
.end
.rule QualifiedName
'syntax: Word "." Word "." Word
.end
.rule PlanOps
'syntax: PlanOps PlanOp |
.end
.rule PlanOp
'syntax: Word "(" Operands ")" ";"
.end
.rule Operands
'syntax: Operand OperandTail |
.end
.rule OperandTail
'syntax: "," Operand OperandTail |
.end
.rule Operand
'syntax: SignedNumber | Word OperandIndex
.end
.rule OperandIndex
'syntax: "(" NUMBER ")" |
.end
.rule GraphBody
'syntax: Companion Graphs Discoveries
.end
.rule Companion
'syntax: "companion" Word ";" |
.end
.rule Graphs
'syntax: Graphs Graph | Graph
.end
.rule Graph
'syntax: "graph" NUMBER GraphOrigin "{" Tags "}"
.end
.rule GraphOrigin
'syntax: "companion" Word |
.end
.rule Tags
'syntax: Tags Tag |
.end
.rule Tag
'syntax: "tag" NUMBER Word TagName TagBody
.end
.rule TagName
'syntax: STRING | "none"
.end
.rule TagBody
'syntax: "incomplete" ";" | "complete" "(" Layout "," Layout ")" "{" TagItems "}"
.end
.rule TagItems
'syntax: TagItems TagItem |
.end
.rule TagItem
'syntax: Field | Underlying | EnumCase
.end
.rule Field
'syntax: "field" TagName "at" Layout ":" RichType FieldFlags ";"
.end
.rule FieldFlags
'syntax: "bit-field" "(" Layout "," Layout "," Layout ")" | "flexible" |
.end
.rule Underlying
'syntax: "underlying" RichType ";"
.end
.rule EnumCase
'syntax: "case" STRING "=" SignedNumber ";"
.end
.rule SignedNumber
'syntax: "-" NUMBER | NUMBER
.end
.rule Layout
'syntax: NUMBER | "unknown"
.end
.rule Discoveries
'syntax: Discoveries Discovery | Discovery
.end
.rule Discovery
'syntax: "discover" Word "=" "c" "::" Word "native" Word Word "graph" NUMBER RichFunction Specifiers "reason" Word ";"
.end
.rule Specifiers
'syntax: "specifiers" "(" Words ")" |
.end
.rule Words
'syntax: Words Word |
.end
.rule RichFunction
'syntax: "function-type" "(" Word "," "(" RichTypes ")" "," RichType ")"
.end
.rule RichType
'syntax: RichPrimitive | Pointer | Array | Qualified | TagRef | RichFunction
.end
.rule RichPrimitive
'syntax: PrimitiveAtom NativeLayout
.end
.rule PrimitiveAtom
'syntax: "void" | "integer" | "real"
.end
.rule Pointer
'syntax: "pointer" "(" Layout "," Layout "," Layout "," RichType ")"
.end
.rule Array
'syntax: "array" "(" Layout "," Layout "," Layout "," RichType ")"
.end
.rule Qualified
'syntax: "qualified" "(" Qualifiers "," RichType ")"
.end
.rule Qualifiers
'syntax: Qualifiers "+" Word | Word
.end
.rule TagRef
'syntax: "tag-ref" "(" NUMBER ")"
.end
.rule RichTypes
'syntax: RichType RichTail |
.end
.rule RichTail
'syntax: "," RichType RichTail |
.end
# Contextual keywords: C parameter names and module aliases need not be renamed
# merely because they share a spelling with a declaration keyword.
.rule Word
'syntax: NAME | "ffi" | "target" | "foreign" | "provider" | "header" | "fn" | "c" | "inline" | "requires" | "unavailable" | "reason" | "unsupported" | "native" | "profile" | "effects" | "extend" | "fingerprint" | "select" | "obligation"
       | "graph" | "tag" | "none" | "unknown" | "companion" | "complete" | "incomplete" | "field" | "at" | "bit-field" | "flexible" | "underlying" | "case" | "discover" | "specifiers" | "audit"
       | "function-type" | "void" | "integer" | "real" | "pointer" | "array" | "qualified" | "tag-ref"
       | "adapt" | "surface" | "plan"
.end
