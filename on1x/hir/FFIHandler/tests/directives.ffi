; Synthetic build input for exercising the generated table and MIR selectors.
(ffispec 1 (kernel ffifixture) (header mulib-ffifixture.h)
  (sha256 e9fdf1fa52b4ad50496d0a7da9dc75bb6f12cfc2d0fbfc3a283fc25c6e1dcbc7)
  (target x86_64-unknown-linux-gnu)
  (export bump mulib_ffifixture_bump (params x)
    (guard true)
    (body (if (lt x 9223372036854775807) (add x 1) x))
    (backend mir-c11)
    (hint kernel-hot)
    (hint cold-code (speculative))
    (hint no-inline)
    (hint private-code (target *))
    (hint canonicalized (backend *))
    (hint local-memory (backend mir-vm) (target *))
    (rewrite fold-identity (backend *) (target *) (speculative))
    (rewrite memgraph-local)
    (rewrite meta-canonical (backend mir-vm) (target *) (speculative)))
  (export floor mulib_ffifixture_floor (params x)
    (guard true)
    (body (if (lt x 0) 0 x))
    (hint no-inline (backend mir-c11)))
  (export zero mulib_ffifixture_zero (params)
    (guard true)
    (body 0)))
