(interface 1
  (target "x86_64-linux-gnu")
  (data-model LP64)
  (abi "SysVAMD64")
  (tag 0 struct "Node" (complete true) (layout (size 16) (align 8))
    (field "next" (offset 0)
      (type (pointer (bits 64) (size 8) (align 8) (pointee (tag-ref 0)))))
    (field "bits" (offset 8)
      (bit-field (width 3) (shift 0) (container-offset 8))
      (type (integer unsigned-int (rank 3) (bits 32) (signed false) (size 4) (align 4))))
    (field "tail" (offset 9) (flexible-array true)
      (type (array (count unknown) (size unknown) (align 1)
        (element (integer unsigned-char (rank 1) (bits 8) (signed false) (size 1) (align 1)))))))
  (tag 1 struct "Node" (complete false))
  (tag 2 enum none (complete true)
    (underlying (integer int (rank 3) (bits 32) (signed true) (size 4) (align 4)))
    (enumerator "Negative" -2) (enumerator "Zero" 0))
  (typedef "Opaque" (type (tag-ref 1)))
  (typedef "Word" (type (integer unsigned-long (rank 4) (bits 64) (signed false) (size 8) (align 8))))
  (typedef "Wide" (type (integer unsigned-long-long (rank 5) (bits 64) (signed false) (size 8) (align 8))))
  (object "incomplete" (linkage external) (storage extern)
    (definition declaration) (layout (size unknown) (align unknown)) (type (tag-ref 1)))
  (object "flag" (linkage internal) (storage static extern)
    (definition tentative) (layout (size 1) (align 16))
    (type (integer bool (rank 0) (bits 1) (signed false) (size 1) (align 1))))
  (function "visit" (linkage external) (storage none) (definition declaration)
    (calling-convention sysv) (parameter-names none "none") (specifiers)
    (type (function-type (prototype true) (variadic true) (result (tag-ref 2))
      (parameters
        (pointer (bits 64) (size 8) (align 8)
          (pointee (qualified (qualifiers const volatile) (tag-ref 0))))
        (integer char (rank 1) (bits 8) (signed true) (size 1) (align 1)))))))
