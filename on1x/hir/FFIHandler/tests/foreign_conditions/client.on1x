from std.core.Pervasive import Result;
import CephyrCondition as Condition;

extern fn fixture_projection_calls() -> i64;
extern fn fixture_projection_status(mode: i64) -> i64;
extern fn on1x_unique_live_allocations() -> i64;

enum Payload { Payload(i64) }

fn report(tag: i64, live: i64) {
    println(tag);
    assert(on1x_unique_live_allocations() == live);
}

fn acquire(mode: i64) -> Result<own<Payload>, Condition.ForeignCondition> {
    let owner = box(variant<Payload>(Payload, mode + 42));
    defer report(1, 1);
    defer report(2, 1);
    let status = Condition.signal_status(fixture_projection_status(mode))?;
    assert(status == 0);
    return variant<Result<own<Payload>, Condition.ForeignCondition>>(Ok, move(owner));
}

fn compute(mode: i64) -> Result<i64, Condition.ForeignCondition> {
    defer report(3, 0);
    let owner = acquire(mode)?;
    let payload = take(owner);
    return match payload with {
        Payload(value) => variant<Result<i64, Condition.ForeignCondition>>(Ok, value)
    };
}

fn main() {
    match compute(0) with {
        Ok(value) => assert(value == 42), Err(_) => assert(false)
    };
    match compute(1) with {
        Ok(_) => assert(false),
        Err(condition) => match condition with {
            CompileError(code) => assert(code == 1), _ => assert(false)
        }
    };
    match compute(2) with {
        Ok(_) => assert(false),
        Err(condition) => match condition with {
            InvalidArgument(code) => assert(code == 2), _ => assert(false)
        }
    };
    # Direct classifier controls, not claims these values came from the call.
    match Condition.signal_status(3) with {
        Ok(_) => assert(false),
        Err(condition) => match condition with {
            InternalError(code) => assert(code == 3), _ => assert(false)
        }
    };
    match Condition.signal_status(4) with {
        Ok(_) => assert(false),
        Err(condition) => match condition with {
            UnrecognizedStatus(code) => assert(code == 4), _ => assert(false)
        }
    };
    assert(fixture_projection_calls() == 3);
    assert(on1x_unique_live_allocations() == 0);
    println(42);
}
