{
  "schema": "on1x.exotract-catalog/v1",
  "manifest": "MANIFEST.yaml",
  "headers": "include/mulib-*.h",
  "implementation_translation_units": 1,
  "safe_export": false,
  "profiles": {
    "json": {"recipe": "exoml-core", "required_symbols": ["mulib_json_parse", "mulib_json_destroy"]},
    "vec": {"recipe": "exoml-core", "required_symbols": ["mulib_vec_init", "mulib_vec_free"]},
    "parsec": {"recipe": "exoml-core", "required_symbols": ["mulib_parsec_run"]},
    "microjs": {"recipe": "manifest", "required_symbols": ["mulib_microjs_create", "mulib_microjs_destroy"], "link_libraries": ["m"]}
  },
  "default_recipe": "manifest"
}
