memgraph 1;
budget steps 1048576 nodes 131072 depth 128;
patterns memory;
check checked_index priority 980
match Index($container, $index)
requires container_layout_known, bounds_proven_or_checked, index_effects_preserved
 diagnostic "MMG-MEM-INDEX";
check slice_region priority 960
match Slice($container, $range)
requires provenance_valid, capacity_contract_valid, bounds_proven_or_checked, slice_lifetime_within_origin, slice_range_order_checked
 diagnostic "MMG-MEM-SLICE";
check raw_buffer priority 940
match BufferMutate($buffer, $payload)
requires mutable_buffer, capacity_contract_valid, allocation_failure_preserved
 diagnostic "MMG-MEM-BUFFER";
reject freed_access priority 999
match Load($place)
when known_freed_origin
 diagnostic "MMG-MEM-UAF";
reject escaped_address priority 998
match EscapePlace($place)
when place_exceeds_lexical_lifetime
 diagnostic "MMG-MEM-ESCAPE";
endpatterns;
