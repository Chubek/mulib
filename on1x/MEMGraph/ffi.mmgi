memgraph 1;
budget steps 1048576 nodes 131072 depth 128;
patterns ffi;
# Safe admission is checked against host-supplied signed evidence; no rule
# creates or upgrades approval. UnsafeForeignCall is a distinct checked node.
check safe_foreign_call priority 990
match ForeignCall($target, $args)
requires safe_admission_independent, exact_cdecl_abi, target_revision_pinned, supported_effect_profile, error_contract_preserved, callback_policy_valid, pointer_ownership_verified
 diagnostic "MMG-FFI-ADMISSION";
check string_borrow priority 980
match CStringBorrow($text)
requires immutable_call_scoped_input, no_embedded_nul, byte_limit_checked, no_foreign_retention
 diagnostic "MMG-FFI-CSTR";
check static_string_result priority 970
match StaticCString($result)
requires approved_static_lifetime, null_result_checked, immutable_static_result, bounded_result_scan
 diagnostic "MMG-FFI-STATIC";
check raw_call_boundary priority 960
match UnsafeForeignCall($target, $args)
requires explicit_unsafe_context, exact_cdecl_abi, raw_effects_conserved
 diagnostic "MMG-FFI-RAW";
reject unreviewed_safe_call priority 1000
match ForeignCall($target, $args)
when missing_independent_review
 diagnostic "MMG-FFI-UNREVIEWED";
reject stale_foreign_contract priority 999
match ForeignCall($target, $args)
when stale_target_or_signature
 diagnostic "MMG-FFI-STALE";
reject unknown_pointer_owner priority 998
match ForeignCall($target, $args)
when unsupported_pointer_ownership
 diagnostic "MMG-FFI-OWNER";
endpatterns;
