%% provenance: Source revision, file/line and hash citations
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{on1x-provenance}[2026/11/24 v0.1 On1x book: provenance]
\RequirePackage{on1x-boxes}
\newcommand{\OnxRevision}[1]{\texttt{\detokenize{#1}}}
\newcommand{\OnxSourceSpan}[3]{\texttt{\detokenize{#1}} (lines #2--#3)}
\RequirePackage{seqsplit}
\newcommand{\OnxSourceHash}[1]{\textsf{sha256:}\,\texttt{\seqsplit{#1}}}
\newenvironment{OnxEvidence}{\begin{OnxPanel}[colframe=onxSuccess,colback=onxSuccess!3!white]{Source evidence}}{\end{OnxPanel}}

