%% core: Shared metadata, author-facing notation, and theme colors
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{on1x-core}[2026/11/24 v0.1 On1x book: core]
\RequirePackage{xcolor}
\RequirePackage{xparse}
\definecolor{onxInk}{HTML}{1D2B3A}
\definecolor{onxAccent}{HTML}{125A78}
\definecolor{onxAccentLight}{HTML}{EAF4F7}
\definecolor{onxGold}{HTML}{9A6D20}
\definecolor{onxDanger}{HTML}{A83442}
\definecolor{onxSuccess}{HTML}{24694B}
\definecolor{onxRule}{HTML}{C9D6DE}
\newcommand{\OnxSetAccent}[1]{\colorlet{onxAccent}{#1}}
\newcommand{\OnxBookTitle}[1]{\title{#1}}
\newcommand{\OnxBookAuthor}[1]{\author{#1}}
\newcommand{\OnxBookDate}[1]{\date{#1}}
\newcommand{\OnxLanguage}{\textsc{On1x}}
\newcommand{\OnxMuLIB}{\textsc{MuLIB}}
\newcommand{\OnxTerm}[1]{\textsf{#1}}
\newcommand{\OnxEmphasis}[1]{{\color{onxAccent}\bfseries #1}}
\NewDocumentCommand{\OnxMeta}{m}{\ensuremath{\langle\textit{#1}\rangle}}
\NewDocumentCommand{\OnxFile}{m}{\texttt{\detokenize{#1}}}

\endinput
