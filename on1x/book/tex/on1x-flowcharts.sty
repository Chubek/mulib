%% flowcharts: Decision and procedure flowchart nodes
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{on1x-flowcharts}[2026/11/24 v0.1 On1x book: flowcharts]
\RequirePackage{on1x-diagrams}
\newenvironment{OnxFlowchart}{\begin{center}\begin{tikzpicture}[node distance=12mm]}{\end{tikzpicture}\end{center}}
\newcommand{\OnxDecision}[3][]{\node[diamond,draw=onxGold,aspect=2,align=center,#1] (#2) {#3};}
\newcommand{\OnxProcess}[3][]{\node[onxnode,#1] (#2) {#3};}
\newcommand{\OnxFlowArrow}[3][]{\draw[onxarrow,#1] (#2) -- (#3);}

\endinput
