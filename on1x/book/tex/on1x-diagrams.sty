%% diagrams: TikZ defaults for compiler and architecture diagrams
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{on1x-diagrams}[2026/11/24 v0.1 On1x book: diagrams]
\RequirePackage{on1x-core}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,fit,calc,shapes.geometric}
\tikzset{onxnode/.style={draw=onxAccent,rounded corners,fill=onxAccentLight,thick,inner sep=6pt,font=\sffamily\small,align=center},onxarrow/.style={-{Stealth[length=2mm]},thick,draw=onxAccent}}
\newenvironment{OnxDiagram}{\begin{center}\begin{tikzpicture}[node distance=15mm]}{\end{tikzpicture}\end{center}}
\newcommand{\OnxDiagramNode}[3][]{\node[onxnode,#1] (#2) {#3};}
\newcommand{\OnxDiagramArrow}[2]{\draw[onxarrow] (#1) -- (#2);}

\endinput
