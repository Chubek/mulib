enum List { Nil, Cons(i64, own<List>) }

fn empty() -> own<List> {
  return box(variant<List>(Nil, record{}));
}

fn prepend(item: i64, tail: own<List>) -> own<List> {
  return box(variant<List>(Cons, (item, move(tail))));
}

fn sum(values: own<List>) -> i64 {
  var cursor = move(values);
  var total = 0;
  return loop {
    let node = take(cursor);
    match node with {
      Nil() => { break with total; },
      Cons(item, tail) => {
        total = total + item;
        cursor = move(tail);
      }
    };
  };
}

fn main() {
  assert(sum(empty()) == 0);
  let start = empty();
  let rest = prepend(5, move(start));
  let list = prepend(8, move(rest));
  println(sum(move(list)));
}
