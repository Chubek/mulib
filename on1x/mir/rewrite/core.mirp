mir-policy 1;

rewrite "fold-identity" backend * target * enables additive-identities;
rewrite "fold-identity" backend * target * enables multiplicative-identities;
rewrite "fold-identity" backend * target * enables division-units;
rewrite "fold-identity" backend * target * enables guarded-division;
rewrite "fold-identity" backend * target * enables scalar-equality;
rewrite "fold-identity" backend * target * enables ordered-reflexivity;
rewrite "fold-identity" backend * target * enables boolean-negation;
rewrite "fold-identity" backend * target * enables boolean-comparisons;

hint "kernel-hot" backend * target * enables additive-identities;
hint "kernel-hot" backend * target * enables multiplicative-identities;
hint "kernel-hot" backend * target * enables division-units;
hint "kernel-hot" backend * target * enables guarded-division;
hint "canonicalized" backend * target * enables scalar-equality;
hint "canonicalized" backend * target * enables ordered-reflexivity;
hint "canonicalized" backend * target * enables boolean-negation;
hint "canonicalized" backend * target * enables boolean-comparisons;
hint "local-memory" backend * target * enables store-forwarding;
hint "local-memory" backend * target * enables load-reuse;
