# Canonical serialized MIR and the build-time specialization policy.
# The C++ decoder/verifier remains authoritative for wire admission.
.language "MIR"
.skip /[ \t\r\n]+/
.skip /#[^\n]*/
.token NAME: String = /[A-Za-z_][A-Za-z_0-9-]*/
.token UNSIGNED: String = /[0-9]+/
.token NEGATIVE: String = /-[0-9]+/
.token STRING: String = /"([\x20-\x21\x23-\x5b\x5d-\x7e]|\\(["\\nrt]|x[0-9A-Fa-f][0-9A-Fa-f]))*"/

.rule Start
'syntax: PolicyDocument EOF | MirEnvelope EOF
'semantics: return nil;
.end
.rule PolicyDocument
'syntax: "mir-policy" Integer ";" Declarations
.end
.rule Declarations
'syntax: Declarations Declaration |
.end
.rule Declaration
'syntax: Activation | Pattern
.end
.rule Activation
'syntax: Kind STRING Condition "enables" PolicyName ";"
.end
.rule Kind
'syntax: "hint" | "rewrite"
.end
.rule Condition
'syntax: "backend" Selector "target" Selector
.end
.rule Selector
'syntax: "*" | STRING
.end
.rule Pattern
'syntax: "pattern" PolicyName Condition "class" PolicyName "mode" Mode "match" STRING "(" Arguments ")" "replace" Atom "requires" PolicyName ";"
.end
.rule Mode
'syntax: "safe" | "speculative"
.end
.rule Arguments
'syntax: Atom Tail |
.end
.rule Tail
'syntax: "," Atom Tail |
.end
.rule Atom
'syntax: "$" PolicyName | Integer
.end
# Wire literals have lexer precedence over NAME. Keep them usable as policy
# names where they were ordinary identifiers before the wire grammar.
.rule PolicyName
'syntax: NAME | SimpleOpcode | MirScalar | ExitKind | Boolean | "function" | "block" | "at" | "value" | "instruction" | "numeric" | "exit" | "edge" | "directive"
.end

# Versions 1–3 share one envelope. Version 4 appends a directive list (possibly
# empty). The verifier enforces each version's admitted types and opcodes.
.rule MirEnvelope
'syntax: "(" "on1x.mir" LegacyVersion Unsigned Functions ")" | "(" "on1x.mir" "4" Unsigned Functions Directives ")"
.end
.rule LegacyVersion
'syntax: "1" | "2" | "3"
.end
.rule Unsigned
'syntax: UNSIGNED | "1" | "2" | "3" | "4"
.end
.rule Integer
'syntax: Unsigned | NEGATIVE
.end
.rule Functions
'syntax: "(" FunctionItems ")"
.end
.rule FunctionItems
'syntax: FunctionItems Function |
.end
.rule Function
'syntax: "(" "function" Unsigned STRING MirType Location Values Blocks ")"
.end
.rule Blocks
'syntax: "(" BlockItems ")"
.end
.rule BlockItems
'syntax: BlockItems Block |
.end
.rule Block
'syntax: "(" "block" Unsigned Unsigned Location Values Instructions Terminator ")"
.end
.rule MirType
'syntax: MirScalar | "(" "tuple" "(" MirType MirType TypeItems ")" ")"
.end
.rule MirScalar
'syntax: "i64" | "bool" | "void" | "f64" | "f32" | "u8" | "u16" | "u32" | "u64"
.end
.rule TypeItems
'syntax: TypeItems MirType |
.end
.rule Location
'syntax: "(" "at" STRING Unsigned Unsigned Unsigned ")"
.end
.rule Values
'syntax: "(" ValueItems ")"
.end
.rule ValueItems
'syntax: ValueItems Value |
.end
.rule Value
'syntax: "(" "value" Unsigned MirType Location ")"
.end
.rule Ids
'syntax: "(" IdItems ")"
.end
.rule IdItems
'syntax: IdItems Unsigned |
.end
.rule Instructions
'syntax: "(" InstructionItems ")"
.end
.rule InstructionItems
'syntax: InstructionItems Instruction |
.end
.rule Instruction
'syntax: "(" "instruction" Unsigned Opcode InstructionFields ")" | "(" "instruction" Unsigned "numeric" InstructionFields STRING ")"
.end
.rule InstructionFields
'syntax: MirType Ids Integer Unsigned Unsigned Unsigned Location
.end
.rule Opcode
'syntax: SimpleOpcode | "add.checked" | "sub.checked" | "mul.checked" | "div.checked" | "mod.checked" | "neg.checked" | "f64.add" | "f64.sub" | "f64.mul" | "f64.div" | "f64.neg" | "f64.eq" | "f64.ne" | "f64.lt" | "f64.le" | "f64.gt" | "f64.ge" | "f64.from-i64" | "f64.to-i64" | "f64.from-bits" | "f64.to-bits" | "f64.is-nan" | "f64.is-finite" | "f64.signbit"
.end
.rule SimpleOpcode
'syntax: "const" | "not" | "eq" | "ne" | "lt" | "le" | "gt" | "ge" | "load" | "store" | "call" | "print" | "assert" | "tuple" | "extract"
.end
.rule Terminator
'syntax: "(" "exit" Unsigned ExitKind Unsigned Unsigned Edges Location ")"
.end
.rule ExitKind
'syntax: "return" | "jump" | "branch"
.end
.rule Edges
'syntax: "(" EdgeItems ")"
.end
.rule EdgeItems
'syntax: EdgeItems Edge |
.end
.rule Edge
'syntax: "(" "edge" Unsigned Ids ")"
.end
.rule Directives
'syntax: "(" DirectiveItems ")"
.end
.rule DirectiveItems
'syntax: DirectiveItems Directive |
.end
.rule Directive
'syntax: "(" "directive" STRING STRING STRING STRING Unsigned Boolean ")"
.end
.rule Boolean
'syntax: "true" | "false"
.end
