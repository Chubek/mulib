%prefix on1x
%option enums no-line-directives
%%
-- Aurocks owns a temporary arena of these tokens, then reports copies to C++.
-- The checked and lowered language AST lives in the C++ frontend.
token = Tok(string text, usize offset, token? previous)
unit = (token? last)

.language "On1x";
.summary "Scanner tokens, source module facts and loader observations";
.unit :source_module;

-- This view is copied from a parser-owned Unit before resolution. It is
-- neither a PPX wire type nor an import or export authorization.
source_module ::= (module_header? header, source_import* imports, source_decl* declarations);
module_header ::= (string<:module_name> name);
source_import ::= ModuleRequest(string<:import_target> spelling, string<:import_alias>? alias, usize relative,
                                bool quoted, bool selective, source_selector* selectors)
                | ProgramRequest(string<:import_target> spelling, string<:import_alias>? alias, usize relative,
                                 bool quoted, bool selective, source_selector* selectors);
source_selector ::= (string<:selector_spelling> name, string<:import_alias>? alias, bool is_operator);
source_decl ::= (string name, string kind, source_visibility visibility);
-- Decimal retains the entire unsigned host value, even above Lua's signed range.
source_visibility ::= SourcePublic | SourcePrivate | SourceShared(string<:source_elevation> elevation);

-- Post-verification facts, not a second type checker or import resolver.
source_signature ::= (string name, signature_member* members);
signature_member ::= AbstractType(string name, usize arity)
                   | FunctionSignature(string name)
                   | ProcedureSignature(string name);
source_graph ::= (string* paths, source_edge* edges);
source_edge ::= (usize importer, usize provider);

-- Resolved source observations; logistics only presents them.
source_unused ::= (unused_binding* bindings);
unused_binding ::= UnusedImport(string name, string kind)
                 | UnusedVariable(string name, string kind)
                 | UnusedType(string name, string kind);

.logistics for :source_module ::= lua(root)
    local header, imports, declarations = asdl.destruct(root)
    local depth = 0
    if header then
        depth = asdl.logistics(header)
        if not depth then return root end
    end
    for _, edge in ipairs(imports) do asdl.logistics(edge) end
    for _, declaration in ipairs(declarations) do asdl.logistics(declaration, depth) end
    return root
.end

.logistics for :module_header ::= lua(header) -> (depth)
    return asdl.logistics_context().value.policy.Header(header)
.end

.logistics for :source_decl ::= lua(declaration, depth) -> (checked)
    return asdl.logistics_context().value.policy.Declaration(declaration, depth)
.end

.logistics for :source_import ::= lua(edge)
    return asdl.logistics_context().value.imports.Check(edge)
.end

.logistics for :source_signature ::= lua(signature)
    return asdl.logistics_context().value.signatures.Check(signature)
.end

.logistics for :source_graph ::= lua(graph)
    return asdl.logistics_context().value.graph.Check(graph)
.end

.logistics for :source_unused ::= lua(batch)
    local bindings = asdl.destruct(batch)
    for _, binding in ipairs(bindings) do asdl.logistics(binding) end
    return batch
.end

.logistics for :unused_binding ::= lua(binding)
    local libraries = asdl.logistics_context().value
    return libraries.unused.Report(libraries.diagnostics, binding)
.end
