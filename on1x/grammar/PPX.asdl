%prefix on1xppx
%option enums no-line-directives
%%
-- The portable concrete S-expression tree. PPX.schema.json refines List into
-- versioned, category-checked AST constructors; C++ owns all retained strings.
-- Operator references and applications contain source spellings, never
-- declaration identities. The host validates declaration and fixity
-- admission and assigns fresh identities to synthesized source declarations.
wire = Symbol(string value) | Text(string value) | List(wire* elements)

-- Source metadata v1 is a separate, read-only semantic packet: never a Unit
-- field or an extension output capability. Locations are informational, not
-- declaration identities, import resolutions, or package authority.
source_point = (string file, usize offset, usize line, usize column)
source_module_header = SourceAnonymousModule | SourceModuleHeader(string* components, source_point location)
source_import_target = SourceNamedTarget(string* components) | SourceQuotedTarget(string spelling)
source_selector = SourceValueSelector(string name, string? alias) | SourceOperatorSelector(string spelling)
source_import = SourceModuleImport(source_import_target target, usize relative_depth, bool selective, string? alias, source_selector* selectors, source_point location)
              | SourceProgramImport(source_import_target target, bool selective, string? alias, source_selector* selectors, source_point location)
source_visibility = SourcePublic | SourceShared(usize elevation) | SourcePrivate
source_declaration_visibility = SourceDeclarationVisibility(string kind, string spelling, source_visibility visibility, source_point location) | SourceOperatorVisibility(string spelling, source_visibility visibility, source_point location)
source_module_metadata = (usize version, source_module_header header, source_import* requests, source_declaration_visibility* declarations)
