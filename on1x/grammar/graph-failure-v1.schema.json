{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:on1x:graph-failure:v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "status", "graph", "diagnostics"],
  "properties": {
    "schema": {"const": "on1x.graph-failure/v1"}, "status": {"const": "partial"},
    "graph": {"enum": ["import", "module"]},
    "diagnostics": {"type": "array", "minItems": 1, "maxItems": 1,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["id", "source", "byteOffset"],
        "properties": {"id": {"type": "string", "minLength": 1},
          "source": {"type": "string"}, "byteOffset": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$"}}}}
  }
}
