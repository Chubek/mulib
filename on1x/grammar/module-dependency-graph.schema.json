{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "status",
    "snapshot",
    "roots",
    "packages",
    "nodes",
    "edges",
    "auxiliary",
    "diagnostics",
    "internal",
    "sccs",
    "cycles",
    "order"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "on1x.module-dependency-graph/v1"
    },
    "status": {
      "const": "resolved"
    },
    "snapshot": {
      "type": "object",
      "required": [
        "id",
        "policy",
        "oml"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "policy": {
          "type": "string"
        },
        "oml": {
          "type": "string"
        }
      }
    },
    "roots": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 1024
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 1024
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "name",
          "package",
          "fragments"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "named",
              "program",
              "initializer",
              "legacy"
            ]
          },
          "name": {
            "type": "string"
          },
          "package": {
            "type": "string"
          },
          "fragments": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 1024
          }
        }
      },
      "maxItems": 1024
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "target",
          "witnesses"
        ],
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "witnesses": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 16384
          }
        }
      },
      "maxItems": 65536
    },
    "auxiliary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "source",
          "target",
          "revision"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "signature",
              "prelude"
            ]
          },
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          }
        }
      },
      "maxItems": 16384
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 0
    },
    "internal": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "target",
          "witnesses"
        ],
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "witnesses": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 16384
          }
        }
      },
      "maxItems": 65536
    },
    "sccs": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "maxItems": 1024
      },
      "maxItems": 1024
    },
    "cycles": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "maxItems": 1025
      },
      "maxItems": 1
    },
    "order": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 1024
    }
  }
}
