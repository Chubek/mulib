%YAML 1.2
---
name: On1x
file_extensions: [on1x, on1xi]
scope: source.on1x

variables:
  ident: '[A-Za-z_][A-Za-z0-9_]*'

contexts:
  main:
    - include: comments
    - include: characters
    - include: strings
    - include: declarations
    - include: metaprogramming
    - include: keywords
    - include: literals
    - include: punctuation

  comments:
    - match: '#(?!\\)'
      scope: punctuation.definition.comment.on1x
      push:
        - meta_scope: comment.line.number-sign.on1x
        - match: $
          pop: true
    - match: '\{-'
      push: dash-comment
    # A compact block starting with a PPX invocation is not a comment.
    - match: '\{@(?!{{ident}}[ \t]*\()'
      push: at-comment
    - match: '\{[!>]'
      push:
        - meta_scope: comment.block.documentation.on1x
        - match: '\}'
          pop: true

  dash-comment:
    - meta_scope: comment.block.on1x
    - match: '-\}'
      pop: true
    - include: nested-comments

  at-comment:
    - meta_scope: comment.block.on1x
    - match: '@\}'
      pop: true
    - include: nested-comments

  nested-comments:
    - match: '\{-'
      push: dash-comment
    - match: '\{@'
      push: at-comment

  characters:
    - match: '(?:(?<![A-Za-z0-9_])b!)?#\\(?:(?:[uU]\+[0-9A-Fa-f]+|[xX][0-9A-Fa-f]+|[oO][0-7]+|space|newline|tab|return|alarm|backspace|escape|delete|nul|null|pound|[A-Za-z0-9_])(?![A-Za-z0-9_])|[^A-Za-z0-9_ \t\r\n])'
      scope: constant.character.on1x

  strings:
    - match: '(?<![A-Za-z0-9_])r!"""'
      scope: punctuation.definition.string.begin.on1x
      push:
        - meta_scope: string.quoted.double.raw.on1x
        - match: '"""'
          scope: punctuation.definition.string.end.on1x
          pop: true
    - match: "(?<![A-Za-z0-9_])r!'''"
      scope: punctuation.definition.string.begin.on1x
      push:
        - meta_scope: string.quoted.single.raw.on1x
        - match: "'''"
          scope: punctuation.definition.string.end.on1x
          pop: true
    - match: '(?<![A-Za-z0-9_])r!"'
      scope: punctuation.definition.string.begin.on1x
      push:
        - meta_scope: string.quoted.double.raw.on1x
        - include: single-line-double-end
    - match: '(?<![A-Za-z0-9_])b!"""'
      scope: punctuation.definition.string.begin.on1x
      push:
        - meta_scope: string.quoted.double.buffer.on1x
        - match: '"""'
          scope: punctuation.definition.string.end.on1x
          pop: true
        - include: buffer-escapes
    - match: "(?<![A-Za-z0-9_])b!'''"
      scope: punctuation.definition.string.begin.on1x
      push:
        - meta_scope: string.quoted.single.buffer.on1x
        - match: "'''"
          scope: punctuation.definition.string.end.on1x
          pop: true
        - include: apostrophe-escape
        - include: buffer-escapes
    - match: '(?<![A-Za-z0-9_])b!"'
      scope: punctuation.definition.string.begin.on1x
      push:
        - meta_scope: string.quoted.double.buffer.on1x
        - include: single-line-double-end
        - include: buffer-escapes
    - match: '"""'
      scope: punctuation.definition.string.begin.on1x
      push:
        - meta_scope: string.quoted.double.block.on1x
        - match: '"""'
          scope: punctuation.definition.string.end.on1x
          pop: true
        - include: text-body
    - match: "'''"
      scope: punctuation.definition.string.begin.on1x
      push:
        - meta_scope: string.quoted.single.block.on1x
        - match: "'''"
          scope: punctuation.definition.string.end.on1x
          pop: true
        - include: apostrophe-escape
        - include: text-body
    - match: '"'
      scope: punctuation.definition.string.begin.on1x
      push:
        - meta_scope: string.quoted.double.on1x
        - include: single-line-double-end
        - include: text-body
    # Triple backticks can span lines; the lexer does not interpret escapes here.
    - match: '```'
      scope: punctuation.definition.string.begin.on1x
      push:
        - meta_scope: string.quoted.other.command.block.on1x
        - match: '```'
          scope: punctuation.definition.string.end.on1x
          pop: true
    - match: '`(?!``)'
      scope: punctuation.definition.string.begin.on1x
      push:
        - meta_scope: string.quoted.other.command.on1x
        - match: '`'
          scope: punctuation.definition.string.end.on1x
          pop: true
        - match: '\\[^\r\n]'
          scope: constant.character.escape.on1x
        - match: '(?=[\r\n]|$)'
          pop: true

  single-line-double-end:
    - match: '"'
      scope: punctuation.definition.string.end.on1x
      pop: true
    - match: '(?=[\r\n]|$)'
      pop: true

  apostrophe-escape:
    - match: "\\\\'"
      scope: constant.character.escape.on1x

  buffer-escapes:
    - match: '\\(?:["\\nrt0]|x[0-9A-Fa-f]{2})'
      scope: constant.character.escape.on1x
    - include: invalid-escape

  text-body:
    - match: '\\["\\nrt$]|\$\$'
      scope: constant.character.escape.on1x
    - include: invalid-escape
    - match: '\$\{'
      scope: punctuation.section.interpolation.begin.on1x
      push:
        - meta_scope: meta.interpolation.on1x
        - match: '\}'
          scope: punctuation.section.interpolation.end.on1x
          pop: true
        - include: interpolation-source
    - match: '\${{ident}}'
      scope: variable.other.interpolated.on1x

  invalid-escape:
    - match: '\\(?:[^\r\n]|(?=[\r\n]|$))'
      scope: invalid.illegal.escape.on1x

  interpolation-source:
    - include: comments
    - match: '\{'
      scope: punctuation.section.group.begin.on1x
      push:
        - match: '\}'
          scope: punctuation.section.group.end.on1x
          pop: true
        - include: interpolation-source
    - include: main

  declarations:
    - match: '\b(fn|proc)[ \t]+({{ident}})(?=[ \t]*[<(])'
      captures:
        1: storage.type.function.on1x
        2: entity.name.function.on1x
    - match: '\b(record|enum)[ \t]+({{ident}})(?=[ \t]*[<{])'
      captures:
        1: storage.type.on1x
        2: entity.name.type.on1x
    - match: '^[ \t]*(on1xi)(?=[ \t]+[0-9])'
      captures:
        1: keyword.control.directive.on1x

  metaprogramming:
    - match: '\b(macro)[ \t]+({{ident}})'
      captures:
        1: storage.type.macro.on1x
        2: entity.name.function.preprocessor.on1x
    - match: '\b(?!(?:fn|proc|let|var|if|else|while|return|true|false|extern|import|forall|macro|rule|quote|splice|lift|let_syntax|letrec_syntax)\b)({{ident}})[ \t]*(!)(?=[ \t]*\()'
      captures:
        1: entity.name.function.preprocessor.on1x
        2: punctuation.definition.macro.on1x
    - match: '(\$)[ \t]*({{ident}})'
      captures:
        1: punctuation.definition.variable.on1x
        2: variable.parameter.macro.on1x
    - match: '(@)[ \t]*(ppx|scrutiny|enable|extension)\b(?=[ \t]+{{ident}})'
      captures:
        1: punctuation.definition.annotation.on1x
        2: keyword.control.directive.on1x
    - match: '(@)[ \t]*({{ident}})(?=[ \t]*\()'
      captures:
        1: punctuation.definition.annotation.on1x
        2: entity.name.function.preprocessor.on1x

  keywords:
    - match: '\bunsafe[ \t]+import[ \t]+foreign\b'
      scope: invalid.illegal.import.on1x
    - match: '\b(import)[ \t]+(foreign)[ \t]+(stdffi)[ \t]*(\.)[ \t]*({{ident}})(?![A-Za-z0-9_]|[ \t]*\.)'
      captures:
        1: keyword.control.on1x
        2: keyword.control.on1x
        3: entity.name.namespace.on1x
        4: punctuation.separator.on1x
        5: entity.name.module.on1x
    - match: '\b(import)[ \t]+(kernel)[ \t]*(\[)[ \t]*(dynlib)[ \t]*(\])'
      captures:
        1: keyword.control.on1x
        2: keyword.control.on1x
        3: punctuation.section.group.begin.on1x
        4: storage.modifier.on1x
        5: punctuation.section.group.end.on1x
    - match: '\b(import)[ \t]+(kernel)(?=[ \t]+(?!as\b){{ident}})'
      captures:
        1: keyword.control.on1x
        2: keyword.control.on1x
    - match: '\b(true|false)\b'
      scope: constant.language.boolean.on1x
    - match: '\b(if|else|while|return|import)\b'
      scope: keyword.control.on1x
    - match: '\b(let|var|extern|fn|proc)\b'
      scope: storage.type.on1x
    - match: '\boperator\b(?=[ \t]*[<(])'
      scope: keyword.declaration.operator.on1x
    - match: '\binfixr?\b(?=[ \t]+[0-9])'
      scope: keyword.control.directive.fixity.on1x
    - match: '\b(forall|macro|rule|quote|splice|lift|let_syntax|letrec_syntax)\b'
      scope: keyword.other.metaprogramming.on1x
    - match: '\b(block|expression|syntax_block)(?=[ \t]*\{)|\b(syntax_literal)(?=[ \t]*\()|\b(vector)(?=[ \t]*\[)'
      scope: keyword.other.metaprogramming.on1x
    # Parser-contextual words have local cues, not global keyword status.
    - match: '\b(from)(?=[ \t]+[.A-Za-z_])|\b(as|in)(?=[ \t]+[A-Za-z_0-9(])'
      scope: keyword.control.on1x
    - match: '\b(unsafe)(?=[ \t]*(?:\{|import[ \t]+kernel\b))|\b(loop|poll)(?=[ \t]*\{)|\b(for)(?=[ \t]*(?:\([^)]*;|{{ident}}[ \t]+in\b))'
      scope: keyword.control.on1x
    - match: '\b(match)(?=[ \t]+(?=[A-Za-z_0-9("!@-]|<-)[^#;]*?[ \t]+with\b|[ \t]*\([^#;\r\n]*?\)[ \t]*\{)|\b(with)(?=[ \t]*\{)'
      scope: keyword.control.on1x
    - match: '\b(break|continue)(?=[ \t]*(?:;|[ \t]+{{ident}}))|\b(defer|join|split|close|cancel)(?=[ \t]+(?!with\b){{ident}})'
      scope: keyword.control.on1x
    - match: '\b(taskgroup)[ \t]+(within)\b|\b(launch)[ \t]+(capture|exec)\b(?=[ \t]*[(`])'
      scope: keyword.control.on1x
    - match: '\b(taskgroup)(?=[ \t]*\{)|\b(launch)(?=[ \t]*[{`])'
      scope: keyword.control.on1x
    - match: '\b(recv)(?=[ \t]+{{ident}}[ \t]+as\b)|\b(send)(?=[ \t]+{{ident}}[ \t]*<-)|\b(closed)(?=[ \t]+{{ident}}[ \t]*=>)|\b(default)(?=[ \t]*=>)|\b(after)(?=[ \t]+[^#;]*?=>)'
      scope: keyword.control.on1x
    - match: '\b(i64|f32|f64|u8|u16|u32|u64|bool|char|string|void|json|json_view|sexpr|buffer|xfiber)\b|\b(array)(?=[ \t]*[<\[])|\b(record|sum)(?=[ \t]*[<{])|\b(slice|variant|code|ifiber|channel|sender|receiver)(?=[ \t]*<)'
      scope: support.type.on1x

  literals:
    - match: '(?<![A-Za-z0-9_])0[xX][0-9a-fA-F]+(?:u8|u16|u32|u64)?\b'
      scope: constant.numeric.integer.hexadecimal.on1x
    - match: '(?<![A-Za-z0-9_])0[oO][0-7]+(?:u8|u16|u32|u64)?\b'
      scope: constant.numeric.integer.octal.on1x
    - match: '(?<![A-Za-z0-9_])0[bB][01]+(?:u8|u16|u32|u64)?\b'
      scope: constant.numeric.integer.binary.on1x
    - match: '(?<![A-Za-z0-9_])(?:[0-9]+\.[0-9]+(?:[eE][+-]?[0-9]+)?(?:f32|f64)?|[0-9]+[eE][+-]?[0-9]+(?:f32|f64)?|[0-9]+(?:f32|f64))\b'
      scope: constant.numeric.float.on1x
    - match: '(?<![A-Za-z0-9_])[0-9]+(?:u8|u16|u32|u64)?\b'
      scope: constant.numeric.integer.decimal.on1x

  punctuation:
    - match: '\.\.\.'
      scope: keyword.operator.ellipsis.on1x
    - match: '\.\.=|\.\.'
      scope: keyword.operator.range.on1x
    - match: '>=>|<=<|=<<|(?:<<|>>)\.(?!\.)|<{2,}=?|>{2,}=?|<[!%&*+?^|~$-]+>|<\||[|~!]>'
      scope: keyword.operator.custom.on1x
    - match: '<-|->|=>|:=|==|!=|<=|>=|&&|\|\|'
      scope: keyword.operator.on1x
    - match: '[!%&*+?^|~]{2,}'
      scope: keyword.operator.custom.on1x
    - match: '[+*/%<>=!|?~&^-]'
      scope: keyword.operator.on1x
    - match: '::|[.,:;]'
      scope: punctuation.separator.on1x
    - match: '[{(\[]'
      scope: punctuation.section.group.begin.on1x
    - match: '[})\]]'
      scope: punctuation.section.group.end.on1x
