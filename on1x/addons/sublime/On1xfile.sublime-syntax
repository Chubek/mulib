%YAML 1.2
---
name: On1xfile
file_extensions: [On1xfile, On1xfile.m, On1xfile.i]
scope: source.on1xfile

contexts:
  main:
    - match: '#.*'
      scope: comment.line.number-sign.on1xfile
    - match: '"'
      scope: punctuation.definition.string.begin.on1xfile
      push:
        - meta_scope: string.quoted.double.on1xfile
        - match: '"'
          scope: punctuation.definition.string.end.on1xfile
          pop: true
        - match: '\\(?:["\\/bfnrt]|u[0-9A-Fa-f]{4})'
          scope: constant.character.escape.on1xfile
        - match: '\\(?:[^\r\n]|(?=[\r\n]|$))'
          scope: invalid.illegal.escape.on1xfile
        - match: '(?=[\r\n]|$)'
          pop: true
    - match: '^[ \t]*(on1xfile|kind|name|directory|target|dependency|profile|command|define|kernel|scrutiny|scrutiny-work|backend|optimization-profile|optimization|source|library|resource|interface)(?=[ \t\r#]|$)'
      captures:
        1: keyword.control.directive.on1xfile
    - match: '(?<![A-Za-z0-9_-])(?:executable|complex|library|local|git|git-remote|commit|branch|tag|format|plain|latex|troff|shell|off|standard|strict|c11|mir-c11|mir-vm|mir-archon|default|debug|release|on)(?![A-Za-z0-9_-])'
      scope: constant.language.on1xfile
    - match: '(?<![A-Za-z0-9_-])[0-9]+(?![A-Za-z0-9_-])'
      scope: constant.numeric.integer.decimal.on1xfile
