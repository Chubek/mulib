# JSON serialization and bounded parsing run in the genuine MuLL evaluator.
val H <- G:Native("bench-host");
val M <- G:LoadLib("math") or G:DieWith("$E?");
val T <- G:LoadLib("text") or G:DieWith("$E?");
val Hex <- "0123456789abcdef";
var Controls <- [];
var control <- 0;
while control < 32 {
  Controls <- Controls + [[H:Char(control), "\\u00" + Hex[M:Floor(control / 16)] + Hex[control % 16]]];
  control <- control + 1;
}
val Quote <- fn(s) {
  # Native standard text primitives avoid allocating one lexical frame per byte.
  var out <- T:Replace(T:Replace(s, "\\", "\\\\"), "\"", "\\\"");
  var i <- 0;
  while i < 32 {
    out <- T:Replace(out, Controls[i][0], Controls[i][1]);
    i <- i + 1;
  }
  return "\"" + out + "\"";
};
val Encode <- fn(v) {
  val t <- G:Type(v);
  if t == "nil" { return "null"; }
  if t == "bool" or t == "number" { return G:Str(v); }
  if t == "string" { return Quote(v); }
  var out <- "";
  var i <- 0;
  if t == "list" {
    while i < G:Len(v) {
      if i > 0 { out <- out + ","; }
      out <- out + Encode(v[i]);
      i <- i + 1;
    }
    return "[" + out + "]";
  }
  G:Assert(t == "record");
  val keys <- H:Keys(v);
  while i < G:Len(keys) {
    if i > 0 { out <- out + ","; }
    out <- out + Quote(keys[i]) + ":" + Encode(v[keys[i]]);
    i <- i + 1;
  }
  return "{" + out + "}";
};
val Decode <- fn(source) {
  var pos <- 0;
  val size <- G:Len(source);
  val Fail <- fn() { return G:DieWith("invalid JSON at byte " + G:Str(pos)); };
  val Peek <- fn() { if pos == size { return ""; } return source[pos]; };
  val Skip <- fn() {
    while pos < size {
      val c <- Peek();
      if c != " " and c != "\n" and c != "\r" and c != "\t" { break; }
      pos <- pos + 1;
    }
  };
  val Take <- fn(c) { if Peek() != c { Fail(); } pos <- pos + 1; };
  val Digit <- fn(c) {
    if c == "" { return -1; }
    val n <- H:Byte(c) - 48;
    if n < 0 or n > 9 { return -1; }
    return n;
  };
  val HexDigit <- fn(c) {
    var i <- 0;
    while i < 16 {
      if Hex[i] == c { return i; }
      i <- i + 1;
    }
    if c == "A" { return 10; } if c == "B" { return 11; }
    if c == "C" { return 12; } if c == "D" { return 13; }
    if c == "E" { return 14; } if c == "F" { return 15; }
    return Fail();
  };
  val String <- fn() {
    Take("\"");
    var out <- "";
    while Peek() != "\"" {
      if pos >= size { Fail(); }
      var c <- Peek();
      pos <- pos + 1;
      if c == "\\" {
        c <- Peek(); pos <- pos + 1;
        if c == "n" { c <- "\n"; }
        else if c == "r" { c <- "\r"; }
        else if c == "t" { c <- "\t"; }
        else if c == "b" { c <- H:Char(8); }
        else if c == "f" { c <- H:Char(12); }
        else if c == "u" {
          var code <- 0;
          var j <- 0;
          while j < 4 {
            code <- code * 16 + HexDigit(Peek());
            pos <- pos + 1; j <- j + 1;
          }
          # Reports emit only byte-control unicode escapes; reject other forms.
          if code > 127 { return G:DieWith("JSON unicode escape outside report ASCII profile"); }
          c <- H:Char(code);
        }
        else if c != "\"" and c != "\\" and c != "/" { Fail(); }
      } else if H:Byte(c) < 32 { Fail(); }
      out <- out + c;
    }
    Take("\"");
    return out;
  };
  val Number <- fn() {
    var sign <- 1;
    if Peek() == "-" { sign <- -1; pos <- pos + 1; }
    if Digit(Peek()) < 0 { Fail(); }
    var n <- Digit(Peek());
    pos <- pos + 1;
    if n != 0 {
      while Digit(Peek()) >= 0 { n <- n * 10 + Digit(Peek()); pos <- pos + 1; }
    }
    if Peek() == "." {
      pos <- pos + 1;
      if Digit(Peek()) < 0 { Fail(); }
      var factor <- 0.1;
      while Digit(Peek()) >= 0 {
        n <- n + Digit(Peek()) * factor; factor <- factor / 10; pos <- pos + 1;
      }
    }
    if Peek() == "e" or Peek() == "E" {
      pos <- pos + 1;
      var es <- 1;
      if Peek() == "-" { es <- -1; pos <- pos + 1; }
      else if Peek() == "+" { pos <- pos + 1; }
      if Digit(Peek()) < 0 { Fail(); }
      var exponent <- 0;
      while Digit(Peek()) >= 0 {
        exponent <- exponent * 10 + Digit(Peek()); pos <- pos + 1;
        if exponent > 308 { Fail(); }
      }
      n <- n * M:Pow(10, es * exponent);
    }
    return sign * n;
  };
  val Value <- fn(depth) {
    if depth > 48 { return G:DieWith("JSON nesting budget"); }
    Skip();
    val c <- Peek();
    if c == "\"" { return String(); }
    if c == "[" or c == "{" {
      val record <- c == "{";
      var end <- "]";
      if record { end <- "}"; }
      pos <- pos + 1; Skip();
      var xs <- [];
      if Peek() != end {
        while true {
          if record {
            val key <- String(); Skip(); Take(":");
            xs <- xs + [[key, Value(depth + 1)]];
          } else { xs <- xs + [Value(depth + 1)]; }
          Skip();
          if Peek() == end { break; }
          Take(","); Skip();
        }
      }
      Take(end);
      if record { return H:Record(xs); }
      return xs;
    }
    if c == "t" { Take("t"); Take("r"); Take("u"); Take("e"); return true; }
    if c == "f" { Take("f"); Take("a"); Take("l"); Take("s"); Take("e"); return false; }
    if c == "n" { Take("n"); Take("u"); Take("l"); Take("l"); return nil; }
    return Number();
  };
  val result <- Value(0);
  Skip();
  if pos != size { Fail(); }
  return result;
};
return {Encode: Encode, Decode: Decode};
