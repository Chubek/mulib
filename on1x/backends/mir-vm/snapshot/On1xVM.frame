#include "On1xVM.h"

int On1xVM_call(On1xVM_vm *vm, On1xVM_cell target) {
  On1xVM_activation *frame;
  if(!vm || vm->vw_error) return vm ? vm->vw_error : -1;
  if((uintmax_t)target>=vm->vw_code_size) { On1xVM_vw_fail(vm,-4); return -4; }
  if(vm->vw_frame_count>=sizeof(vm->vw_frames)/sizeof(vm->vw_frames[0])) { On1xVM_vw_fail(vm,-3); return -3; }
  frame=&vm->vw_frames[vm->vw_frame_count++]; memset(frame,0,sizeof(*frame));
  frame->return_address=vm->vw_pc; frame->stack_base=vm->vw_sp; vm->vw_pc=(size_t)target; return 0;
}
int On1xVM_ret(On1xVM_vm *vm) {
  if(!vm || vm->vw_error) return vm ? vm->vw_error : -1;
  if(!vm->vw_frame_count) { On1xVM_vw_fail(vm,-2); return -2; }
  vm->vw_pc=vm->vw_frames[--vm->vw_frame_count].return_address; return 0;
}
