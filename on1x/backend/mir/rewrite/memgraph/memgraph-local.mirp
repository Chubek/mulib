mir-bank 1 memgraph-local;

# Each proof captures a verified SSA value for the same local frame slot.
# A store and a retained load establish different facts. Neither proof
# reads across blocks nor uses a stale fact after another same-slot store.
pattern forward_word_store backend "mir-c11" target "x86_64-unknown-linux-gnu" mode safe match "load"() replace $stored requires local-store-word;
pattern reuse_word_load backend "mir-c11" target "x86_64-unknown-linux-gnu" mode safe match "load"() replace $loaded requires local-load-word;

# Forward or reuse the value itself, including signed zero and NaN bits.
pattern forward_f32_store backend "mir-c11" target "x86_64-unknown-linux-gnu" mode safe match "load"() replace $stored requires local-store-f32;
pattern reuse_f32_load backend "mir-c11" target "x86_64-unknown-linux-gnu" mode safe match "load"() replace $loaded requires local-load-f32;
pattern forward_f64_store backend "mir-c11" target "x86_64-unknown-linux-gnu" mode safe match "load"() replace $stored requires local-store-f64;
pattern reuse_f64_load backend "mir-c11" target "x86_64-unknown-linux-gnu" mode safe match "load"() replace $loaded requires local-load-f64;

# Tuple substitutions preserve the complete immutable SSA tuple, but require
# both a speculative directive and the host's permission.
pattern forward_tuple_store backend "mir-c11" target "x86_64-unknown-linux-gnu" mode speculative match "load"() replace $stored requires local-store-tuple;
pattern reuse_tuple_load backend "mir-c11" target "x86_64-unknown-linux-gnu" mode speculative match "load"() replace $loaded requires local-load-tuple;

# The replacement names the value already in the slot. The store itself has
# no result, so the specializer only reconnects the effect chain.
pattern discard_redundant_store backend "mir-c11" target "x86_64-unknown-linux-gnu" mode speculative match "store"($value) replace $value requires redundant-store;
