mir-bank 1 boolean-comparisons;

# Eq/Ne also accept i64. Check that the literal is Bool before aliasing.
pattern eq_true backend * target * mode safe match "eq"($x, 1) replace $x requires bool-operands;
pattern true_eq backend * target * mode safe match "eq"(1, $x) replace $x requires bool-operands;
pattern ne_false backend * target * mode safe match "ne"($x, 0) replace $x requires bool-operands;
pattern false_ne backend * target * mode safe match "ne"(0, $x) replace $x requires bool-operands;
