{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://on1x.dev/sdk/frontend/ppx-readmission-v1.schema.json",
  "title": "On1x SDK PPX candidate readmission envelope v1",
  "description": "The payload is canonical on1x.sexpr-ast/v1 and is validated by grammar/PPX.schema.json before reconstruction. Readmission produces a candidate, never semantic-equivalence evidence.",
  "type": "object",
  "required": ["schema", "version", "base_ast_revision", "source_revisions", "wire"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "on1x.sexpr-ast/v1"},
    "version": {"const": 1},
    "base_ast_revision": {"type": "integer", "minimum": 1},
    "source_revisions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "required": ["source_id", "revision"],
        "additionalProperties": false,
        "properties": {
          "source_id": {"type": "integer", "minimum": 1},
          "revision": {"type": "integer", "minimum": 1}
        }
      }
    },
    "wire": {
      "type": "string",
      "maxLength": 4194304,
      "description": "One canonical S-expression root; maximum 262144 nodes and 256 levels."
    }
  }
}
