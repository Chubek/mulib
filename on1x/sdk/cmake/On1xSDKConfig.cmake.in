@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/On1xSDKTargets.cmake")

set(On1xSDK_VERSION "@ON1X_SDK_PACKAGE_VERSION@")
set(On1xSDK_ABI_VERSION 2)
set(On1xSDK_ABI_V1_COMPATIBLE TRUE)
set(On1xSDK_PROJECT_ABI_VERSION 2)
set_and_check(On1xSDK_TOOL
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/on1x-sdk")
set_and_check(On1xSDK_PYTHON_BINDING_DIR
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/on1x-sdk/python")
set_and_check(On1xSDK_CAPABILITY_MATRIX
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/on1x-sdk/CAPABILITY_MATRIX.json")
set_and_check(On1xSDK_IMPLEMENTATION_INVENTORY
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/on1x-sdk/IMPLEMENTATION_INVENTORY.json")

check_required_components(On1xSDK)
